	public void ApplyTangentMode(DemoTangentMode mode)
	{
		DemoKeyframe selected = Selected;
		if (selected != null)
		{
			selected.TangentMode = mode;
			selected.TangentsSet = false;
			selected.InWeight = 1f / 3f;
			selected.OutWeight = 1f / 3f;
			((VisualElement)this).MarkDirtyRepaint();
			this.KeysChanged?.Invoke();
		}
