using System;
using System.Collections.Generic;
using Rust.UI.Toolkit;
using Rust.UI.Toolkit.DemoControls;
using UnityEngine.UIElements;

public class DemoPropertyBinding
{
	private readonly RustSlider _slider;

	private readonly RustSwitch _toggle;

	private readonly RustDropdown _dropdown;

	private readonly List<string> _choices;

	public float Value
	{
		get
		{
			if (_slider != null)
			{
				return _slider.value;
			}
			if (_toggle != null)
			{
				if (!_toggle.value)
				{
					return 0f;
				}
				return 1f;
			}
			RustDropdown dropdown = _dropdown;
			return ((float?)((dropdown != null) ? new int?(dropdown.value) : ((int?)null))) ?? 0f;
		}
	}

	private DemoPropertyBinding(RustSlider slider, RustSwitch toggle, RustDropdown dropdown)
	{
		_slider = slider;
		_toggle = toggle;
		_dropdown = dropdown;
		_choices = ((dropdown != null) ? dropdown.Choices : null);
	}

	public static DemoPropertyBinding For(VisualElement control)
	{
		RustSlider val = (RustSlider)(object)((control is RustSlider) ? control : null);
		if (val == null)
		{
			RustSwitch val2 = (RustSwitch)(object)((control is RustSwitch) ? control : null);
			if (val2 == null)
			{
				RustDropdown val3 = (RustDropdown)(object)((control is RustDropdown) ? control : null);
				if (val3 != null)
				{
					return new DemoPropertyBinding(null, null, val3);
				}
				return null;
			}
			return new DemoPropertyBinding(null, val2, null);
		}
		return new DemoPropertyBinding(val, null, null);
	}

	public void SetSilent(float value)
	{
		RustSlider slider = _slider;
		if (slider != null)
		{
			slider.SetValueWithoutNotify(value);
		}
		RustSwitch toggle = _toggle;
		if (toggle != null)
		{
			toggle.SetValueWithoutNotify(value > 0.5f);
		}
		RustDropdown dropdown = _dropdown;
		if (dropdown != null)
		{
			dropdown.SetValueWithoutNotify((int)Math.Round(value));
		}
	}

	public void OnUserChanged(Action callback)
	{
		RustSlider slider = _slider;
		if (slider != null)
		{
			INotifyValueChangedExtensions.RegisterValueChangedCallback<float>((INotifyValueChanged<float>)(object)slider, (EventCallback<ChangeEvent<float>>)delegate
			{
				callback();
			});
		}
		RustSwitch toggle = _toggle;
		if (toggle != null)
		{
			INotifyValueChangedExtensions.RegisterValueChangedCallback<bool>((INotifyValueChanged<bool>)(object)toggle, (EventCallback<ChangeEvent<bool>>)delegate
			{
				callback();
			});
		}
		RustDropdown dropdown = _dropdown;
		if (dropdown != null)
		{
			INotifyValueChangedExtensions.RegisterValueChangedCallback<int>((INotifyValueChanged<int>)(object)dropdown, (EventCallback<ChangeEvent<int>>)delegate
			{
				callback();
			});
		}
	}

	public string Format(float value)
	{
		if (_slider != null)
		{
			if (!_slider.Integer)
			{
				return value.ToString(_slider.Format);
			}
			return ((int)value).ToString();
		}
		if (_toggle != null)
		{
			if (!(value > 0.5f))
			{
				return DemoControlsPhrases.StateOff.translated;
			}
			return DemoControlsPhrases.StateOn.translated;
		}
		if (_choices != null && _choices.Count > 0)
		{
			int index = Math.Clamp((int)Math.Round(value), 0, _choices.Count - 1);
			return RustUI.Upper(_choices[index]);
		}
		return value.ToString("0.##");
	}
}


