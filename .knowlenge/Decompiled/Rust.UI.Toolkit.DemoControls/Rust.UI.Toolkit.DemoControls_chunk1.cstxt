			((VisualElement)val).Add((VisualElement)(object)val3);
		}
		return (VisualElement)(object)val;
	}

	public void SetExportStatus(in DemoExportStatus status)
	{
		_exportTab?.SetStatus(in status);
	}

	public void RefreshValues()
	{
		if (_propertyHost == null || !RustUI.IsVisible((VisualElement)(object)this))
		{
			return;
		}
		foreach (PropertyEntry entry in _entries)
		{
			if (entry.Binding != null && _propertyHost.TryGetPropertyValue(entry.Property.Id, out var value) && Mathf.Abs(entry.Binding.Value - value) > 0.0001f)
			{
				entry.Binding.SetSilent(value);
			}
		}
	}

	public void FocusProperty(string propertyId)
	{
		PropertyEntry entry = _entries.Find((PropertyEntry e) => e.Property.Id == propertyId);
		if (entry != null)
		{
			_tabBar.SelectedIndex = entry.TabIndex;
			ShowPage(entry.TabIndex);
			((VisualElement)this).schedule.Execute((Action)delegate
			{
				entry.Page.ScrollTo(entry.Row);
				Flash(entry.Row);
			}).StartingIn(50L);
		}
	}

	private static void Flash(VisualElement row)
	{
		row.AddToClassList("demo-prop-flash");
		row.schedule.Execute((Action)delegate
		{
			row.RemoveFromClassList("demo-prop-flash");
		}).StartingIn(380L);
	}

	private void ShowPage(int index)
	{
		for (int i = 0; i < _pages.Count; i++)
		{
			RustUI.SetVisible(_pages[i], i == index);
		}
	}

	private void ToggleKey(DemoProperty property, DemoPropertyBinding binding)
	{
		//IL_0061: Unknown result type (might be due to invalid IL or missing references)
		DemoTrack track = _store.GetTrack(property.Id);
		float value = binding?.Value ?? 0f;
		_propertyHost?.SetPropertyValue(property.Id, value);
		if (track == null)
		{
			_store.BeginGesture();
			track = _store.AddTrack(property.Id, property.Name.translated, property.Icon, (binding != null) ? new Func<float, string>(binding.Format) : null);
			_store.AddKeyframe(track, _playback.Time, value);
			_store.EndGesture();
		}
		else
		{
			_store.ToggleKeyframe(track, _playback.Time, _playback.TickDuration * 0.5f, value);
		}
	}

	private void OnValueChanged(DemoProperty property, DemoPropertyBinding binding)
	{
		_propertyHost?.SetPropertyValue(property.Id, binding.Value);
		DemoTrack track = _store.GetTrack(property.Id);
		if (track != null)
		{
			_store.SetOrAddKeyframe(track, _playback.Time, binding.Value, _playback.TickDuration * 0.5f);
		}
	}

	private void RefreshKeyButtons()
	{
		foreach (PropertyEntry entry in _entries)
		{
			if (entry.Button != null)
			{
				DemoTrack track = _store.GetTrack(entry.Property.Id);
				bool flag = track?.FindAt(_playback.Time, _playback.TickDuration * 0.5f) != null;
				((VisualElement)entry.Button).EnableInClassList("is-tracked", track != null);
				((VisualElement)entry.Button).EnableInClassList("is-keyed", flag);
				entry.Button.Icon = (Icons)(flag ? 61977 : 62194);
				RustTooltip.WithTooltip<RustButton>(entry.Button, flag ? DemoControlsPhrases.TipRemoveKeyframe : DemoControlsPhrases.TipAddKeyframe);
				if (track != null && track.Keyframes.Count > 0)
				{
					entry.Binding?.SetSilent(track.Evaluate(_playback.Time));
				}
			}
		}
	}
}


using System;
using UnityEngine;

public class DemoPlayback
{
	private float _time;

	private bool _playing;

	private float _speed = 1f;

	public string DemoName { get; set; } = "demo";

	public float Length { get; }

	public int TickRate { get; }

	public bool Loop { get; set; }

	public float TickDuration => 1f / (float)TickRate;

	public int CurrentTick => Mathf.RoundToInt(_time * (float)TickRate);

	public int TotalTicks => Mathf.RoundToInt(Length * (float)TickRate);

	public float Time
	{
		get
		{
			return _time;
		}
		set
		{
			value = Mathf.Clamp(value, 0f, Length);
			if (!Mathf.Approximately(_time, value))
			{
				_time = value;
				this.TimeChanged?.Invoke();
			}
		}
	}

	public bool Playing
	{
		get
		{
			return _playing;
		}
		set
		{
			if (_playing != value)
			{
				_playing = value;
				this.PlayingChanged?.Invoke();
			}
		}
	}

	public float Speed
	{
		get
		{
			return _speed;
		}
		set
		{
			value = Mathf.Clamp(value, 0.05f, 16f);
			if (!Mathf.Approximately(_speed, value))
			{
				_speed = value;
				this.SpeedChanged?.Invoke();
			}
		}
	}

	public event Action TimeChanged;

	public event Action PlayingChanged;

	public event Action SpeedChanged;

	public DemoPlayback(float length, int tickRate = 30)
	{
		Length = Mathf.Max(1f, length);
		TickRate = Mathf.Max(1, tickRate);
	}

	public void TogglePlay()
	{
		if (!_playing && Time >= Length)
		{
			Time = 0f;
		}
		Playing = !_playing;
	}

	public void StepTicks(int ticks)
	{
		Playing = false;
		Time = (float)(CurrentTick + ticks) * TickDuration;
	}

	public void Jump(float seconds)
	{
		Time += seconds;
	}

	public float Snap(float time)
	{
		return Mathf.Clamp(Mathf.Round(time * (float)TickRate) * TickDuration, 0f, Length);
	}

	public void Update(float deltaTime)
	{
		if (!_playing)
		{
			return;
		}
		float num = _time + deltaTime * _speed;
		if (num >= Length)
		{
			if (Loop)
			{
				Time = num - Length;
				return;
			}
			Time = Length;
			Playing = false;
		}
		else
		{
			Time = num;
		}
	}

	public static string Format(float seconds)
	{
		int num = (int)(seconds / 60f);
		return $"{num:00}:{seconds - (float)num * 60f:00.0}";
	}
}


