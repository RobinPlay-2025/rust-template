	private void RebuildGuide(DemoCameraMode mode)
	{
		_guideMode = mode;
		((TextElement)_guideTitle).text = RustUI.Upper(mode.DisplayName());
		((TextElement)_guideDesc).text = GuideDescription(mode).translated;
		_guideRows.Clear();
		AddGuideRow(_guideRows, "Alt", DemoControlsPhrases.GuideToggleCursor);
		switch (mode)
		{
		case DemoCameraMode.FirstPerson:
		case DemoCameraMode.ThirdPerson:
			AddGuideRow(_guideRows, "Space", DemoControlsPhrases.GuidePlayPause);
			AddGuideRow(_guideRows, "← / →", DemoControlsPhrases.GuideJump);
			AddGuideRow(_guideRows, ", / .", DemoControlsPhrases.GuideStep);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.FreeCamera:
			AddGuideRow(_guideRows, "K", DemoControlsPhrases.GuideKeyframeTimeline);
			AddGuideRow(_guideRows, "O", DemoControlsPhrases.GuideOptionsPanel);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.DollyEditor:
			AddGuideRow(_guideRows, "J", DemoControlsPhrases.GuideAddDollyKey);
			AddGuideRow(_guideRows, "RMB", DemoControlsPhrases.GuideDollyPick);
			AddGuideRow(_guideRows, "Del", DemoControlsPhrases.GuideDeleteKeyframe);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
