public enum DemoCameraMode
{
	FirstPerson,
	ThirdPerson,
	FreeCamera,
	DollyEditor,
	DollyView,
	ShotDirector,
	Sandbox
}


public enum DemoRecordStage
{
	None,
	Countdown,
	LeadIn
}


using Rust.UI.Toolkit.DemoControls;

public struct DollyInfo
{
	public DemoCameraMode Mode;

	public int CameraCount;

	public int FocalCount;

	public int RollCount;

	public float FieldOfView;

	public float FocalLength;

	public float Roll;

	public int MinForSpline;

	public bool NeedsMoreForSpline;

	public bool Recording;

	public DemoRecordStage RecordStage;

	public int RecordCountdown;
}


using Rust.UI.Toolkit.DemoControls;

public static class DemoCameraModeExtensions
{
	public static readonly Phrase[] DisplayNames = (Phrase[])(object)new Phrase[7]
	{
		DemoControlsPhrases.ModeFirstPerson,
		DemoControlsPhrases.ModeThirdPerson,
		DemoControlsPhrases.ModeFreeCamera,
		DemoControlsPhrases.ModeDollyEditor,
		DemoControlsPhrases.ModeDollyView,
		DemoControlsPhrases.ModeShotDirector,
		DemoControlsPhrases.ModeSandbox
	};

	public static string DisplayName(this DemoCameraMode mode)
	{
		int num = (int)mode;
		if (num < 0 || num >= DisplayNames.Length)
		{
			return mode.ToString();
		}
		return DisplayNames[num].translated;
	}
}


using Rust.UI.Toolkit;
using Rust.UI.Toolkit.DemoControls;
using UnityEngine;
using UnityEngine.UIElements;

[AddComponentMenu("Rust/UI Toolkit/Demo Controls Example")]
public class DemoControlsExample : MonoBehaviour
{
	[SerializeField]
	private string demoName = "my demo";

	[SerializeField]
	private float demoLength = 120f;

	[SerializeField]
	private int tickRate = 30;

	private UIDocument _document;

	private DemoControlsUI _ui;

	private void OnEnable()
	{
		_document = ((Component)this).GetComponent<UIDocument>();
		if ((Object)(object)_document == (Object)null)
		{
			_document = RustUIHost.CreateDocument(((Component)this).gameObject, 0f);
		}
		else
		{
			RustUI.Attach<VisualElement>(_document.rootVisualElement);
		}
		VisualElement rootVisualElement = _document.rootVisualElement;
		rootVisualElement.Clear();
		rootVisualElement.pickingMode = (PickingMode)1;
		_ui = new DemoControlsUI(demoName, demoLength, tickRate);
		rootVisualElement.Add((VisualElement)(object)_ui);
	}

	private void Update()
	{
		_ui?.Tick(Time.deltaTime);
	}

	private void OnDisable()
	{
		if ((Object)(object)_document != (Object)null && _document.rootVisualElement != null)
		{
			_document.rootVisualElement.Clear();
		}
		_ui = null;
	}
}


