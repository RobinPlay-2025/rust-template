	public void SetStatus(in DemoExportStatus status)
	{
		_exporting = status.Active;
		_statusMessage = status.Message;
		_progress.Value = status.Progress;
		RefreshControls();
	}

	private void OnRunClicked()
	{
		if (_host != null)
		{
			if (_exporting)
			{
				_host.CancelExport();
			}
			else if (_range.HasRange)
			{
				(string, int, int) tuple = Resolutions[_resolution.value];
				(string, int) tuple2 = FrameRates[_frameRate.value];
				_host.StartExport(new DemoExportSettings
				{
					StartTime = _range.Start,
					EndTime = _range.End,
					Width = tuple.Item2,
					Height = tuple.Item3,
					Fps = tuple2.Item2,
					Format = (DemoExportFormat)_format.value,
					Quality = _quality.value
				});
			}
		}
	}

	private void RefreshRange()
	{
		if (_range.HasRange)
		{
			int item = FrameRates[_frameRate.value].Fps;
			int num = (int)Math.Round(_range.Duration * (float)item);
			((TextElement)_startValue).text = DemoPlayback.Format(_range.Start);
			((TextElement)_endValue).text = DemoPlayback.Format(_range.End);
			((TextElement)_durationValue).text = DemoPlayback.Format(_range.Duration);
			((TextElement)_framesValue).text = num.ToString();
		}
		else
		{
			((TextElement)_startValue).text = "—";
			((TextElement)_endValue).text = "—";
			((TextElement)_durationValue).text = "—";
			((TextElement)_framesValue).text = "—";
		}
		RefreshControls();
	}

	private void RefreshControls()
	{
		bool hasRange = _range.HasRange;
		((VisualElement)_run).SetEnabled(_exporting || hasRange);
		if (_exporting)
		{
			_run.SetText(DemoControlsPhrases.CommonCancel);
			_run.ButtonStyle = (RustButtonStyle)2;
			RustUI.SetVisible((VisualElement)(object)_progress, true);
			((TextElement)_status).text = _statusMessage ?? string.Empty;
		}
		else
		{
			_run.SetText(DemoControlsPhrases.ExportRun);
			_run.ButtonStyle = (RustButtonStyle)(hasRange ? 1 : 0);
