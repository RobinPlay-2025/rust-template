using System;
using Rust.UI.Toolkit;
using Rust.UI.Toolkit.DemoControls;
using UnityEngine;
using UnityEngine.UIElements;

public class DemoControlsUI : VisualElement
{
	public const float MaxTimelineHeight = 420f;

	private readonly VisualElement _dock;

	private readonly VisualElement _handle;

	private readonly DemoTransportBar _transport;

	private readonly DemoTimelineView _timeline;

	private readonly VisualElement _keyGuide;

	private readonly RustButton _guideHelp;

	private readonly DemoDollyInfoPanel _dollyInfo;

	private readonly VisualElement _recordIndicator;

	private Label _recordLabel;

	private readonly IDemoPropertyHost _propertyHost;

	private readonly IDemoExportHost _exportHost;

	private readonly IDemoSceneHost _sceneHost;

	private DemoOptionsPanel _options;

	private DemoSandboxPanel _sandbox;

	private Label _guideTitle;

	private Label _guideDesc;

	private VisualElement _guideRows;

	private VisualElement _cursorToast;

	private VisualElement _placeToast;

	private IVisualElementScheduledItem _cursorToastHide;

	private VisualElement _hotkeyRoot;

	private StyleSheet _sheet;

	private float _timelineHeight = 200f;

	private bool _timelineOpen;

	private bool _hidden;

	private bool _chromeVisible = true;

	private bool _interactive = true;

	private bool _guideCollapsed;

	private bool _cursorToastShown;

	private bool _placeToastShown;

	private bool _dollyShown;

	private bool _recordShown;

	private bool _sandboxShown;

	private DemoCameraMode _guideMode;

	private bool _restoreOptions;

	private bool _restoreOptionsOnChrome;

	private bool _restoreTimeline;

	private bool _restoreSandbox;

	private bool _restoreSandboxOnChrome;

	private float _dragStartHeight;

	private float _dragStartY;

	public DemoPlayback Playback { get; }

	public DemoKeyframeStore Keyframes { get; }

	public DemoExportRange ExportRange { get; }

	public DemoTimelineView Timeline => _timeline;

	public event Action<int> CameraModeChanged;

	public event Action<string, Vector2> OnGroupMenuRequested;

	public event Action<DemoTrack, DemoClip, Vector2> OnClipMenuRequested;

	public DemoControlsUI(string demoName = "my demo", float demoLength = 120f, int tickRate = 30, IDemoPropertyHost propertyHost = null, IDemoExportHost exportHost = null, IDemoSceneHost sceneHost = null)
	{
		//IL_008c: Unknown result type (might be due to invalid IL or missing references)
		//IL_0096: Expected O, but got Unknown
		//IL_00b7: Unknown result type (might be due to invalid IL or missing references)
		//IL_00c1: Expected O, but got Unknown
		//IL_00d1: Unknown result type (might be due to invalid IL or missing references)
		//IL_00d7: Expected O, but got Unknown
		//IL_0260: Unknown result type (might be due to invalid IL or missing references)
		//IL_026f: Expected O, but got Unknown
		_propertyHost = propertyHost;
		_exportHost = exportHost;
		_sceneHost = sceneHost;
		((VisualElement)this).AddToClassList("demo-root");
		((VisualElement)this).pickingMode = (PickingMode)1;
		((Focusable)this).focusable = true;
		_sheet = Resources.Load<StyleSheet>("RustUIDemo/DemoControls");
		Playback = new DemoPlayback(demoLength, tickRate)
		{
			DemoName = demoName
		};
		Keyframes = new DemoKeyframeStore();
		ExportRange = new DemoExportRange(demoLength);
		_dock = new VisualElement();
		_dock.AddToClassList("demo-dock");
		_dock.AddToClassList("demo-mutable");
		_handle = new VisualElement();
		_handle.AddToClassList("demo-dock__handle");
		VisualElement val = new VisualElement();
		val.AddToClassList("demo-dock__handle-grip");
		val.pickingMode = (PickingMode)1;
		_handle.Add(val);
		((CallbackEventHandler)_handle).RegisterCallback<PointerDownEvent>((EventCallback<PointerDownEvent>)OnHandleDown, (TrickleDown)0);
		((CallbackEventHandler)_handle).RegisterCallback<PointerMoveEvent>((EventCallback<PointerMoveEvent>)OnHandleMove, (TrickleDown)0);
		((CallbackEventHandler)_handle).RegisterCallback<PointerUpEvent>((EventCallback<PointerUpEvent>)OnHandleUp, (TrickleDown)0);
		_dock.Add(_handle);
		_transport = new DemoTransportBar(Playback);
		_transport.OnOptionsClicked += ToggleOptions;
		_transport.OnKeyframesClicked += delegate
		{
			SetTimelineOpen(!_timelineOpen);
		};
