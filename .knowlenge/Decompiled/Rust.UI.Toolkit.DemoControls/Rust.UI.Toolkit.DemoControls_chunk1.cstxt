	public void Frame()
	{
		if (_keys.Count == 0)
		{
			_timeMin = 0f;
			_timeMax = 1f;
			_valueMin = 0f;
			_valueMax = 1f;
			_fitTimeSpan = 1f;
			this.ViewChanged?.Invoke();
			((VisualElement)this).MarkDirtyRepaint();
			return;
		}
		float time = _keys[0].Time;
		float time2 = _keys[_keys.Count - 1].Time;
		float num = float.MaxValue;
		float num2 = float.MinValue;
		for (int i = 0; i < _keys.Count; i++)
		{
			num = Mathf.Min(num, ValueOf(i));
			num2 = Mathf.Max(num2, ValueOf(i));
		}
		float num3 = Mathf.Max(0.05f, time2 - time);
		float num4 = Mathf.Max(0.0005f, num2 - num);
		_timeMin = time - num3 * 0.05f;
		_timeMax = time2 + num3 * 0.05f;
		_valueMin = num - num4 * 0.11f;
		_valueMax = num2 + num4 * 0.11f;
		_fitTimeSpan = _timeMax - _timeMin;
		this.ViewChanged?.Invoke();
		((VisualElement)this).MarkDirtyRepaint();
	}

	public void FrameRange(float timeLow, float timeHigh)
	{
		if (_keys.Count == 0 || timeHigh - timeLow < 0.05f)
		{
			Frame();
			return;
		}
		float num = float.MaxValue;
		float num2 = float.MinValue;
		int num3 = 0;
		for (int i = 0; i < _keys.Count; i++)
		{
			if (!(_keys[i].Time < timeLow) && !(_keys[i].Time > timeHigh))
			{
				num = Mathf.Min(num, ValueOf(i));
				num2 = Mathf.Max(num2, ValueOf(i));
				num3++;
			}
		}
		if (num3 == 0)
		{
			Frame();
			return;
		}
		float num4 = timeHigh - timeLow;
		float num5 = Mathf.Max(0.0005f, num2 - num);
		_timeMin = timeLow - num4 * 0.05f;
		_timeMax = timeHigh + num4 * 0.05f;
		_valueMin = num - num5 * 0.11f;
		_valueMax = num2 + num5 * 0.11f;
		_fitTimeSpan = _timeMax - _timeMin;
		this.ViewChanged?.Invoke();
		((VisualElement)this).MarkDirtyRepaint();
	}

	public void SetWindow(float timeMin, float timeMax, float valueMin, float valueMax)
