using System.Collections.Generic;
using Rust.UI.Toolkit.DemoControls;
using UnityEngine;

public static class DemoCurveMath
{
	public const float DefaultWeight = 1f / 3f;

	public const float MinWeight = 0.02f;

	public const float MaxWeight = 1f;

	private const int SolveIterations = 24;

	public static float CubicBezier(float p0, float p1, float p2, float p3, float u)
	{
		float num = 1f - u;
		return num * num * num * p0 + 3f * num * num * u * p1 + 3f * num * u * u * p2 + u * u * u * p3;
	}

	public static void ResolveWeights(DemoKeyframe from, DemoKeyframe to, out float outWeight, out float inWeight)
	{
		outWeight = Mathf.Clamp((from.OutWeight <= 0f) ? (1f / 3f) : from.OutWeight, 0.02f, 1f);
		inWeight = Mathf.Clamp((to.InWeight <= 0f) ? (1f / 3f) : to.InWeight, 0.02f, 1f);
		float num = outWeight + inWeight;
		if (!(num <= 1f))
		{
			float num2 = 1f / num;
			outWeight *= num2;
			inWeight *= num2;
		}
	}

	public static bool IsUnweighted(float outWeight, float inWeight)
	{
		if (Mathf.Abs(outWeight - 1f / 3f) < 0.0005f)
		{
			return Mathf.Abs(inWeight - 1f / 3f) < 0.0005f;
		}
		return false;
	}

	public static float SolveParameter(float x0, float x1, float x2, float x3, float x)
	{
		float num = 0f;
		float num2 = 1f;
		for (int i = 0; i < 24; i++)
		{
			float num3 = (num + num2) * 0.5f;
			if (CubicBezier(x0, x1, x2, x3, num3) < x)
			{
				num = num3;
			}
			else
			{
				num2 = num3;
			}
		}
		return (num + num2) * 0.5f;
	}

	public static float EvaluateSegment(float fromTime, float fromValue, float toTime, float toValue, float outTangent, float inTangent, float outWeight, float inWeight, float time)
	{
		float num = toTime - fromTime;
		if (num <= 0.0001f)
		{
			return toValue;
		}
		if (IsUnweighted(outWeight, inWeight))
		{
			return Hermite(fromValue, toValue, num, outTangent, inTangent, (time - fromTime) / num);
		}
		float x = fromTime + outWeight * num;
		float x2 = toTime - inWeight * num;
		float p = fromValue + outTangent * outWeight * num;
		float p2 = toValue - inTangent * inWeight * num;
		float u = SolveParameter(fromTime, x, x2, toTime, time);
		return CubicBezier(fromValue, p, p2, toValue, u);
	}

	public static bool AnyTangentsSet(List<DemoKeyframe> keys)
	{
		for (int i = 0; i < keys.Count; i++)
		{
			if (keys[i].TangentsSet || keys[i].TangentMode != 0 || !IsUnweighted(keys[i].OutWeight, keys[i].InWeight))
			{
				return true;
			}
		}
		return false;
	}

	public static float Slope(DemoKeyframe from, DemoKeyframe to)
	{
		float num = to.Time - from.Time;
		if (!(num <= 0.0001f))
		{
			return (to.Value - from.Value) / num;
		}
		return 0f;
	}

	public static void ResolveTangents(List<DemoKeyframe> keys, int index, out float inTangent, out float outTangent)
	{
		DemoKeyframe demoKeyframe = keys[index];
		if (demoKeyframe.TangentsSet && demoKeyframe.TangentMode != DemoTangentMode.Stepped)
		{
			inTangent = demoKeyframe.InTangent;
			outTangent = demoKeyframe.OutTangent;
			return;
		}
		bool flag = index > 0;
