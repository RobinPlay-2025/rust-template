		ResolveWeights(demoKeyframe2, demoKeyframe3, out var outWeight, out var inWeight);
		return EvaluateSegment(demoKeyframe2.Time, demoKeyframe2.Value, demoKeyframe3.Time, demoKeyframe3.Value, outTangent, inTangent2, outWeight, inWeight, time);
	}

	public static float RemapTime(List<DemoKeyframe> keys, float time)
	{
		if (!TryFindSegment(keys, time, out var index))
		{
			return time;
		}
		DemoKeyframe demoKeyframe = keys[index];
		DemoKeyframe demoKeyframe2 = keys[index + 1];
		if (!demoKeyframe.TangentsSet && !demoKeyframe2.TangentsSet && demoKeyframe.TangentMode == DemoTangentMode.Smooth && demoKeyframe2.TangentMode == DemoTangentMode.Smooth)
		{
			return time;
		}
		float num = demoKeyframe2.Time - demoKeyframe.Time;
		if (num <= 0.0001f)
		{
			return time;
		}
		if (demoKeyframe.TangentMode == DemoTangentMode.Stepped)
		{
			return demoKeyframe.Time;
