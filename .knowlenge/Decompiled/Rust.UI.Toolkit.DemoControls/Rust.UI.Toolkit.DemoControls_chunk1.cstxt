	public void DeleteSelected()
	{
		if (_selection.Count != 0 || _clipSelection.Count != 0)
		{
			_suppressRebuild = true;
			(DemoTrack, DemoKeyframe)[] array = _selection.ToArray();
			for (int i = 0; i < array.Length; i++)
			{
				var (track, keyframe) = array[i];
				_store.RemoveKeyframe(track, keyframe);
			}
			(DemoTrack, DemoClip)[] array2 = _clipSelection.ToArray();
			for (int i = 0; i < array2.Length; i++)
			{
				var (track2, clip) = array2[i];
				_store.RemoveClip(track2, clip);
			}
			_suppressRebuild = false;
			ClearSelection();
			Rebuild();
		}
	}

	public void CopySelected()
	{
		float num = float.MaxValue;
		foreach (var (track, demoKeyframe) in _selection)
		{
			if (CanClipboard(track))
			{
				num = Mathf.Min(num, demoKeyframe.Time);
			}
		}
		if (num == float.MaxValue)
		{
			return;
		}
		Clipboard.Clear();
		foreach (var (demoTrack, demoKeyframe2) in _selection)
		{
			if (CanClipboard(demoTrack))
			{
				Clipboard.Add(new ClipboardEntry
				{
					TrackId = demoTrack.Id,
					Offset = demoKeyframe2.Time - num,
					Value = demoKeyframe2.Value,
					Easing = demoKeyframe2.Easing
				});
			}
		}
	}

	public void PasteAtPlayhead()
	{
		PasteClipboard(_playback.Time);
	}

	public void PasteClipboard(float time)
	{
		if (Clipboard.Count == 0)
		{
			return;
		}
		_suppressRebuild = true;
		_selection.Clear();
		_selectionSet.Clear();
		foreach (ClipboardEntry item in Clipboard)
		{
			DemoTrack track = _store.GetTrack(item.TrackId);
			if (track != null && CanClipboard(track))
			{
				DemoKeyframe demoKeyframe = _store.SetOrAddKeyframe(track, _playback.Snap(time + item.Offset), item.Value, _playback.TickDuration * 0.5f);
				_store.SetEasing(demoKeyframe, item.Easing);
				_selection.Add((track, demoKeyframe));
				_selectionSet.Add(demoKeyframe);
			}
		}
		_suppressRebuild = false;
		Rebuild();
	}

	private bool CanClipboard(DemoTrack track)
	{
		if (track.Kind == DemoTrackKind.Keyframes)
		{
			if (ClipboardFilter != null)
			{
				return ClipboardFilter(track);
			}
			return true;
		}
		return false;
	}

	private void OnStoreChanged()
	{
		if (!_suppressRebuild)
		{
			Rebuild();
		}
	}

	private void Rebuild()
	{
		_selection.RemoveAll(((DemoTrack track, DemoKeyframe key) pair) => _store.GetTrack(pair.track.Id) != pair.track || !pair.track.Keyframes.Contains(pair.key));
		_selectionSet.Clear();
		foreach (var item3 in _selection)
		{
			DemoKeyframe item = item3.key;
			_selectionSet.Add(item);
		}
		_clipSelection.RemoveAll(((DemoTrack track, DemoClip clip) pair) => _store.GetTrack(pair.track.Id) != pair.track || !pair.track.Clips.Contains(pair.clip));
		_clipSelectionSet.Clear();
		foreach (var item4 in _clipSelection)
		{
			DemoClip item2 = item4.clip;
			_clipSelectionSet.Add(item2);
		}
		((VisualElement)_tracks).Clear();
		_valueLabels.Clear();
		_keyEntries.Clear();
		_clipBars.Clear();
		_rows.Clear();
		HashSet<string> hashSet = new HashSet<string>();
		foreach (DemoTrack track in _store.Tracks)
		{
			if (string.IsNullOrEmpty(track.GroupId))
			{
				VisualElement val = BuildRow(track);
				_rows.Add((val, track, false, null));
				((VisualElement)_tracks).Add(val);
			}
			else
			{
				if (!hashSet.Add(track.GroupId))
				{
					continue;
				}
				VisualElement val2 = BuildGroupHeader(track.GroupId, track.GroupName);
				_rows.Add((val2, null, true, track.GroupId));
				((VisualElement)_tracks).Add(val2);
				foreach (DemoTrack track2 in _store.Tracks)
				{
					if (track2.GroupId == track.GroupId)
					{
						VisualElement val3 = BuildRow(track2);
						_rows.Add((val3, track2, false, track2.GroupId));
						((VisualElement)_tracks).Add(val3);
					}
				}
			}
		}
		RustUI.SetVisible(_empty, _store.Tracks.Count == 0);
		UpdatePlayhead();
		UpdateValues();
	}

