using System;

public sealed class DemoExportRange
{
	private float _length;

	private float _start;

	private float _end;

	private bool _hasRange;

	public float Length => _length;

	public float Start => _start;

	public float End => _end;

	public bool HasRange => _hasRange;

	public float Duration => Math.Max(0f, _end - _start);

	public event Action Changed;

	public DemoExportRange(float length)
	{
		_length = Math.Max(0f, length);
		_start = 0f;
		_end = _length;
	}

	public void SetStart(float time)
	{
		_start = Math.Min(Clamp(time), _end);
		_hasRange = true;
		this.Changed?.Invoke();
	}

	public void SetEnd(float time)
	{
		_end = Math.Max(Clamp(time), _start);
		_hasRange = true;
		this.Changed?.Invoke();
	}

	public void Clear()
	{
		_start = 0f;
		_end = _length;
		_hasRange = false;
		this.Changed?.Invoke();
	}

	public void Load(float start, float end, bool hasRange)
	{
		if (hasRange)
		{
			_start = Clamp(start);
			_end = Math.Max(_start, Clamp(end));
		}
		else
		{
			_start = 0f;
			_end = _length;
		}
		_hasRange = hasRange;
		this.Changed?.Invoke();
	}

	private float Clamp(float time)
	{
		if (time < 0f)
		{
			return 0f;
		}
		if (!(time > _length))
		{
			return time;
		}
		return _length;
	}
}


