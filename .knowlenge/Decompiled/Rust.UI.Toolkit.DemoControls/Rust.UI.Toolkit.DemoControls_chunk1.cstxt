	public void SetCompletionKeys(DemoKeyframe from, DemoKeyframe to)
	{
		_keys.Clear();
		_keys.Add(from);
		_keys.Add(to);
		_normalized = true;
		_selected = 0;
		Frame();
		this.SelectionChanged?.Invoke();
	}

	public void SetKeys(IEnumerable<DemoKeyframe> keys)
	{
		_normalized = false;
		_keys.Clear();
		foreach (DemoKeyframe key in keys)
		{
			_keys.Add(key);
		}
		_selected = ((_keys.Count <= 0) ? (-1) : 0);
		Frame();
		this.SelectionChanged?.Invoke();
	}

	public void Select(int index)
	{
		index = ((index >= 0 && index < _keys.Count) ? index : (-1));
