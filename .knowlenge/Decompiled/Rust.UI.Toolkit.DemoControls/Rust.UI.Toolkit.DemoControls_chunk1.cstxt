	private readonly IDemoPropertyHost _propertyHost;

	private readonly List<VisualElement> _pages = new List<VisualElement>();

	private readonly List<PropertyEntry> _entries = new List<PropertyEntry>();

	private readonly RustTabBar _tabBar;

	private readonly DemoExportTab _exportTab;

	private readonly DemoScenesTab _scenesTab;

	private float _pageHeight = 380f;

	protected override Vector2 ResizeSize
	{
