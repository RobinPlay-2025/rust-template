	public void SetCameraMode(int index)
	{
		_transport.SetMode(index);
		RebuildGuide((DemoCameraMode)index);
	}

	public void CycleCameraMode()
	{
		_transport.CycleMode();
	}

	public void SetDollyInfo(in DollyInfo info)
	{
		_dollyInfo.SetInfo(in info);
		if (info.Mode != _guideMode)
		{
			RebuildGuide(info.Mode);
		}
		bool flag = info.Mode == DemoCameraMode.DollyEditor;
		if (flag != _dollyShown)
		{
			_dollyShown = flag;
			if (flag)
			{
				RustAnim.PopIn((VisualElement)(object)_dollyInfo);
			}
			else
			{
				RustAnim.PopOut((VisualElement)(object)_dollyInfo, (Action)null);
			}
		}
		bool flag2 = info.Mode == DemoCameraMode.ShotDirector;
		if (flag2 != _recordShown)
		{
			_recordShown = flag2;
			if (flag2)
			{
				RustAnim.PopIn(_recordIndicator);
			}
			else
			{
				RustAnim.PopOut(_recordIndicator, (Action)null);
			}
		}
		bool flag3 = info.Mode == DemoCameraMode.Sandbox;
		if (flag3 != _sandboxShown)
		{
			_sandboxShown = flag3;
			if (flag3)
			{
				if (_interactive && _chromeVisible && !_hidden)
				{
					DemoSandboxPanel demoSandboxPanel = EnsureSandboxPanel();
					((VisualElement)demoSandboxPanel).BringToFront();
					RustAnim.SlideIn((VisualElement)(object)demoSandboxPanel);
				}
				else
				{
					_restoreSandbox = true;
				}
			}
			else
			{
				_restoreSandbox = false;
				_restoreSandboxOnChrome = false;
				if (_sandbox != null && RustUI.IsVisible((VisualElement)(object)_sandbox))
				{
					RustAnim.SlideOut((VisualElement)(object)_sandbox, (Action)null);
				}
			}
		}
		if (flag2)
		{
			string text = (info.Recording ? ("●  " + DemoControlsPhrases.RecordActive.translated) : ((info.RecordStage == DemoRecordStage.Countdown) ? RustUI.Format(DemoControlsPhrases.RecordCountdown, new object[1] { info.RecordCountdown }) : ((info.RecordStage != DemoRecordStage.LeadIn) ? DemoControlsPhrases.RecordArmedHint.translated : RustUI.Format(DemoControlsPhrases.RecordLeadIn, new object[1] { info.RecordCountdown }))));
			((TextElement)_recordLabel).text = RustUI.Upper(text);
			((VisualElement)_recordLabel).EnableInClassList("is-recording", info.Recording);
		}
	}

	public void SetExportStatus(in DemoExportStatus status)
	{
		_options?.SetExportStatus(in status);
	}

	public void RefreshPropertyValues()
	{
		_options?.RefreshValues();
	}

	public void SetSceneName(string sceneName)
	{
		_transport.SetSceneName(sceneName);
	}

	public void SetChromeVisible(bool visible)
	{
		if (_chromeVisible == visible)
		{
			return;
		}
		_chromeVisible = visible;
		RustUI.SetVisible(_dock, visible);
		SyncGuideVisibility();
		if (!visible)
		{
			_restoreOptionsOnChrome = _options != null && RustUI.IsVisible((VisualElement)(object)_options);
			if (_restoreOptionsOnChrome)
			{
				RustUI.SetVisible((VisualElement)(object)_options, false);
			}
			_restoreSandboxOnChrome = _sandbox != null && RustUI.IsVisible((VisualElement)(object)_sandbox);
			if (_restoreSandboxOnChrome)
			{
				RustUI.SetVisible((VisualElement)(object)_sandbox, false);
			}
			HideCursorToast();
			return;
		}
		if (_restoreOptionsOnChrome)
		{
			_restoreOptionsOnChrome = false;
			((VisualElement)_options).BringToFront();
			RustAnim.SlideIn((VisualElement)(object)_options);
		}
		if (_restoreSandboxOnChrome)
		{
			_restoreSandboxOnChrome = false;
			((VisualElement)_sandbox).BringToFront();
			RustAnim.SlideIn((VisualElement)(object)_sandbox);
		}
	}

	public void SetInteractive(bool interactive)
	{
		if (_interactive == interactive)
		{
			return;
		}
		_interactive = interactive;
		RustOverlay.CloseAllPopups();
		SetMuted(_dock, !interactive);
		SetMuted(_keyGuide, !interactive);
		SetMuted((VisualElement)(object)_dollyInfo, !interactive);
		if (!interactive)
		{
			_restoreOptions = _options != null && RustUI.IsVisible((VisualElement)(object)_options);
			_restoreTimeline = _timelineOpen;
			_restoreSandbox = _restoreSandbox || (_sandbox != null && RustUI.IsVisible((VisualElement)(object)_sandbox));
			if (_restoreOptions)
			{
				RustAnim.SlideOut((VisualElement)(object)_options, (Action)null);
			}
			if (_sandbox != null && RustUI.IsVisible((VisualElement)(object)_sandbox))
			{
				RustAnim.SlideOut((VisualElement)(object)_sandbox, (Action)null);
			}
			if (_timelineOpen)
			{
				SetTimelineOpen(open: false);
			}
			ShowCursorToast();
			return;
		}
		HideCursorToast();
		if (_restoreTimeline)
		{
			_restoreTimeline = false;
			SetTimelineOpen(open: true);
		}
		if (_restoreOptions)
		{
			_restoreOptions = false;
			if (_chromeVisible && !_hidden)
			{
				((VisualElement)_options).BringToFront();
				RustAnim.SlideIn((VisualElement)(object)_options);
			}
		}
		if (_restoreSandbox)
		{
			_restoreSandbox = false;
			if (_sandboxShown && _chromeVisible && !_hidden)
			{
				DemoSandboxPanel demoSandboxPanel = EnsureSandboxPanel();
				((VisualElement)demoSandboxPanel).BringToFront();
				RustAnim.SlideIn((VisualElement)(object)demoSandboxPanel);
			}
		}
		if (_chromeVisible && !_hidden)
		{
			RustHighlight.Flash(_dock, 500);
		}
	}

	public void SetTimelineOpen(bool open)
	{
		//IL_0032: Unknown result type (might be due to invalid IL or missing references)
		_timelineOpen = open;
		((VisualElement)_timeline).RemoveFromClassList("no-anim");
		((VisualElement)_timeline).style.height = StyleLength.op_Implicit(open ? _timelineHeight : 0f);
		_transport.KeyframesButton.IsOn = open;
	}

	public void ToggleOptions()
	{
		if (_options == null)
		{
			EnsureOptions();
			return;
		}
		if (RustUI.IsVisible((VisualElement)(object)_options))
		{
			RustAnim.SlideOut((VisualElement)(object)_options, (Action)null);
			return;
		}
		((VisualElement)_options).BringToFront();
		RustAnim.SlideIn((VisualElement)(object)_options);
	}

	private DemoOptionsPanel EnsureOptions()
	{
		if (_options == null)
		{
			_options = new DemoOptionsPanel(Playback, Keyframes, _propertyHost, ExportRange, _exportHost, _sceneHost);
			((VisualElement)_options).AddToClassList("demo-mutable");
			RustOverlay.GetLayer((VisualElement)(object)this).Add((VisualElement)(object)_options);
			RustUI.SetVisible((VisualElement)(object)_options, false);
			RustAnim.SlideIn((VisualElement)(object)_options);
		}
		return _options;
	}

	public DemoSandboxPanel EnsureSandboxPanel()
	{
		if (_sandbox == null)
		{
			_sandbox = new DemoSandboxPanel();
			((VisualElement)_sandbox).AddToClassList("demo-mutable");
			RustOverlay.GetLayer((VisualElement)(object)this).Add((VisualElement)(object)_sandbox);
			RustUI.SetVisible((VisualElement)(object)_sandbox, false);
		}
		return _sandbox;
	}

	public void ToggleHidden()
	{
		_hidden = !_hidden;
		RustUI.SetVisible(_dock, !_hidden);
		SyncGuideVisibility();
		if (_options != null && _hidden)
		{
			RustUI.SetVisible((VisualElement)(object)_options, false);
		}
		if (_sandbox != null && _hidden)
		{
			RustUI.SetVisible((VisualElement)(object)_sandbox, false);
		}
		if (!_hidden && _sandboxShown && _sandbox != null && _interactive && _chromeVisible)
		{
			((VisualElement)_sandbox).BringToFront();
			RustAnim.SlideIn((VisualElement)(object)_sandbox);
		}
		if (_hidden)
		{
			HideCursorToast();
		}
	}

