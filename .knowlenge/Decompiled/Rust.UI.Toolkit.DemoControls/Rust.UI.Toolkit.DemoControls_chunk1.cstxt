	public void ResolveTangents(int index, out float inTangent, out float outTangent)
	{
		if (_normalized)
		{
			DemoKeyframe demoKeyframe = _keys[index];
			if (demoKeyframe.TangentsSet)
			{
				inTangent = demoKeyframe.InTangent;
				outTangent = demoKeyframe.OutTangent;
			}
			else
			{
				float num = ChordSlope();
				inTangent = ((demoKeyframe.TangentMode == DemoTangentMode.Flat) ? 0f : num);
				outTangent = inTangent;
