	public void SetObjects(List<DemoSandboxObject> objects)
	{
		_tree.ClearNodes();
		_categories.Clear();
		if (objects != null)
		{
			foreach (DemoSandboxObject @object in objects)
			{
				_categories[@object.Id] = @object.Category;
				RustTreeView tree = _tree;
				ulong id = @object.Id;
				RustTreeNode val = tree.AddNode((RustTreeNode)null, id.ToString(), @object.Name, CategoryIcons[(int)@object.Category]);
				val.Row.AddToClassList(CategoryClass(@object.Category));
				if (@object.Inspectable)
				{
					ulong id2 = @object.Id;
					val.AddTrailingButton((Icons)61459, (Action)delegate
					{
						RequestInspect(id2);
					}, DemoControlsPhrases.SandboxInspect);
				}
			}
		}
		RustUI.SetVisible((VisualElement)(object)_empty, _categories.Count == 0);
		((TextElement)_countLabel).text = RustUI.Upper(RustUI.Format(DemoControlsPhrases.SandboxObjectCount, new object[1] { _categories.Count }));
		ApplyFilter(_filter);
		_tree.SetSelected((_selectedId != 0L) ? _selectedId.ToString() : null);
		UpdateFooter();
	}

	private void ApplyFilter(string filter)
	{
		_filter = filter;
		string text = (string.IsNullOrWhiteSpace(filter) ? null : filter.ToLowerInvariant());
		foreach (RustTreeNode root in _tree.Roots)
		{
			bool flag = text == null || (root.Label != null && root.Label.ToLowerInvariant().Contains(text));
			RustUI.SetVisible((VisualElement)(object)root, flag);
		}
	}

	public void SetSelected(ulong id)
	{
		_selectedId = id;
		_tree.SetSelected((id != 0L) ? id.ToString() : null);
		UpdateFooter();
	}

	public void FlashNode(ulong id)
	{
		RustTreeNode node = default(RustTreeNode);
		if (_tree.TryGetNode(id.ToString(), ref node))
		{
			node.Row.AddToClassList("demo-prop-flash");
			node.Row.schedule.Execute((Action)delegate
			{
				node.Row.RemoveFromClassList("demo-prop-flash");
			}).StartingIn(380L);
		}
	}

