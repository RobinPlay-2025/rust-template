			Refresh();
		};
		_valueField.OnSubmit += delegate(string text)
		{
			if (!_suppressFieldEvents && TryParseNumber(text, out var value))
			{
				_plot.SetSelectedValue(value);
			}
			Refresh();
		};
		_inField.OnSubmit += delegate
		{
			CommitTangents();
		};
		_outField.OnSubmit += delegate
		{
			CommitTangents();
		};
