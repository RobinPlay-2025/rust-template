public enum DemoKeyEasing
{
	Linear,
	EaseLeft,
	EaseRight,
	Auto
}


using Rust.UI.Toolkit.DemoControls;

public class DemoKeyframe
{
	public float Time;

	public float Value;

	public DemoKeyEasing Easing;
}


public enum DemoTrackKind
{
	Keyframes,
	Clip
}


using UnityEngine;

public class DemoClip
{
	public float Start;

	public float Duration;

	public float TrimStart;

	public float SourceDuration;

	public string Label;

	public float End => Start + Duration;

	public float SegmentLength
	{
		get
		{
			if (!(SourceDuration > 0f))
			{
				return 0f;
			}
			return Mathf.Max(0.01f, SourceDuration - TrimStart);
		}
	}

	public bool Loops
	{
		get
		{
			if (SourceDuration > 0f)
			{
				return Duration > SegmentLength + 0.001f;
			}
			return false;
		}
	}
}


using System;
using System.Collections.Generic;
using Rust.UI.Toolkit;
using Rust.UI.Toolkit.DemoControls;

public class DemoTrack
{
	public string GroupId;

	public string GroupName;

	public DemoTrackKind Kind;

	public string Id { get; }

	public string Name { get; }

	public Icons Icon { get; }

	public Func<float, string> Formatter { get; set; }

	public List<DemoKeyframe> Keyframes { get; } = new List<DemoKeyframe>();

	public List<DemoClip> Clips { get; } = new List<DemoClip>();

	public DemoTrack(string id, string name, Icons icon)
	{
		//IL_002b: Unknown result type (might be due to invalid IL or missing references)
		//IL_002c: Unknown result type (might be due to invalid IL or missing references)
		Id = id;
		Name = name;
		Icon = icon;
	}

	public DemoKeyframe FindAt(float time, float tolerance)
	{
		foreach (DemoKeyframe keyframe in Keyframes)
		{
			if (Math.Abs(keyframe.Time - time) <= tolerance)
			{
				return keyframe;
			}
		}
		return null;
	}

	public float Evaluate(float time)
	{
		if (Keyframes.Count == 0)
		{
			return 0f;
		}
		if (time <= Keyframes[0].Time)
		{
			return Keyframes[0].Value;
		}
		DemoKeyframe demoKeyframe = Keyframes[Keyframes.Count - 1];
		if (time >= demoKeyframe.Time)
		{
			return demoKeyframe.Value;
		}
		for (int i = 0; i < Keyframes.Count - 1; i++)
		{
			DemoKeyframe demoKeyframe2 = Keyframes[i];
			DemoKeyframe demoKeyframe3 = Keyframes[i + 1];
			if (!(time > demoKeyframe3.Time))
			{
				float num = demoKeyframe3.Time - demoKeyframe2.Time;
				float num2 = ((num <= 0f) ? 1f : ((time - demoKeyframe2.Time) / num));
				bool flag = demoKeyframe2.Easing == DemoKeyEasing.EaseRight || demoKeyframe2.Easing == DemoKeyEasing.Auto;
				bool flag2 = demoKeyframe3.Easing == DemoKeyEasing.EaseLeft || demoKeyframe3.Easing == DemoKeyEasing.Auto;
				if (flag && flag2)
				{
					num2 = num2 * num2 * (3f - 2f * num2);
				}
				else if (flag)
				{
					num2 *= num2;
				}
				else if (flag2)
				{
					num2 = 1f - (1f - num2) * (1f - num2);
				}
				return demoKeyframe2.Value + (demoKeyframe3.Value - demoKeyframe2.Value) * num2;
			}
		}
		return demoKeyframe.Value;
	}

	public string Format(float value)
	{
		if (Formatter == null)
		{
			return value.ToString("0.##");
		}
		return Formatter(value);
	}

	internal void Sort()
	{
		Keyframes.Sort((DemoKeyframe a, DemoKeyframe b) => a.Time.CompareTo(b.Time));
	}

	public DemoTrack Clone()
	{
		//IL_000d: Unknown result type (might be due to invalid IL or missing references)
		DemoTrack demoTrack = new DemoTrack(Id, Name, Icon)
		{
			Formatter = Formatter,
			GroupId = GroupId,
			GroupName = GroupName,
			Kind = Kind
		};
		foreach (DemoKeyframe keyframe in Keyframes)
		{
			demoTrack.Keyframes.Add(new DemoKeyframe
			{
				Time = keyframe.Time,
				Value = keyframe.Value,
				Easing = keyframe.Easing
			});
		}
		foreach (DemoClip clip in Clips)
		{
			demoTrack.Clips.Add(new DemoClip
			{
				Start = clip.Start,
				Duration = clip.Duration,
				TrimStart = clip.TrimStart,
				SourceDuration = clip.SourceDuration,
				Label = clip.Label
			});
		}
		return demoTrack;
	}
}


using System;
using System.Collections.Generic;
using Rust.UI.Toolkit;
using Rust.UI.Toolkit.DemoControls;

public class DemoKeyframeStore
{
	public readonly struct HistorySuppression : IDisposable
	{
		private readonly DemoKeyframeStore _store;

		internal HistorySuppression(DemoKeyframeStore store)
		{
			_store = store;
			store._suppressHistory = true;
		}

		public void Dispose()
		{
			_store._suppressHistory = false;
		}
	}

	public Func<DemoTrack, bool> UndoFilter;

	private const int MaxUndo = 10;

	private readonly List<DemoTrack> _tracks = new List<DemoTrack>();

	private readonly List<List<DemoTrack>> _undoStack = new List<List<DemoTrack>>();

	private readonly List<List<DemoTrack>> _redoStack = new List<List<DemoTrack>>();

	private bool _gesture;

	private bool _gestureRecorded;

	private bool _restoring;

	private bool _suppressHistory;

	private DemoKeyframe _lastValueSet;

	public IReadOnlyList<DemoTrack> Tracks => _tracks;

	public bool CanUndo => _undoStack.Count > 0;

	public bool CanRedo => _redoStack.Count > 0;

	public event Action Changed;

	public event Action<DemoTrack> TrackAdded;

	public event Action<DemoTrack> TrackRemoved;

	public event Action HistoryChanged;

	public void BeginGesture()
	{
		_gesture = true;
		_gestureRecorded = false;
	}

	public void EndGesture()
	{
		_gesture = false;
	}

	public void ClearHistory()
	{
		_undoStack.Clear();
		_redoStack.Clear();
		_lastValueSet = null;
		this.HistoryChanged?.Invoke();
	}

	public void Undo()
	{
		if (!_gesture && _undoStack.Count != 0)
		{
			List<DemoTrack> state = _undoStack[_undoStack.Count - 1];
			_undoStack.RemoveAt(_undoStack.Count - 1);
			_redoStack.Add(CaptureState());
			ApplyState(state);
			_lastValueSet = null;
			this.HistoryChanged?.Invoke();
		}
	}

	public void Redo()
	{
		if (!_gesture && _redoStack.Count != 0)
		{
			List<DemoTrack> state = _redoStack[_redoStack.Count - 1];
			_redoStack.RemoveAt(_redoStack.Count - 1);
			_undoStack.Add(CaptureState());
			ApplyState(state);
			_lastValueSet = null;
			this.HistoryChanged?.Invoke();
		}
	}

	private bool IncludeInUndo(DemoTrack track)
	{
		if (UndoFilter != null)
		{
			return UndoFilter(track);
		}
		return true;
	}

	private void RecordUndo()
	{
		if (CanRecordUndo())
		{
			PushUndoState(null);
		}
	}

	private void RecordUndo(DemoTrack track)
	{
		if (CanRecordUndo() && IncludeInUndo(track))
		{
			PushUndoState(null);
		}
	}

	private void RecordUndo(DemoTrack track, DemoKeyframe keyframe)
	{
		if (CanRecordUndo() && IncludeInUndo(track) && keyframe != _lastValueSet)
		{
			PushUndoState(keyframe);
		}
	}

	private bool CanRecordUndo()
	{
		if (!_restoring && !_suppressHistory)
		{
			if (_gesture)
			{
				return !_gestureRecorded;
			}
			return true;
		}
		return false;
	}

	public HistorySuppression SuppressHistory()
	{
		return new HistorySuppression(this);
	}

	private void PushUndoState(DemoKeyframe lastValueSet)
	{
		if (_gesture)
		{
			_gestureRecorded = true;
		}
		_lastValueSet = lastValueSet;
		_redoStack.Clear();
		while (_undoStack.Count >= 10)
		{
			_undoStack.RemoveAt(0);
		}
		_undoStack.Add(CaptureState());
		this.HistoryChanged?.Invoke();
	}

	private List<DemoTrack> CaptureState()
	{
		List<DemoTrack> list = new List<DemoTrack>(_tracks.Count);
		foreach (DemoTrack track in _tracks)
		{
			list.Add(IncludeInUndo(track) ? track.Clone() : track);
		}
		return list;
	}

	private void ApplyState(List<DemoTrack> state)
	{
		_restoring = true;
		List<DemoTrack> list = new List<DemoTrack>(state.Count);
		foreach (DemoTrack item2 in state)
		{
			if (IncludeInUndo(item2))
			{
				list.Add(item2);
				continue;
			}
			DemoTrack item = GetTrack(item2.Id) ?? item2;
			if (!list.Contains(item))
			{
				list.Add(item);
			}
		}
		_tracks.Clear();
		_tracks.AddRange(list);
		this.Changed?.Invoke();
		_restoring = false;
	}

	public DemoTrack GetTrack(string id)
	{
		foreach (DemoTrack track in _tracks)
		{
			if (track.Id == id)
			{
				return track;
			}
		}
		return null;
	}

	public DemoTrack AddTrack(string id, string name, Icons icon, Func<float, string> formatter = null, string groupId = null, string groupName = null, DemoTrackKind kind = DemoTrackKind.Keyframes)
	{
		//IL_000f: Unknown result type (might be due to invalid IL or missing references)
		DemoTrack track = GetTrack(id);
		if (track != null)
		{
			return track;
		}
		DemoTrack demoTrack = new DemoTrack(id, name, icon)
		{
			Formatter = formatter,
			GroupId = groupId,
			GroupName = groupName,
			Kind = kind
		};
		RecordUndo();
		_tracks.Add(demoTrack);
		this.TrackAdded?.Invoke(demoTrack);
		this.Changed?.Invoke();
		return demoTrack;
	}

	public void AddClip(DemoTrack track, DemoClip clip)
	{
		RecordUndo(track);
		track.Clips.Add(clip);
		track.Clips.Sort((DemoClip left, DemoClip right) => left.Start.CompareTo(right.Start));
		this.Changed?.Invoke();
	}

	public void RemoveClip(DemoTrack track, DemoClip clip)
	{
		if (track.Clips.Contains(clip))
		{
			RecordUndo(track);
			track.Clips.Remove(clip);
			this.Changed?.Invoke();
		}
	}

	public void SetClip(DemoTrack track, DemoClip clip, float start, float duration, float trimStart = -1f)
	{
		RecordUndo(track);
		clip.Start = start;
		clip.Duration = duration;
		if (trimStart >= 0f)
		{
			clip.TrimStart = trimStart;
		}
		track.Clips.Sort((DemoClip left, DemoClip right) => left.Start.CompareTo(right.Start));
		this.Changed?.Invoke();
	}

	public void ReorderTracks(List<DemoTrack> order)
	{
		if (order == null || order.Count != _tracks.Count)
		{
			return;
		}
		foreach (DemoTrack track in _tracks)
		{
			if (!order.Contains(track))
			{
				return;
			}
		}
		bool flag = true;
		for (int i = 0; i < _tracks.Count; i++)
		{
			if (_tracks[i] != order[i])
			{
				flag = false;
				break;
			}
		}
		if (!flag)
		{
			RecordUndo();
			_tracks.Clear();
			_tracks.AddRange(order);
			this.Changed?.Invoke();
		}
	}

	public void RemoveTrack(DemoTrack track)
	{
		if (_tracks.Contains(track))
		{
			RecordUndo();
			_tracks.Remove(track);
			this.TrackRemoved?.Invoke(track);
			this.Changed?.Invoke();
		}
	}

	public DemoKeyframe AddKeyframe(DemoTrack track, float time, float value = 0f)
	{
		RecordUndo(track);
		DemoKeyframe demoKeyframe = new DemoKeyframe
		{
			Time = time,
			Value = value
		};
		track.Keyframes.Add(demoKeyframe);
		track.Sort();
		this.Changed?.Invoke();
		return demoKeyframe;
	}

	public DemoKeyframe SetOrAddKeyframe(DemoTrack track, float time, float value, float tolerance)
	{
		DemoKeyframe demoKeyframe = track.FindAt(time, tolerance);
		if (demoKeyframe != null)
		{
			RecordUndo(track, demoKeyframe);
			demoKeyframe.Value = value;
			this.Changed?.Invoke();
			return demoKeyframe;
		}
		return AddKeyframe(track, time, value);
	}

	public void RemoveKeyframe(DemoTrack track, DemoKeyframe keyframe)
	{
		if (track.Keyframes.Contains(keyframe))
		{
			RecordUndo(track);
			track.Keyframes.Remove(keyframe);
			this.Changed?.Invoke();
		}
	}

	public void MoveKeyframe(DemoTrack track, DemoKeyframe keyframe, float time)
	{
		RecordUndo(track);
		keyframe.Time = time;
		track.Sort();
		this.Changed?.Invoke();
	}

	public void SetEasing(DemoKeyframe keyframe, DemoKeyEasing easing)
	{
		if (keyframe.Easing != easing)
		{
			RecordUndo();
			keyframe.Easing = easing;
			this.Changed?.Invoke();
		}
	}

	public bool ToggleKeyframe(DemoTrack track, float time, float tolerance, float value = 0f)
	{
		DemoKeyframe demoKeyframe = track.FindAt(time, tolerance);
		if (demoKeyframe != null)
		{
			RemoveKeyframe(track, demoKeyframe);
			return false;
		}
		AddKeyframe(track, time, value);
		return true;
	}
}


