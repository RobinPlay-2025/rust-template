		ResolveWeights(demoKeyframe, demoKeyframe2, out var outWeight, out var inWeight);
		float num2 = EvaluateSegment(demoKeyframe.Time, 0f, demoKeyframe2.Time, 1f, demoKeyframe.OutTangent, demoKeyframe2.InTangent, outWeight, inWeight, time);
		return demoKeyframe.Time + Mathf.Clamp01(num2) * num;
	}
