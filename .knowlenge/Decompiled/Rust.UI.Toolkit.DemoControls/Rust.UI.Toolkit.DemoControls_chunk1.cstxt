	public void DeleteSelected()
	{
		if (_selected >= 0 && _keys.Count > 2)
		{
			_keys.RemoveAt(_selected);
			_selected = Mathf.Min(_selected, _keys.Count - 1);
			((VisualElement)this).MarkDirtyRepaint();
			this.SelectionChanged?.Invoke();
			this.KeysChanged?.Invoke();
		}
	}

