		((VisualElement)window).Add((VisualElement)(object)val);
		window.AddFooterButton(DemoControlsPhrases.CommonCancel, (Icons)61453, (RustButtonStyle)0, (Action)window.Close, false);
		window.AddFooterButton(DemoControlsPhrases.ScenesDelete, (Icons)62189, (RustButtonStyle)2, (Action)delegate
		{
			_host.DeleteScene(scene.Id);
			window.Close();
		}, true);
		window.Show((VisualElement)(object)this, true, false);
	}

	private int ChoiceIndexForCurrent(List<string> ids)
	{
		int num = ids.IndexOf(_host.CurrentSceneId);
		if (num < 0)
		{
			return 0;
		}
		return num + 1;
	}
}


using System;
using UnityEngine;

public class DemoTimelineZoom
{
	public const float StepFactor = 1.5f;

	public const float MinVisibleSeconds = 5f;

	public static float MaxZoomSetting;

	private readonly float _length;

	private float _zoom = 1f;

	private float _scrollNorm;

	public float MaxZoom
	{
		get
		{
			if (!(MaxZoomSetting > 1f))
			{
				return Mathf.Max(1f, _length / 5f);
			}
			return MaxZoomSetting;
		}
	}

	public float Zoom => _zoom;

	public float VisibleDuration => _length / _zoom;

	public float VisibleStart => _scrollNorm * (_length - VisibleDuration);

	public float ScrollNorm
	{
		get
		{
			return _scrollNorm;
		}
		set
		{
			value = ((_zoom <= 1f) ? 0f : Mathf.Clamp01(value));
			if (!Mathf.Approximately(_scrollNorm, value))
			{
				_scrollNorm = value;
				this.Changed?.Invoke();
			}
		}
	}

	public event Action Changed;

	public DemoTimelineZoom(float length)
	{
		_length = Mathf.Max(1f, length);
	}

	public float TimeToX(float time, float viewWidth)
	{
		float num = viewWidth * _zoom;
		return time / _length * num - _scrollNorm * (num - viewWidth);
	}

	public float XToTime(float x, float viewWidth)
	{
		float num = viewWidth * _zoom;
		float num2 = _scrollNorm * (num - viewWidth);
		return Mathf.Clamp01((x + num2) / num) * _length;
	}

	public void SetWindow(float start, float duration)
	{
		duration = Mathf.Clamp(duration, _length / MaxZoom, _length);
		float num = _length / duration;
		if (num <= 1.001f)
		{
			num = 1f;
			duration = _length;
		}
		start = Mathf.Clamp(start, 0f, _length - duration);
		float num2 = _length - duration;
		float num3 = ((num2 > 0.0001f) ? Mathf.Clamp01(start / num2) : 0f);
		if (!Mathf.Approximately(num, _zoom) || !Mathf.Approximately(num3, _scrollNorm))
		{
			_zoom = num;
			_scrollNorm = num3;
			this.Changed?.Invoke();
		}
	}
}


