			{
				OnValueChanged(property, binding);
			});
			RustButton button = null;
			RustButton val4 = new RustButton((string)null, (Icons)62194, (RustButtonStyle)4, (Action)delegate
			{
				ToggleKey(property, binding);
			});
			((VisualElement)val4).AddToClassList("demo-prop-key");
			((VisualElement)val4).visible = property.Keyframable;
			Hierarchy hierarchy = ((VisualElement)val3).hierarchy;
			((Hierarchy)(ref hierarchy)).Add((VisualElement)(object)val4);
			if (property.Keyframable)
			{
				button = RustTooltip.WithTooltip<RustButton>(val4, DemoControlsPhrases.TipAddKeyframe);
			}
			_entries.Add(new PropertyEntry
			{
				Property = property,
				Button = button,
				Binding = binding,
				Row = (VisualElement)(object)val3,
				Page = val,
				TabIndex = tabIndex
