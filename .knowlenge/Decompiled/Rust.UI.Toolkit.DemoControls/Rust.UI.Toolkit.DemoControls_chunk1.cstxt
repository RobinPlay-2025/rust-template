		}
		else
		{
			DemoCurveMath.ResolveTangents(_keys, index, out inTangent, out outTangent);
		}
	}

	private float ChordSlope()
	{
		if (_keys.Count < 2)
		{
			return 0f;
		}
		float num = _keys[_keys.Count - 1].Time - _keys[0].Time;
		if (!(num <= 0.0001f))
		{
			return 1f / num;
		}
		return 0f;
	}

	public float Evaluate(float time)
	{
		if (_keys.Count == 0)
		{
			return 0f;
		}
		if (time <= _keys[0].Time)
		{
			return ValueOf(0);
		}
		if (time >= _keys[_keys.Count - 1].Time)
		{
			return ValueOf(_keys.Count - 1);
		}
		if (!DemoCurveMath.TryFindSegment(_keys, time, out var index))
		{
			return ValueOf(_keys.Count - 1);
		}
		DemoKeyframe demoKeyframe = _keys[index];
		DemoKeyframe demoKeyframe2 = _keys[index + 1];
		if (demoKeyframe.TangentMode == DemoTangentMode.Stepped)
		{
			return ValueOf(index);
		}
		if (demoKeyframe2.Time - demoKeyframe.Time <= 0.0001f)
		{
			return ValueOf(index + 1);
		}
		ResolveTangents(index, out var inTangent, out var outTangent);
		ResolveTangents(index + 1, out var inTangent2, out inTangent);
		DemoCurveMath.ResolveWeights(demoKeyframe, demoKeyframe2, out var outWeight, out var inWeight);
		return DemoCurveMath.EvaluateSegment(demoKeyframe.Time, ValueOf(index), demoKeyframe2.Time, ValueOf(index + 1), outTangent, inTangent2, outWeight, inWeight, time);
	}

	private static float PickStep(float span, float pixels, float targetPixels)
	{
		if (span <= 0f || pixels <= 0f)
