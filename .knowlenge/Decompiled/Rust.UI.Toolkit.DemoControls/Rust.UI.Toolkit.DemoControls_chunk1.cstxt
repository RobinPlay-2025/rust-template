			{
				selected.TangentMode = ((!evt.newValue) ? DemoTangentMode.Broken : DemoTangentMode.Smooth);
				((VisualElement)_plot).MarkDirtyRepaint();
				Refresh();
			}
		});
		_modeDropdown.OnSelected += delegate(int index, string _)
		{
			if (!_suppressFieldEvents && index >= 0 && index < ModeOrder.Length)
			{
				_plot.ApplyTangentMode(ModeOrder[index]);
			}
		};
	}

	private void CommitTangents()
	{
		if (!_suppressFieldEvents)
		{
			if (!TryParseNumber(_inField.Text, out var value) || !TryParseNumber(_outField.Text, out var value2))
			{
				Refresh();
				return;
			}
			_plot.SetSelectedTangents(value, value2);
			Refresh();
		}
	}

	private static bool TryParseNumber(string text, out float value)
	{
		if (string.IsNullOrEmpty(text))
		{
			value = 0f;
			return false;
		}
		StringBuilder stringBuilder = new StringBuilder();
		foreach (char c in text)
		{
			if (!char.IsDigit(c))
			{
				switch (c)
				{
				case '+':
				case '-':
				case '.':
					break;
				case '−':
					stringBuilder.Append('-');
					continue;
				default:
					continue;
				}
			}
			stringBuilder.Append(c);
		}
		return float.TryParse(stringBuilder.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out value);
	}

	private static bool TryParseTime(string text, out float seconds)
	{
		seconds = 0f;
		if (string.IsNullOrEmpty(text))
		{
			return false;
		}
		text = text.Trim();
		int num = text.IndexOf(':');
		if (num < 0)
		{
			return TryParseNumber(text, out seconds);
		}
		if (!TryParseNumber(text.Substring(0, num), out var value))
		{
			return false;
		}
		if (!TryParseNumber(text.Substring(num + 1), out var value2))
		{
			return false;
		}
		seconds = value * 60f + value2;
		return true;
	}

