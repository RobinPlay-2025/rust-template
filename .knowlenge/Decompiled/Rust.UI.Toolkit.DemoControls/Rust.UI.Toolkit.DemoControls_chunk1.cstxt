		else
		{
			this.CurveEditRequested?.Invoke(new DemoCurveEditRequest(track, keyframe));
		}
	}

	private bool TryGetSelectionRange(DemoTrack track, out float rangeStart, out float rangeEnd)
	{
		rangeStart = float.MaxValue;
		rangeEnd = float.MinValue;
		int num = 0;
		foreach (var (demoTrack, demoKeyframe) in _selection)
		{
			if (demoTrack == track)
			{
				rangeStart = Mathf.Min(rangeStart, demoKeyframe.Time);
				rangeEnd = Mathf.Max(rangeEnd, demoKeyframe.Time);
				num++;
			}
		}
		return num > 1;
	}

