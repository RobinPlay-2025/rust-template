	private void RebuildGuide(DemoCameraMode mode)
	{
		_guideMode = mode;
		((TextElement)_guideTitle).text = RustUI.Upper(mode.DisplayName());
		((TextElement)_guideDesc).text = GuideDescription(mode).translated;
		_guideRows.Clear();
		AddGuideRow(_guideRows, "Alt", DemoControlsPhrases.GuideToggleCursor);
		switch (mode)
		{
		case DemoCameraMode.FirstPerson:
		case DemoCameraMode.ThirdPerson:
			AddGuideRow(_guideRows, "Space", DemoControlsPhrases.GuidePlayPause);
			AddGuideRow(_guideRows, "← / →", DemoControlsPhrases.GuideJump);
			AddGuideRow(_guideRows, ", / .", DemoControlsPhrases.GuideStep);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.FreeCamera:
			AddGuideRow(_guideRows, "K", DemoControlsPhrases.GuideKeyframeTimeline);
			AddGuideRow(_guideRows, "O", DemoControlsPhrases.GuideOptionsPanel);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.DollyEditor:
			AddGuideRow(_guideRows, "J", DemoControlsPhrases.GuideAddDollyKey);
			AddGuideRow(_guideRows, "RMB", DemoControlsPhrases.GuideDollyPick);
			AddGuideRow(_guideRows, "Del", DemoControlsPhrases.GuideDeleteKeyframe);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.DollyView:
			AddGuideRow(_guideRows, "Space", DemoControlsPhrases.GuidePlayPause);
			AddGuideRow(_guideRows, "J", DemoControlsPhrases.GuideAddDollyKey);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.ShotDirector:
			AddGuideRow(_guideRows, "R", DemoControlsPhrases.GuideToggleRecord);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		case DemoCameraMode.Sandbox:
			AddGuideRow(_guideRows, "RMB", DemoControlsPhrases.GuideSandboxPick);
			AddGuideRow(_guideRows, "Scroll", DemoControlsPhrases.GuideSandboxRotate);
			AddGuideRow(_guideRows, "C", DemoControlsPhrases.GuideCycleMode);
			break;
		}
		AddGuideRow(_guideRows, "Tab", DemoControlsPhrases.GuideHideUi);
	}

	private static Phrase GuideDescription(DemoCameraMode mode)
	{
		return (Phrase)(mode switch
		{
			DemoCameraMode.ThirdPerson => DemoControlsPhrases.GuideDescThirdPerson, 
			DemoCameraMode.FreeCamera => DemoControlsPhrases.GuideDescFreeCamera, 
			DemoCameraMode.DollyEditor => DemoControlsPhrases.GuideDescDollyEditor, 
			DemoCameraMode.DollyView => DemoControlsPhrases.GuideDescDollyView, 
			DemoCameraMode.ShotDirector => DemoControlsPhrases.GuideDescShotDirector, 
			DemoCameraMode.Sandbox => DemoControlsPhrases.GuideDescSandbox, 
			_ => DemoControlsPhrases.GuideDescFirstPerson, 
		});
	}

