		((VisualElement)window).Add((VisualElement)(object)table);
		window.AddFooterButton("Demos Folder", (Icons)61564, (RustButtonStyle)0, (Action)null, false);
		window.AddFooterButton("Refresh", (Icons)62193, (RustButtonStyle)0, (Action)Populate, false);
		window.AddFooterButton("Delete", (Icons)62189, (RustButtonStyle)2, (Action)delegate
		{
			table.RemoveRow(table.SelectedRow);
		}, true);
		window.AddFooterButton("Play", (Icons)61764, (RustButtonStyle)1, (Action)delegate
		{
			window.Close();
			LoadingScreenExample.Show(context);
		}, true);
		window.Show(context, true, false);
		return window;
		void Populate()
		{
			table.ClearRows();
			table.AddRow(new string[3] { "hello", "AUGUST 15, 2025 - 02:01", "00:00:19" });
			table.AddRow(new string[3] { "airfield raid", "AUGUST 14, 2025 - 22:47", "00:12:03" });
			table.AddRow(new string[3] { "cargo heist", "AUGUST 12, 2025 - 19:30", "00:04:51" });
			table.Select(table.Rows[0]);
		}
	}
}


