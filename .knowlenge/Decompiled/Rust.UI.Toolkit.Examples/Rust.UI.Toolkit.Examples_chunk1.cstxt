	private static VisualElement WideRow(params VisualElement[] children)
	{
		VisualElement val = RustUI.Row(Array.Empty<VisualElement>());
		val.AddToClassList("example-gallery-row");
		foreach (VisualElement val2 in children)
		{
			val2.AddToClassList("example-gallery-row__item");
			if (val2 is RustInput || val2 is RustProgressBar)
			{
				val2.AddToClassList("example-gallery-row__fixed");
			}
			val.Add(val2);
		}
		return val;
	}
