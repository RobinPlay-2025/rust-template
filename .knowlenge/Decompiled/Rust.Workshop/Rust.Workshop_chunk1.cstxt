using Rust.UI;
using Rust.Workshop;
using TMPro;
using UnityEngine;
using UnityEngine.Events;

public class WorkshopItemSelectionButton : MonoBehaviour
{
	public RustButton Button;

	[HideInInspector]
	public string ItemIdentifier;

	[HideInInspector]
	public WorkshopItemEditor Editor;

	private void OnEnable()
	{
		//IL_0020: Unknown result type (might be due to invalid IL or missing references)
		//IL_002a: Expected O, but got Unknown
		if ((Object)(object)Button != (Object)null)
		{
			Button.OnToggleEnabled.AddListener(new UnityAction(SelectItem));
		}
	}

	private void OnDisable()
	{
		//IL_0020: Unknown result type (might be due to invalid IL or missing references)
		//IL_002a: Expected O, but got Unknown
		if ((Object)(object)Button != (Object)null)
		{
			Button.OnToggleEnabled.RemoveListener(new UnityAction(SelectItem));
		}
	}

	public void SetItemType(string itemIdentifier, WorkshopItemEditor editor)
	{
		ItemIdentifier = itemIdentifier;
		Editor = editor;
		((TMP_Text)Button.Text).text = ItemIdentifier;
	}

	[UnityEvent]
	private void SelectItem()
	{
		if (!((Object)(object)Editor == (Object)null))
		{
			Editor.SelectItemType(ItemIdentifier);
		}
	}
}


using UnityEngine;

public class WorkshopScreenshotSettings : FacepunchBehaviour
{
	[Tooltip("Offsets the automated workshop screenshot cameras, for items that don't sit where the scene anchors expect")]
	public Vector3 cameraOffset;

	[Tooltip("Rotates the automated workshop screenshot cameras, in their own space. X tilts down, which is what a raised flat item needs to be seen from above rather than edge-on")]
	public Vector3 cameraRotationOffset;

	[Tooltip("Alternate any WorkshopAnimatorControls boolean between shots, so the set shows the item both closed and open")]
	public bool alternateAnimatorBetweenShots = true;
}


