using System;
using System.Linq;
using Rust.Workshop;
using UnityEngine;

[CreateAssetMenu(menuName = "Rust/Skins/Skinnable")]
public class Skinnable : ScriptableObject
{
	[Serializable]
	public class Group
	{
		public string Name = "MAIN";

		public Material Material;

		public int MaxTextureSize = 1024;
	}

	public string Name;

	public string ItemName;

	public GameObject EntityPrefab;

	public string EntityPrefabName;

	public GameObject EntityFemalePrefab;

	public string EntityFemalePrefabName;

	public GameObject ViewmodelPrefab;

	public string ViewmodelPrefabName;

	public Mesh[] MeshDownloads;

	public string[] MeshDownloadPaths;

	public Category Category;

	public bool HideInWorkshopUpload;

	[Header("Workshop Preview settings")]
	public float WorkshopDefaultZoom;

	public Vector3 WorkshopDefaultRotationOffset = Vector3.zero;

	public Group[] Groups;

	public static Skinnable[] All;

	[NonSerialized]
	private Material[] _sourceMaterials;

	public Material[] SourceMaterials
	{
		get
		{
			if (_sourceMaterials == null)
			{
				_sourceMaterials = (Material[])(object)new Material[Groups.Length];
				for (int i = 0; i < Groups.Length; i++)
				{
					_sourceMaterials[i] = Groups[i].Material;
				}
			}
			return _sourceMaterials;
		}
	}

	public static Skinnable FindForItem(string itemType)
	{
		return All.FirstOrDefault((Skinnable x) => string.Compare(x.ItemName, itemType, StringComparison.OrdinalIgnoreCase) == 0 || string.Compare(x.Name, itemType, StringComparison.OrdinalIgnoreCase) == 0);
	}

	public static Skinnable FindForEntity(string entityName)
	{
		return All.FirstOrDefault((Skinnable x) => string.Compare(x.EntityPrefabName, entityName, StringComparison.OrdinalIgnoreCase) == 0 || string.Compare(x.EntityFemalePrefabName, entityName, StringComparison.OrdinalIgnoreCase) == 0);
	}
}


using Rust.UI;
using UnityEngine;

public class WorkshopAnimatorButton : FacepunchBehaviour
{
	public RustIcon icon;

	public RustText text;

	private WorkshopAnimatorControls controls;

	private WorkshopAnimatorControls.WorkshopAnimatorControlSettings settings;

	public void Setup(WorkshopAnimatorControls animatorControls, WorkshopAnimatorControls.WorkshopAnimatorControlSettings animatorControlSettings)
	{
		//IL_001a: Unknown result type (might be due to invalid IL or missing references)
		controls = animatorControls;
		settings = animatorControlSettings;
		icon.Icon = settings.icon;
		text.SetToken(settings.Token);
	}

	[UnityEvent]
	public void OnClick()
	{
		if (!((Object)(object)controls == (Object)null))
		{
			switch (settings.controlType)
			{
			case WorkshopAnimatorControls.WorkshopAnimatorControlType.Boolean:
			{
				bool @bool = controls.animator.GetBool(settings.parameterName);
				controls.animator.SetBool(settings.parameterName, !@bool);
				break;
			}
			case WorkshopAnimatorControls.WorkshopAnimatorControlType.Trigger:
				controls.animator.SetTrigger(settings.parameterName);
				break;
			}
		}
	}
}


using System.Collections.Generic;
using UnityEngine;

public class WorkshopItemAnimator : FacepunchBehaviour
{
	public Transform buttonSpawingAnchor;

	public WorkshopAnimatorButton buttonPrefab;

	private List<WorkshopAnimatorButton> buttons = new List<WorkshopAnimatorButton>();

	public void Setup(GameObject prefab)
	{
		ClearButtons();
		if ((Object)(object)prefab == (Object)null)
		{
			return;
		}
		WorkshopAnimatorControls componentInChildren = prefab.GetComponentInChildren<WorkshopAnimatorControls>();
		if ((Object)(object)componentInChildren == (Object)null || componentInChildren.settings == null)
		{
			return;
		}
		foreach (WorkshopAnimatorControls.WorkshopAnimatorControlSettings setting in componentInChildren.settings)
		{
			WorkshopAnimatorButton workshopAnimatorButton = Object.Instantiate<WorkshopAnimatorButton>(buttonPrefab, buttonSpawingAnchor);
			if ((Object)(object)workshopAnimatorButton != (Object)null)
			{
				workshopAnimatorButton.Setup(componentInChildren, setting);
				buttons.Add(workshopAnimatorButton);
			}
		}
	}

	public void ClearButtons()
	{
		foreach (WorkshopAnimatorButton button in buttons)
		{
			if ((Object)(object)button != (Object)null)
			{
				Object.Destroy((Object)(object)((Component)button).gameObject);
			}
		}
		buttons.Clear();
	}
}


using System.Collections;
using System.IO;
using Facepunch.Extend;
using Rust.UI;
using Rust.Workshop;
using Rust.Workshop.Editor;
using TMPro;
using UnityEngine;
using UnityEngine.UI;

public class WorkshopPreviewImageButton : MonoBehaviour
{
	public RawImage TextureImage;

	public RustText FileLabel;

	public GameObject FileSizeWarning;

	[HideInInspector]
	public Publisher publisher;

	protected WorkshopItemEditor Editor => SingletonComponent<WorkshopItemEditor>.Instance;

	public FileInfo file { get; private set; }

	public Texture texture { get; private set; }

	public void SetFile(FileInfo file)
	{
		this.file = file;
		SetTexture((Texture)(object)Editor.SetTexture("CustomIcon", this.file.FullName, isNormalMap: false, skipSettingMaterialTexture: true));
		if ((Object)(object)texture != (Object)null)
		{
			FileSizeWarning.SetActive(texture.width >= 2048 || texture.height >= 2048);
		}
	}

	public void SetTexture(Texture texture)
	{
		this.texture = texture;
		if ((Object)(object)texture == (Object)null)
		{
			((TMP_Text)FileLabel).text = "None";
			TextureImage.texture = null;
			return;
		}
		((TMP_Text)FileLabel).text = StringExtensions.TruncateFilename(((Object)texture).name, 48, (string)null);
		RustText fileLabel = FileLabel;
		((TMP_Text)fileLabel).text = ((TMP_Text)fileLabel).text + $" ({texture.width} x {texture.height})";
		TextureImage.texture = texture;
	}

	[UnityEvent]
	public void OpenFileBrowser()
	{
		((MonoBehaviour)this).StartCoroutine(BrowseForPreview());
	}

	public IEnumerator BrowseForPreview()
	{
		yield return ((MonoBehaviour)this).StartCoroutine(Editor.FileDialog.Open((string)null, ".png|.jpg", "open_file", "", true, false));
		if (Editor.FileDialog.result == null)
		{
			yield break;
		}
		try
		{
			SetFile(new FileInfo(Editor.FileDialog.result));
		}
		catch
		{
			Debug.LogError((object)"Error loading custom preview file from dialog.");
		}
	}

	[UnityEvent]
	public void Clear()
	{
		if ((Object)(object)publisher != (Object)null)
		{
			publisher.RemoveCustomPreview(this);
		}
		Object.Destroy((Object)(object)((Component)this).gameObject);
	}
}


