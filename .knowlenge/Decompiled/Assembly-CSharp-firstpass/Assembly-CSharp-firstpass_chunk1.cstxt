		}
		set
		{
			_maxBlurRadius = value;
		}
	}

	private float VelocityScale
	{
		get
		{
			if (exposureMode == ExposureMode.Constant)
			{
				return 1f / ((float)shutterSpeed * Time.smoothDeltaTime);
			}
			return exposureTimeScale;
