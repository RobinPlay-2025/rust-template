using UnityEngine;

internal class Quads
{
	private static Mesh[] meshes;

	private static int currentQuads;

	private static bool HasMeshes()
	{
		if (meshes == null)
		{
			return false;
		}
		Mesh[] array = meshes;
		foreach (Mesh val in array)
		{
			if ((Object)null == (Object)(object)val)
			{
				return false;
			}
		}
		return true;
	}

	public static void Cleanup()
	{
		if (meshes == null)
		{
			return;
		}
