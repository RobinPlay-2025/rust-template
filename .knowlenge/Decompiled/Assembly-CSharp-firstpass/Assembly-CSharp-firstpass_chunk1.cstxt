					{
						return false;
					}
				}
				else if (comboPart.MouseWheelDown)
				{
					if (current2 == null || ((InputControl<Vector2>)(object)current2.scroll).ReadValue().y >= 0f || NeedsMouseWheel.AnyActive())
					{
						return false;
					}
				}
				else if (comboPart.IsMouseButton)
				{
