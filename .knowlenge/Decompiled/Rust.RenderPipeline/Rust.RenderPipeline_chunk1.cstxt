	{
		return (RenderPipeline)(object)new RustRenderPipeline(defaultRendererData, settings);
	}
}


using System;
using System.Collections.Generic;
using Rust.RenderPipeline.Runtime;
using UnityEngine;
using UnityEngine.Rendering;

[DisallowMultipleComponent]
[RequireComponent(typeof(Camera))]
[ExecuteAlways]
public class RustRenderPipelineCamera : MonoBehaviour
{
	private static List<VolumeStack> cachedVolumeStacks;

	[SerializeField]
	private CameraSettings settings;

	private ProfilingSampler sampler;

	private Dictionary<RustRendererFeature, RustRendererFeatureCameraBase> featureComponents;

	private Dictionary<Type, RustRendererFeatureCameraBase> featureComponentsByType;

	private CameraFeatureContexts featureContexts;

	private Camera camera;

	private VolumeStack volumeStack;

	public CameraSettings Settings => settings ?? (settings = new CameraSettings());

	public ProfilingSampler Sampler
	{
		get
		{
			//IL_0016: Unknown result type (might be due to invalid IL or missing references)
			//IL_001b: Unknown result type (might be due to invalid IL or missing references)
			//IL_001d: Expected O, but got Unknown
			//IL_0022: Expected O, but got Unknown
			ProfilingSampler obj = sampler;
			if (obj == null)
			{
				ProfilingSampler val = new ProfilingSampler(((Object)((Component)this).GetComponent<Camera>()).name);
				ProfilingSampler val2 = val;
				sampler = val;
				obj = val2;
			}
			return obj;
		}
	}

	public Dictionary<RustRendererFeature, RustRendererFeatureCameraBase> FeatureComponents => featureComponents ?? (featureComponents = new Dictionary<RustRendererFeature, RustRendererFeatureCameraBase>());

	public Dictionary<Type, RustRendererFeatureCameraBase> FeatureComponentsByType => featureComponentsByType ?? (featureComponentsByType = new Dictionary<Type, RustRendererFeatureCameraBase>());

	public CameraFeatureContexts FeatureContexts => featureContexts ?? (featureContexts = new CameraFeatureContexts());

	public RustCameraHistory CameraHistory { get; private set; } = new RustCameraHistory();

	public RustRenderPipeline Pipeline { get; set; }

	public bool PipelineCameraInitialized { get; set; }

	public Matrix4x4 PreviousViewProjectionMatrix { get; set; }

	public Camera Camera
	{
		get
		{
			if ((Object)(object)camera == (Object)null)
			{
				((Component)this).gameObject.TryGetComponent<Camera>(ref camera);
			}
			return camera;
		}
	}

	public bool RequiresVolumeFrameworkUpdate
	{
		get
		{
			if (Settings.volumeSettings.updateMode == RustRenderPipelineSettings.VolumeFrameworkUpdateMode.UsePipelineSettings)
			{
				return RustRenderPipelineAsset.Asset.Settings.volumeFrameworkUpdateMode != RustRenderPipelineSettings.VolumeFrameworkUpdateMode.ViaScripting;
			}
			return Settings.volumeSettings.updateMode == RustRenderPipelineSettings.VolumeFrameworkUpdateMode.EveryFrame;
		}
	}

	public VolumeStack VolumeStack
	{
		get
		{
			return volumeStack;
		}
		set
		{
			if (value == null && volumeStack != null)
			{
				if (cachedVolumeStacks == null)
				{
					cachedVolumeStacks = new List<VolumeStack>(4);
				}
				cachedVolumeStacks.Add(volumeStack);
			}
			volumeStack = value;
		}
	}

	internal void GetOrCreateVolumeStack()
	{
		if (cachedVolumeStacks != null && cachedVolumeStacks.Count > 0)
		{
			int index = cachedVolumeStacks.Count - 1;
			volumeStack = cachedVolumeStacks[index];
			cachedVolumeStacks.RemoveAt(index);
		}
		if (volumeStack == null)
		{
			volumeStack = VolumeManager.instance.CreateStack();
		}
	}

	private void OnDestroy()
	{
		ShutdownPipelineCamera();
		CameraHistory?.Dispose();
		CameraHistory = null;
	}

	internal void ShutdownPipelineCamera()
	{
		if (featureComponentsByType != null)
		{
			featureComponentsByType.Clear();
		}
		if (featureComponents != null)
		{
			foreach (KeyValuePair<RustRendererFeature, RustRendererFeatureCameraBase> featureComponent in featureComponents)
			{
				featureComponent.Value.Shutdown();
			}
			featureComponents.Clear();
		}
		if (featureContexts != null)
		{
			featureContexts.Clear();
		}
		if (Pipeline != null)
		{
			Pipeline.UnregisterCamera(((Component)this).gameObject);
			Pipeline = null;
		}
		Camera.DestroyVolumeStack(this);
		PipelineCameraInitialized = false;
	}
}


using System;
using Rust.RenderPipeline.Runtime;
using UnityEngine;

[Serializable]
public class RustRenderPipelineSettings
{
	public enum ColorLutResolution
	{
		_16 = 0x10,
		_32 = 0x20,
		_64 = 0x40
	}

	public enum RenderPath
	{
		ForwardPlus,
		Deferred
	}

	public enum VolumeFrameworkUpdateMode
	{
		[InspectorName("Every Frame")]
		EveryFrame,
		[InspectorName("Via Scripting")]
		ViaScripting,
		[InspectorName("Use Pipeline Settings")]
		UsePipelineSettings
	}

	[Serializable]
	public struct PipelineShaders
	{
		public Shader cameraRendererShader;

		public Shader cameraDebuggerShader;

		public Shader cameraMotionVectorShader;

		public Shader deferredLightingShader;

		public Shader deferredIndirectLightingShader;

		public Shader coreBlit;

		public Shader coreBlitColorAndDepth;

		public Shader postFxStackShader;

		public Shader brpBloomShader;

		public Shader motionBlurShader;

		public ComputeShader exposureHistogramCompute;

		public ComputeShader autoExposureCompute;

		public Shader temporalAntiAliasingShader;

		public Shader blurShader;
	}

	[Serializable]
	public struct PipelineTextures
	{
		public Texture blueNoise;

		public Texture preIntegratedFgdGgx;

		public Texture environmentBrdfLut;
	}

	public static readonly LayerMask VolumeLayerMask = LayerMask.op_Implicit(1024);

	public RenderPath renderPath;

	public CameraBufferSettings cameraBuffer = new CameraBufferSettings
	{
		allowHDR = true,
		renderScale = 1f,
		fxaaSettings = new CameraBufferSettings.FxaaSettings
		{
			fixedThreshold = 0.0833f,
			relativeThreshold = 0.166f,
			subpixelBlending = 0.75f
		},
		motionBlurSettings = new CameraBufferSettings.MotionBlurSettings
		{
			enabled = true,
			shutterAngle = 270f,
			sampleCount = 10
		}
	};

	public VolumeFrameworkUpdateMode volumeFrameworkUpdateMode;

	public bool useSrpBatching = true;

	public ForwardPlusSettings forwardPlus;

	public ShadowSettings shadows;

	public bool postProcessingEnabled = true;

	public ColorLutResolution colorLutResolution = ColorLutResolution._32;

	public PipelineShaders pipelineShaders;

	public PipelineTextures pipelineTextures;

	[Tooltip("Used to enable certain effects such as motion blur. Only read on startup.")]
	public string mainCameraTag = "MainCamera";

	public RustRenderPipelineSettings()
	{
	}

	public RustRenderPipelineSettings(RustRenderPipelineSettings settings)
	{
		renderPath = settings.renderPath;
		cameraBuffer = settings.cameraBuffer;
		volumeFrameworkUpdateMode = settings.volumeFrameworkUpdateMode;
		useSrpBatching = settings.useSrpBatching;
		forwardPlus = settings.forwardPlus;
		shadows = new ShadowSettings(settings.shadows);
		postProcessingEnabled = settings.postProcessingEnabled;
		colorLutResolution = settings.colorLutResolution;
		pipelineShaders = settings.pipelineShaders;
		pipelineTextures = settings.pipelineTextures;
	}
}


