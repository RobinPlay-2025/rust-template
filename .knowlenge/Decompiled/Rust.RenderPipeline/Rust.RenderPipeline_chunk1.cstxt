		playModeInstance = Object.Instantiate<RustRenderPipelineAsset>(originalRrpAsset);
		playModeInstance.settings = new RustRenderPipelineSettings(originalRrpAsset.Settings);
		playModeInstance.assetEditingWarning = playModeInstance.assetEditingWarning ?? "";
		playModeInstance.assetEditingWarning = "This is a cloned asset. Any changes to this will not persist outside of Play Mode! This should be used for debugging purposes only.";
		return playModeInstance;
	}

	protected override void EnsureGlobalSettings()
	{
		((RenderPipelineAsset)this).EnsureGlobalSettings();
	}

