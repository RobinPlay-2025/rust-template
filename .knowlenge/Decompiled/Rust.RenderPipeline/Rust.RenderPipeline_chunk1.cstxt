		{
			return;
		}
		int num = (bitCount + 31) / 32;
		if (num == m_Data?.Length)
		{
			return;
		}
		float[] array = new float[num];
		if (m_Data != null)
		{
			for (int i = 0; i < m_Data.Length; i++)
			{
				array[i] = m_Data[i];
			}
		}
		m_Data = array;
	}

	public void Clear()
	{
		for (int i = 0; i < m_Data.Length; i++)
		{
			m_Data[i] = 0f;
		}
	}

	private void GetElementIndexAndBitOffset(int index, out int elemIndex, out int bitOffset)
	{
		elemIndex = index >> 5;
		bitOffset = index & 0x1F;
	}

	public unsafe override string ToString()
	{
		Debug.Assert(bitCapacity < 4096, "Bit string too long! It was truncated!");
