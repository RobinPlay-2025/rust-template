	[SerializeField]
	private RustRendererData defaultRendererData;

	[SerializeField]
	private RustRenderPipelineSettings settings;

	private static RustRenderPipelineAsset playModeInstance;

	public static RustRenderPipelineAsset Asset => GraphicsSettings.currentRenderPipeline as RustRenderPipelineAsset;

	public override Type pipelineType => typeof(RustRenderPipeline);

	public RustRenderPipelineSettings Settings => settings;

	public override string renderPipelineShaderTag => "RustRenderPipeline";

	public void SetRenderScale(float scale)
	{
		settings.cameraBuffer.renderScale = scale;
	}

	public RustRenderPipelineAsset GetPlayModeInstance(RustRenderPipelineAsset originalRrpAsset)
