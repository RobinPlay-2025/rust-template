using System.Collections.Generic;
using Rust.RenderPipeline.Runtime;
using UnityEngine;
using UnityEngine.Rendering;

[SupportedOnRenderPipeline(typeof(RustRenderPipelineAsset))]
public class RustRenderPipelineGlobalSettings : RenderPipelineGlobalSettings<RustRenderPipelineGlobalSettings, RustRenderPipeline>
{
	public const string defaultAssetName = "RustRenderPipelineGlobalSettings";

	[SerializeField]
	private RenderPipelineGraphicsSettingsContainer m_Settings = new RenderPipelineGraphicsSettingsContainer();

	private static RustRenderPipelineGlobalSettings cachedInstance;

	protected override List<IRenderPipelineGraphicsSettings> settingsList => m_Settings.settingsList;

	public static RustRenderPipelineGlobalSettings Instance
	{
		get
		{
			if ((Object)(object)cachedInstance == (Object)null)
			{
				cachedInstance = GraphicsSettings.GetSettingsForRenderPipeline<RustRenderPipeline>() as RustRenderPipelineGlobalSettings;
			}
			return cachedInstance;
		}
	}

	public static VolumeProfile GetOrCreateDefaultVolumeProfile(VolumeProfile defaultVolumeProfile)
	{
		return defaultVolumeProfile;
	}
}


