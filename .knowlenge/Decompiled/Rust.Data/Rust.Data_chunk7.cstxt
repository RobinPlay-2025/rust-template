			{
				stream.WriteByte(66);
				ProtocolParser.WriteString(stream, instance.nexusZone);
			}
			stream.WriteByte(72);
			ProtocolParser.WriteBool(stream, instance.corpse);
			stream.WriteByte(80);
			ProtocolParser.WriteBool(stream, instance.deepSea);
