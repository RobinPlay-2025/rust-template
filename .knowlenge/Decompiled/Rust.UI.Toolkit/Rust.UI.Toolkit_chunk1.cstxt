public enum RustToastType
{
	Success,
	Danger,
	Warning
}


using System;
using Rust.UI.Toolkit;
using UnityEngine.UIElements;

public static class RustToasts
{
	public static void Show(VisualElement context, string title, string body = null, RustToastType type = RustToastType.Success, Icons icon = Icons.None, float duration = 4f)
	{
		//IL_0043: Unknown result type (might be due to invalid IL or missing references)
		//IL_004d: Expected O, but got Unknown
		//IL_001d: Unknown result type (might be due to invalid IL or missing references)
		//IL_0023: Expected O, but got Unknown
		//IL_00c6: Unknown result type (might be due to invalid IL or missing references)
		//IL_00cc: Expected O, but got Unknown
		//IL_00d8: Unknown result type (might be due to invalid IL or missing references)
		//IL_00df: Expected O, but got Unknown
		//IL_0104: Unknown result type (might be due to invalid IL or missing references)
		//IL_010b: Expected O, but got Unknown
		VisualElement layer = RustOverlay.GetLayer(context);
		VisualElement val = UQueryExtensions.Q(layer, (string)null, "rust-toast-host");
		if (val == null)
		{
			val = new VisualElement();
			val.AddToClassList("rust-toast-host");
			val.pickingMode = (PickingMode)1;
			layer.Add(val);
		}
		val.BringToFront();
		VisualElement toast = new VisualElement();
		toast.AddToClassList("rust-toast");
		switch (type)
		{
		case RustToastType.Danger:
			toast.AddToClassList("rust-toast--danger");
			break;
		case RustToastType.Warning:
			toast.AddToClassList("rust-toast--warning");
			break;
		}
		if (icon == Icons.None)
		{
			icon = type switch
			{
				RustToastType.Danger => Icons.ExclamationCircle, 
				RustToastType.Warning => Icons.ExclamationTriangle, 
				_ => Icons.CheckCircle, 
			};
		}
		toast.Add((VisualElement)(object)new RustIcon(icon));
		VisualElement val2 = new VisualElement();
		val2.AddToClassList("rust-toast__content");
		Label val3 = new Label(title);
		((VisualElement)val3).AddToClassList("rust-toast__title");
		((VisualElement)val3).pickingMode = (PickingMode)1;
		val2.Add((VisualElement)(object)val3);
		if (!string.IsNullOrEmpty(body))
		{
			Label val4 = new Label(body);
			((VisualElement)val4).AddToClassList("rust-toast__body");
			((VisualElement)val4).pickingMode = (PickingMode)1;
			val2.Add((VisualElement)(object)val4);
		}
		toast.Add(val2);
		val.Add(toast);
		((CallbackEventHandler)toast).RegisterCallback<ClickEvent>((EventCallback<ClickEvent>)delegate
		{
			Dismiss();
		}, (TrickleDown)0);
		toast.schedule.Execute((Action)Dismiss).StartingIn((long)(duration * 1000f));
		void Dismiss()
		{
			if (!toast.ClassListContains("is-leaving"))
			{
				toast.AddToClassList("is-leaving");
				toast.schedule.Execute((Action)toast.RemoveFromHierarchy).StartingIn(180L);
			}
		}
	}
}


