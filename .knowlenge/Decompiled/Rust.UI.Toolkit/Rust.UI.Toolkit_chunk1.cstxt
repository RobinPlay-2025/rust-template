		return root;
	}

	public static void SetVisible(VisualElement element, bool visible)
	{
		element.EnableInClassList("rust-hidden", !visible);
	}

	public static bool IsVisible(VisualElement element)
	{
		return !element.ClassListContains("rust-hidden");
	}

	public static string Upper(string text)
	{
		if (!string.IsNullOrEmpty(text))
		{
			return text.ToUpperInvariant();
		}
		return text;
	}

	public static string Upper(Phrase phrase)
	{
		return Upper((phrase != null) ? phrase.translated : null);
	}

	public static string Format(Phrase phrase, params object[] args)
	{
		if (phrase == null)
		{
			return string.Empty;
		}
		try
		{
			return string.Format(phrase.translated, args);
		}
		catch
		{
			try
			{
				return string.Format(phrase.english, args);
			}
			catch
			{
				return phrase.translated;
			}
		}
	}

