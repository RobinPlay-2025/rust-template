using System;
using UnityEngine.UIElements;

public class Popup
{
	internal VisualElement Blocker;

	internal VisualElement Content;

	internal Action OnClose;

	private bool _closed;

	public void Close()
	{
		if (!_closed)
		{
			_closed = true;
			OpenPopups.Remove(this);
			VisualElement blocker = Blocker;
			if (blocker != null)
			{
				blocker.RemoveFromHierarchy();
			}
			VisualElement content = Content;
			if (content != null)
			{
				content.RemoveFromHierarchy();
			}
			OnClose?.Invoke();
		}
	}
}


