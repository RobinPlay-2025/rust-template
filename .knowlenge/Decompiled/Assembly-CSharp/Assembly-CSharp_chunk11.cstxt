	public void Execute()
	{
		int num = fishCount[0];
		for (int num2 = num - 1; num2 >= 0; num2--)
		{
			if (!fishDataArray[num2].isAlive)
			{
				if (num2 < num - 1)
				{
					fishDataArray[num2] = fishDataArray[num - 1];
					fishRenderDataArray[num2] = fishRenderDataArray[num - 1];
				}
				num--;
			}
		}
		fishCount[0] = num;
	}
