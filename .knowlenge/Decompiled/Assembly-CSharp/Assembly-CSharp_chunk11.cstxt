	public static uint GetSocketHash(uint prefabID)
	{
		if (!socketHashes.TryGetValue(prefabID, out var value))
		{
			value = CRC.Compute32(0u, 1);
			Socket_Base[] array = PrefabAttribute.server.FindAll<Socket_Base>(prefabID);
