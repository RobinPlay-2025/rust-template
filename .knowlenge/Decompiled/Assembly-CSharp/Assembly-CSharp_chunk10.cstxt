					val3.username = value.OwnershipShare.Value.username;
					val3.reason = value.OwnershipShare.Value.reason;
					val2.ownership = val3;
				}
				val.buriedItems.Add(val2);
			}
		}
		info.msg.buriedItemStorage = val;
	}

