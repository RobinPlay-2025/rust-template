		VehicleSpawnPoint.AddStartingFlares(((Component)baseEntity).GetComponent<ICanFireHelicopterFlares>());
		if ((Object)(object)newOwner != (Object)null)
		{
			Analytics.Azure.OnVehiclePurchased(newOwner, baseEntity);
		}
		return component;
	}

