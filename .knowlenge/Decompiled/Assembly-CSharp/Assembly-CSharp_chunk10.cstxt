	{
		if (!vehicle.padrepairsrequired)
		{
			return true;
		}
		if (!repairableVehiclePadRef.IsValid(serverside: true))
		{
			return true;
		}
		return repairableVehiclePadRef.Get(serverside: true).IsRepaired;
	}

