		{
			Vector3 val = serverFlockTransforms[i].position - position;
			if (!(((Vector3)(ref val)).sqrMagnitude > radius * radius))
			{
				serverFlocks[i].startlePosition = position;
				num++;
			}
		}
		return num;
	}

