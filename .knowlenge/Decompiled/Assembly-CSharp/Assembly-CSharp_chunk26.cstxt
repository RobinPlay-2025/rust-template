		long num2 = BakeStats.StageCount(BakeStats.Stage.CollectTotal);
		arm.bakeDoorUsPerTile = ((num2 > 0) ? (num * 1000.0 / (double)num2) : 0.0);
		RustNav.bakeStatsEnabled = bakeStatsWereEnabled;
		RustNavDoorGates.ReassertAll();
