			arm.gatherUs = gatherSum / (double)reps;
			arm.writeUs = writeSum / (double)reps;
			arm.reassert = reassertSum / (double)reps;
			arm.register = regSum / (double)reps;
			arm.unregister = unregSum / (double)reps;
			report(arm);
		}
