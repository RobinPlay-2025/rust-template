	private IEnumerator LateFixed()
	{
		WaitForFixedUpdate fixedWait = CoroutineEx.waitForFixedUpdate;
		lateFixedIsRunning = true;
		do
		{
			yield return fixedWait;
			PreCalibrateBones();
			fixedAllow = true;
		}
		while (lateFixedIsRunning);
	}

