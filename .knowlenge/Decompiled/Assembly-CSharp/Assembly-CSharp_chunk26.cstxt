				}
			}
		}
		if ((Object)(object)fSpineAnimator != (Object)null)
		{
			result = ((!((Object)(object)fSpineAnimator.BaseTransform != (Object)null)) ? ((Component)fSpineAnimator).transform : fSpineAnimator.BaseTransform);
