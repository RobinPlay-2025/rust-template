	{
		float num = ((!(a < 2f) || !(b < 2f)) ? Mathf.Min(a, b) : Mathf.Max(a, b));
		return Mathf.Clamp(num, 0f, 2f);
	}

	private bool HasUnlimitedIo(BasePlayer player)
	{
		if (player.IsInCreativeMode)
		{
			return Creative.unlimitedIo;
		}
		return false;
	}

