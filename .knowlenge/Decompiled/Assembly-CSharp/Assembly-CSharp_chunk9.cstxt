	{
		BasePlayer player = msg.player;
		string text = msg.read.String(32, false);
		if (CanPlayerAdmin(player))
		{
			if (Interface.CallHook("OnVendingShopRename", (object)this, (object)text, (object)player) != null)
			{
				return;
			}
			shopName = text;
			nameLastEditedBy = player.userID.Get();
			UpdateMapMarker();
			Analytics.Azure.OnUGCCreated(player, this, "vending_machine_name", text.Length);
