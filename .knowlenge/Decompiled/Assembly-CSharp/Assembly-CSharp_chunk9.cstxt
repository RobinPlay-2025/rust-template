					float num4 = (float)(num % ((List<ISplashable>)(object)val2).Count) / (float)((List<ISplashable>)(object)val2).Count;
					foreach (ISplashable item2 in (List<ISplashable>)(object)val2)
					{
						int amount = num3 + ((Random.value < num4) ? 1 : 0);
						if (!item2.IsUnityNull() && item2.WantsSplash(currentFuelType, amount))
						{
