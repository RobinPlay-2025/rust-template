public enum OrderingRule
{
	TakeoverOrder,
	WhitelistOrder,
	OwnedLast,
	OwnedFirst,
	PriceLowToHigh,
	PriceHighToLow,
	Alphabetical,
	ReverseAlphabetical,
	FeaturedFirst,
	LargestFirst,
	Random,
	FeaturedLast,
	FakeItemsOrder,
	FeaturingOrder
}


public enum RuleMatchMode
{
	All,
	Any
}


public enum FilterRule
{
	TagInclude,
	TagExclude,
	OnlyFeatured,
	ExcludeFeatured,
	NeedTakeOver,
	ItemShortName,
	ExcludeOwned
}


