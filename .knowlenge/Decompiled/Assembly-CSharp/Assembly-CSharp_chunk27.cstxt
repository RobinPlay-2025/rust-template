	}

	[ServerVar(Help = "Sets how many seconds of familiarity the calling player has with every livestock animal in range. 0 resets them all. Usage: livestock.setfamiliarityall <seconds> [radius], radius in metres (default 30)")]
	public static void setfamiliarityall(Arg args)
	{
		//IL_0082: Unknown result type (might be due to invalid IL or missing references)
		//IL_008d: Unknown result type (might be due to invalid IL or missing references)
		BasePlayer basePlayer = args.Player();
		if ((Object)(object)basePlayer == (Object)null)
		{
			args.ReplyWith("This command has to be run by a player.");
			return;
		}
		float @float = args.GetFloat(0, -1f);
		float float2 = args.GetFloat(1, 30f);
		if (@float < 0f)
		{
			args.ReplyWith("Provide a number of seconds, eg: livestock.setfamiliarityall 0");
			return;
		}
		int num = 0;
		LivestockAnimal[] array = BaseEntity.Util.FindAll<LivestockAnimal>();
		foreach (LivestockAnimal livestockAnimal in array)
		{
			if (!((Object)(object)livestockAnimal == (Object)null) && !livestockAnimal.IsDestroyed && !livestockAnimal.IsDead() && !(Vector3.Distance(((Component)livestockAnimal).transform.position, ((Component)basePlayer).transform.position) > float2))
			{
				livestockAnimal.SetFamiliarity(basePlayer.userID, @float, LivestockAnimal.FamiliarityReason.Debug);
				num++;
			}
		}
		args.ReplyWith($"{num} livestock animal(s) within {float2}m now have {@float:0}s of familiarity with you ({LivestockAnimal.TrustTierName(@float)}).");
	}

