				item2.Remove();
			}
			else if (!toggleAttachmentLightAtNight)
			{
				weapon.SetLightsOn(isOn: true);
			}
		}
		weapon.EnableSaving(base.baseEntity.enableSaving);
		foreach (BaseEntity child in weapon.children)
