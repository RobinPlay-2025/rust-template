						flag = true;
						break;
					}
				}
				if (flag)
				{
					if (destroy)
					{
						((FacepunchBehaviour)baseEntity).Invoke((Action)baseEntity.KillMessage, (float)num * 0.2f);
					}
					num++;
				}
			}
			return num;
		}
		finally
		{
			((IDisposable)enumerator/*cast due to .constrained prefix*/).Dispose();
		}
	}

	private static void ParseUserIds(Arg arg, List<ulong> ids)
