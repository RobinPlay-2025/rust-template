	[ServerVar(Help = "Sends the nearest male livestock animal to mate with the nearest valid female, skipping the mate search. Optional search radius in metres (default 20).")]
	public static void forcebreed(Arg args)
	{
		BasePlayer basePlayer = args.Player();
		if ((Object)(object)basePlayer == (Object)null)
		{
			args.ReplyWith("This command has to be run by a player.");
			return;
		}
		float @float = args.GetFloat(0, 20f);
		float closestDistance;
		LivestockAnimal male = GetClosestLivestockAnimal(@float, basePlayer, out closestDistance, (LivestockAnimal a) => a.IsAdult() && a.IsMale);
		if ((Object)(object)male == (Object)null)
		{
			args.ReplyWith($"No adult male livestock animal found within {@float}m.");
			return;
		}
		LivestockAnimalFSM livestockAnimalFSM = default(LivestockAnimalFSM);
		if (!((Component)male).TryGetComponent<LivestockAnimalFSM>(ref livestockAnimalFSM))
		{
			args.ReplyWith($"{male.Categorize()} at {closestDistance:0.0}m has no LivestockAnimalFSM.");
			return;
		}
		float closestDistance2;
		LivestockAnimal closestLivestockAnimal = GetClosestLivestockAnimal(@float, basePlayer, out closestDistance2, (LivestockAnimal a) => (Object)(object)a != (Object)(object)male && a.IsSameSpeciesAs(male) && a.CanBePregnant());
		if ((Object)(object)closestLivestockAnimal == (Object)null)
		{
			args.ReplyWith($"No {male.Categorize()} that can be made pregnant found within {@float}m.");
			return;
		}
		livestockAnimalFSM.MateTarget.Set(closestLivestockAnimal);
		livestockAnimalFSM.SetState(livestockAnimalFSM.seekMate);
		args.ReplyWith($"{male.Categorize()} at {closestDistance:0.0}m is now approaching the {closestLivestockAnimal.Categorize()} at {closestDistance2:0.0}m.");
	}

