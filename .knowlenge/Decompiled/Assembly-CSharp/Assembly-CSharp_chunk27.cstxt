		{
			Color color = RoomColor(item);
			stringBuilder.AppendLine(string.Format("room {0}: {1} faces{2}{3}", item.DebugId, item.Faces.Count, item.IsOutside ? " (OUTSIDE, drawn dim white)" : "", (item.EffectivelyOutside && !item.IsOutside) ? " (effectively outside)" : ""));
			Enumerator<BlockFace> enumerator2 = item.Faces.GetEnumerator();
