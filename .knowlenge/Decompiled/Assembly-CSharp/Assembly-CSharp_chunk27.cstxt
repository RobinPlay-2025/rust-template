	private void NameForOwner(ulong ownerId, string familyLocale)
	{
		string locale = (LivestockNames.IsDrawable(familyLocale) ? familyLocale : LocaleFor(ownerId));
		if (base.Rng.Value < Livestock.devNameChance && LivestockNames.HasPack("devs"))
		{
			locale = "devs";
		}
		GiveName(RollAnimalName(base.Rng, IsMale, locale), FarmableAnimal.NameSource.Game, 0uL);
		FoundLine(locale);
	}

