			where x.enabled
			select x).Count();
		int num2 = (from x in Object.FindObjectsByType<Collider>((FindObjectsSortMode)0)
			where !x.enabled
			select x).Count();
		string text = num + " colliders enabled, " + num2 + " disabled";
		args.ReplyWith(text);
	}

