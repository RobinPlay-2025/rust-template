	public bool SetOwner(ulong userId, OwnerChangeReason reason, string familyLocale = null)
	{
		if (userId == 0L || userId == base.OwnerID)
		{
			return false;
		}
		base.OwnerID = userId;
		if (string.IsNullOrEmpty(AnimalName))
		{
			NameForOwner(userId, familyLocale);
		}
		StartAgeTimerIfIdle();
		RefreshProduction();
		if (reason != OwnerChangeReason.Debug)
		{
			Analytics.Azure.OnLivestockAcquired(userId, this, reason);
		}
		return true;
	}

