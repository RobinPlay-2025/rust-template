		stringBuilder.AppendLine($"Entrance Portal Transform: {portalEntranceTransform}, {((portalEntranceTransform2 != null) ? portalEntranceTransform2.position : Vector3.zero)}");
		stringBuilder.AppendLine("Entrance Portal Bounds: pos:" + ((object)(Vector3)(ref DeepSeaManager.PortalEntranceBounds.position)/*cast due to .constrained prefix*/).ToString() + ", extents:" + ((object)(Vector3)(ref DeepSeaManager.PortalEntranceBounds.extents)/*cast due to .constrained prefix*/).ToString());
