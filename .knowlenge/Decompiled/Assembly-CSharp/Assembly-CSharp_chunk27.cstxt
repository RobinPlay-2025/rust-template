		val.AddColumns(new string[5] { "Room", "Outside", "Faces", "Group", "Eff. outside" });
		HashSet<Room> hashSet = new HashSet<Room>();
		CollectBuildingRooms(block, hashSet);
		foreach (Room item in hashSet)
		{
			val.AddRow(new string[5]
