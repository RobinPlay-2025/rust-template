			if (result.Rooms + result.Boundaries + result.Portals < maxDraws && !(((Bounds)(ref room.Bounds)).SqrDistance(position) > num))
			{
				Group group = RoomNetworkGroups.Resolve(room.NetworkGroupIndex);
				Color color = NetworkGroupColor(player, group);
				string text = $"R{room.DebugId} RG{room.VisibilityGroup}\nNG {NetworkGroupLabel(room.NetworkGroupIndex, group, player)}";
				UnityEngine.DDraw.Bounds(player, room.Bounds, color, duration);
				UnityEngine.DDraw.Text(player, ((Bounds)(ref room.Bounds)).center, text, color, duration, distanceFade: true, zTest: true, 1.5f);
				result.Rooms++;
			}
		}
		HashSet<BuildingBlock> hashSet2 = new HashSet<BuildingBlock>();
		foreach (Room item2 in hashSet)
		{
			Enumerator<BlockFace> enumerator3 = item2.Faces.GetEnumerator();
			try
			{
				while (enumerator3.MoveNext())
				{
					if (enumerator3.Current.Entity is BuildingBlock item)
