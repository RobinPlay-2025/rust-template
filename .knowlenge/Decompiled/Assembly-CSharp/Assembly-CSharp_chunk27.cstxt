				Vector3 val = item.FaceA.WorldCenter + item.FaceA.WorldNormal * 0.2f;
				Vector3 val2 = item.FaceB.WorldCenter + item.FaceB.WorldNormal * 0.2f;
				Vector3 pos = (val + val2) * 0.5f;
