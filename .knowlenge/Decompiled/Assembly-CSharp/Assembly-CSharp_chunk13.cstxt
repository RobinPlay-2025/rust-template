	public int BodyStamp;

	public int Version;

	public int Regrouped;

	public Vector3 Position;

	public float Margin;

	public float OldestLinger;

	public float Linger;

	public float NearbyRange;

	void IPooled.EnterPool()
	{
		Visible.Clear();
		Body = null;
	}

	void IPooled.LeavePool()
	{
	}
}


