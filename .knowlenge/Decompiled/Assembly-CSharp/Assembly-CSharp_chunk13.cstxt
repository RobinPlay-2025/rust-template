	public override void ServerInit()
	{
		base.ServerInit();
		if (!Application.isLoadingSave)
		{
			using FlagsUpdateScope flagsUpdateScope = StartSetFlags(FlagsUpdateMode.SendNetworkUpdate);
			flagsUpdateScope.Set(Flags.OnFire, b: true);
		}
