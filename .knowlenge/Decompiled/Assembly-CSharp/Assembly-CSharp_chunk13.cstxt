		val.weapon = (((Object)(object)weapon != (Object)null) ? ((Object)weapon).name : "N/A");
		val.ammo = ((!((Object)(object)projectilePrefab != (Object)null)) ? "N/A" : ((projectilePrefab != null) ? ((Object)projectilePrefab).name : null));
