		if (RoomNetworkGroups.IsRoomGroup(entity.net.group))
		{
			grouped.TryAdd(entity);
			return true;
		}
		if (!grouped.Contains(entity))
		{
			return true;
		}
		grouped.Remove(entity);
		return false;
	}

