	public AnimationCurve BladeSpinUpCurve;

	public AnimationCurve BladeWindDownCurve;

	public AnimationCurve WaterBlendOverTimeCurve;

	[Header("Pressure Gauges")]
	public List<ClientPressureGauge> pressureGauges;

