		Vector3 val = position - inputs.Position;
		if (((Vector3)(ref val)).sqrMagnitude >= inputs.Margin * inputs.Margin)
		{
			return false;
		}
		return !RoomNetworkGroups.RegroupedNear(position, inputs.NearbyRange + inputs.Margin, inputs.Regrouped);
	}

