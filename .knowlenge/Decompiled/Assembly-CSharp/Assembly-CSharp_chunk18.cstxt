	public static bool IsInsideTerrain(BasePlayer ply)
	{
		//IL_0018: Unknown result type (might be due to invalid IL or missing references)
		if (ply.IsInTutorial || DeepSeaManager.IsInsideDeepSea((BaseNetworkable)ply))
