					try
					{
						basePlayer = SpawnPlayerSleeping(packet.connection);
					}
					finally
					{
						((IDisposable)val4)?.Dispose();
					}
					if ((Object)(object)basePlayer == (Object)null)
					{
						val4 = TimeWarning.New("SpawnNewPlayer", 0);
