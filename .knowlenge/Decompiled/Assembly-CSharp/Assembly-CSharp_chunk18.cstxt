		if (RealTimeSince.op_Implicit(_lastPlayerManifestBroadcast) >= Nexus.playerManifestInterval)
		{
			_lastPlayerManifestBroadcast = RealTimeSince.op_Implicit(0f);
			BroadcastPlayerManifest();
