	public static void DaylightHours(int count, float[] hours)
	{
		SunriseAndSunset(TOD_Sky.Instance, 1f, out var sunrise, out var sunset);
		float num = sunrise + 0.5f;
		float num2 = sunset - 0.5f - num;
