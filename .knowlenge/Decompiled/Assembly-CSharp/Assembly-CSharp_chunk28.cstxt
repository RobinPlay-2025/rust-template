				}
				return speeds[currentSpeedIndex];
			}
		}

		public override EFSMStateStatus OnStateEnter(FSMPayload payload)
		{
			if (TargetPoints == null || TargetPoints.Length == 0)
			{
				if (AI.logIssues)
				{
