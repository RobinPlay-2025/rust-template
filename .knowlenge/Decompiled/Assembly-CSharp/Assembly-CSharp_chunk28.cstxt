	protected override FSMStateBase RedirectStateChange(FSMStateBase newState)
	{
		if (base.CurrentState == null)
		{
			return newState;
		}
		if (!(base.baseEntity is LivestockAnimal livestockAnimal))
		{
			return newState;
		}
		if (!livestockAnimal.IsOffItsFeet())
		{
			return RedirectHeadDown(livestockAnimal, newState);
		}
		if (base.CurrentState == getUp)
		{
			return newState;
		}
		if (newState == getUp || newState == dead || newState == rest || newState == starved || newState == newborn || newState == pregnant)
		{
			return newState;
		}
		if (livestockAnimal.IsSettlingDown() && (newState == hurt || newState == turnAndRun))
		{
			return newState;
		}
		StartledOutOfSleep = livestockAnimal.IsSleeping();
		return getUp;
	}

	private FSMStateBase RedirectHeadDown(LivestockAnimal animal, FSMStateBase newState)
	{
		if (!animal.IsHeadDown() || base.CurrentState == raiseHead)
		{
			return newState;
		}
		if (newState == raiseHead || newState == dead || newState == hurt || newState == turnAndRun || newState == mountVehicle)
		{
			return newState;
		}
		return raiseHead;
	}

	protected override void OnTicked(float deltaTime)
	{
		using (LivestockProfiler.Sample(LivestockProfiler.Section.Fsm))
		{
			base.OnTicked(deltaTime);
			if (base.baseEntity is LivestockAnimal livestockAnimal)
			{
				livestockAnimal.TickDayBudget(CurrentDayActivity, deltaTime);
			}
		}
	}

	public override bool OnDied(HitInfo hitInfo)
	{
		//IL_000c: Unknown result type (might be due to invalid IL or missing references)
		LivestockCensus.RecordDeath(hitInfo, ((Component)base.baseEntity).transform.position);
		if (base.baseEntity is LivestockAnimal livestockAnimal)
		{
			livestockAnimal.LeaveFloor();
		}
		return base.OnDied(hitInfo);
	}

	public void OnPetted()
	{
		if (petted.HasAnimation && PettedTrans != null && (!(base.baseEntity is LivestockAnimal livestockAnimal) || (!livestockAnimal.IsLyingDown() && !livestockAnimal.IsGrazing() && !livestockAnimal.IsDrinking())))
		{
			PettedTrans.Trigger();
			ForceTickOnTheNextUpdate();
		}
	}

	public override void Hurt(HitInfo hitInfo)
	{
		if (base.CurrentState == dead)
		{
			return;
		}
		if ((Object)(object)hurt.WeakHitAdditive != (Object)null)
		{
			((Component)this).GetComponent<RootMotionPlayer>().PlayServerAdditive(hurt.WeakHitAdditive);
		}
		if (patrol.Enabled || base.CurrentState == hurt || base.CurrentState == turnAndRun || base.CurrentState == getUp)
		{
			return;
		}
		if (base.baseEntity is LivestockAnimal livestockAnimal && livestockAnimal.IsOffItsFeet() && !livestockAnimal.IsSettlingDown())
		{
			ForceTickOnTheNextUpdate();
		}
		else if (!base.baseEntity.InSafeZone())
		{
			if (hurt.HasStaggerAnimation && hurt.ShouldStagger(hitInfo))
			{
				HurtTrans.Trigger(hitInfo);
				ForceTickOnTheNextUpdate();
			}
			else if (turnAndRun.ShouldBridgeToFlee(hitInfo) && wouldRunFromAHitTransition.Evaluate())
			{
				TurnAndRunTrans.Trigger(hitInfo);
				ForceTickOnTheNextUpdate();
			}
		}
	}

	private static bool MoveWithRampedSpeed(RustNavMeshAgent agent, Vector3 destinationWS, float fullSpeedDistance, RustNavMeshAgent.Speeds minSpeed, RustNavMeshAgent.Speeds maxSpeed)
	{
		//IL_0001: Unknown result type (might be due to invalid IL or missing references)
		//IL_0043: Unknown result type (might be due to invalid IL or missing references)
		if (!agent.SetDestinationWithParams(destinationWS, autoBraking: true, null, null, null, null, null, null))
		{
			return false;
		}
		RampSpeed(agent, destinationWS, fullSpeedDistance, minSpeed, maxSpeed);
		return true;
	}

	private static void RampSpeed(RustNavMeshAgent agent, Vector3 destinationWS, float fullSpeedDistance, RustNavMeshAgent.Speeds minSpeed, RustNavMeshAgent.Speeds maxSpeed)
	{
		//IL_000c: Unknown result type (might be due to invalid IL or missing references)
		//IL_0011: Unknown result type (might be due to invalid IL or missing references)
		float ratio = Mathf.InverseLerp(0f, fullSpeedDistance, Vector3.Distance(((Component)agent).transform.position, destinationWS));
		agent.SetSpeedRatio(ratio, minSpeed, maxSpeed);
	}

	private static bool StepClearToLieDown(RustNavMeshAgent agent, LivestockAnimal animal)
	{
		//IL_0014: Unknown result type (might be due to invalid IL or missing references)
		if ((Object)(object)animal != (Object)null && animal.TryFindLyingSpotNearby(out var spot))
		{
			return agent.SetDestinationWithParams(spot, autoBraking: true, RustNavMeshAgent.Speeds.Walk, null, null, null, null, null);
		}
		return false;
	}
}


private struct WalkFirst
{
	private bool walking;

	private TimeUntil deadline;

	public bool IsWalking => walking;

	public bool Start(bool started, float timeout)
	{
		//IL_0009: Unknown result type (might be due to invalid IL or missing references)
		//IL_000e: Unknown result type (might be due to invalid IL or missing references)
		walking = started;
		deadline = TimeUntil.op_Implicit(timeout);
		return walking;
	}

	public bool StillWalking(RustNavMeshAgent agent)
	{
		//IL_0011: Unknown result type (might be due to invalid IL or missing references)
