		{
			return (Object)(object)livestockAnimal == (Object)(object)self;
		}
		return true;
	}

	private static bool SharesGround(LivestockFloor floor, LivestockAnimal candidate)
	{
		if (floor != null)
		{
			if (!floor.IsField)
			{
				return candidate.Floor == floor;
			}
			return !candidate.StandsInAPen;
		}
		return true;
	}
