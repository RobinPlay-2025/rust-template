		{
			((JobHandle)(ref rays.Job)).Complete();
			rays.Land();
			GrassArea = Mathf.Min(rays.GrassArea, Area);
			sunPointCount = rays.SunPointCount;
			shadedCount = rays.GatherShade(shadedPoints);
			EncloseShadedPoints();
			CountLitSunPoints();
			Classified = true;
			Pool.Free<RayBatch>(ref rays);
		}
	}

