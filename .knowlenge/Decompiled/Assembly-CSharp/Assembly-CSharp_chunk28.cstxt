		ulong userId;
		float num = BestFamiliarity(out userId);
		string text = (ActsCurious ? " curious" : string.Empty);
		if (userId != 0L)
		{
			return $"fam {num:0}s {TrustTierName(num)}{text}";
		}
		return "fam none stranger" + text;
	}

