		{
			partner.StartBreedingCooldown();
		}
		return true;
	}

	public bool ForceGiveBirth()
	{
		if (IsDead() || !IsPregnant())
		{
			return false;
		}
		pregnancyTimer.Stop();
		return GiveBirth();
	}

