		return sleepyMinimumTimeStanding;
	}

	public bool RollBedtimeRest(out float duration)
	{
		duration = base.Rng.Range(aroundBedtimeDuration.x, aroundBedtimeDuration.y);
		return base.Rng.Value <= aroundBedtimeChance;
	}
}


