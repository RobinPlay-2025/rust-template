		}
		for (int i = 0; i < refCount; i++)
		{
			if (refs[i] != fresh.refs[i])
			{
				return false;
			}
		}
		if (fresh.tileCount > 0)
		{
			Array.Copy(fresh.tiles, tiles, fresh.tileCount);
		}
		tileCount = fresh.tileCount;
		stamp = fresh.stamp;
		seenVersion = fresh.seenVersion;
		Area = fresh.Area;
		centre = fresh.centre;
		radius = fresh.radius;
		stale = false;
		supplyDirty = true;
		Pool.Free<LivestockFloor>(ref fresh);
		return true;
	}

