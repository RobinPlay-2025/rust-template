		animals.AddRange(members);
		foreach (HitchTrough trough in troughs)
		{
			if (IsIntact(trough))
			{
				deployables.Add(trough);
			}
		}
		foreach (LiquidContainer container in containers)
		{
			if (IsIntact(container))
			{
				deployables.Add(container);
			}
		}
	}

