			{
				return EFSMStateStatus.Failure;
			}
			if (livestockAnimal.IsCarrying)
			{
				return EFSMStateStatus.None;
			}
			if (stepClear.StillWalking(base.Agent))
			{
				return EFSMStateStatus.None;
			}
