			}
			if (!base.Agent.SamplePosition(val.position, out var hitWS, 10f))
			{
				return false;
			}
			return base.Agent.SetDestinationWithParams(((NavMeshHit)(ref hitWS)).position, autoBraking: true, CurrentSpeed, null, null, null, null, null);
		}
	}

