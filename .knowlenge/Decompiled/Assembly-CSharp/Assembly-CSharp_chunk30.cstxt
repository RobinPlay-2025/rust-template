			((Utf16ValueStringBuilder)(ref sb)).Append(stats.pendingTiles);
			((Utf16ValueStringBuilder)(ref sb)).Append(" pending tiles) in ");
			((Utf16ValueStringBuilder)(ref sb)).Append(total, "F1");
			((Utf16ValueStringBuilder)(ref sb)).Append(" ms, ");
