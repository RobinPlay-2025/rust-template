				}
			}
			val.SetActive(false);
		}
	}

	public static bool ArePlayersInsideSameHostileRoom(BasePlayer attacker, BasePlayer victim)
	{
		if ((Object)(object)attacker == (Object)null || (Object)(object)victim == (Object)null)
		{
