	{
		ThreadProfiles = threadProfiles;
		MemoryState = memState;
	}
}


using System;

public struct ScopeRecorder : IDisposable
{
	private RecorderHandle handle;

	private string name;

	public ScopeRecorder(RecorderHandle handle, string name)
	{
		this.handle = handle;
		this.name = name;
	}

	public void Dispose()
	{
		EndRecording(handle);
		if (handle.IsValid)
		{
			ExportRecording(handle, name);
		}
		handle = default(RecorderHandle);
	}

	public void Pause()
	{
		PauseRecording(handle);
	}

	public void Resume()
	{
		ResumeRecording(handle);
	}
}


using System;

public struct SlowScopeRecorder : IDisposable
{
	private RecorderHandle handle;

	private DateTime timeLimit;

	private string name;

	public SlowScopeRecorder(RecorderHandle handle, string name, TimeSpan slowLimit)
	{
		this.handle = handle;
		timeLimit = DateTime.Now + slowLimit;
		this.name = name;
	}

	void IDisposable.Dispose()
	{
		EndRecording(handle);
		if (handle.IsValid && DateTime.Now > timeLimit)
		{
			ExportRecording(handle, name);
		}
		else
		{
			ReleaseState(handle);
		}
		handle = default(RecorderHandle);
	}

	public void Pause()
	{
		PauseRecording(handle);
	}

	public void Resume()
	{
		ResumeRecording(handle);
	}
}


private struct RecordTaskState
{
	public RecorderHandle handle;

	public string name;
}


using System;
using System.Collections.Generic;
using ConVar;
using Oxide.Core;
using Rust.Ai;
using UnityEngine;

public class AIBrainSenses
{
	[ServerVar(Help = "(Generated) Interval in seconds between full AI brain senses update ticks; controls how frequently NPCs refresh their awareness of surroundings")]
	public static float UpdateInterval = 0.5f;

	[ServerVar(Help = "(Generated) Interval in seconds between line-of-sight update ticks for human-type NPCs tracking known player positions")]
	public static float HumanKnownPlayersLOSUpdateInterval = 0.2f;

	[ServerVar(Help = "(Generated) Interval in seconds between line-of-sight update ticks for all NPC types tracking known player positions")]
	public static float KnownPlayersLOSUpdateInterval = 0.5f;

