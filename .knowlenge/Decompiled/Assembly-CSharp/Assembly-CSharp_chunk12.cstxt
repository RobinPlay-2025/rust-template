	public void RPC_UpdatePhoneName(BaseEntity.RPCMessage msg)
	{
		if (!((Object)(object)msg.player != (Object)(object)currentPlayer))
		{
			string newName = msg.read.String(256, false);
			UpdatePhoneName(newName);
		}
