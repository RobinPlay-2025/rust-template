	public void Checkout()
	{
		ClearRoom();
		CancelDelayedUpdate();
		SetEntityFurniture(state: false);
		SetFlagLocal(Flag_IsRented, b: false);
		if ((Object)(object)FrontDoor != (Object)null)
		{
			FrontDoor.SetOpen(open: false);
		}
