					Item item = ItemManager.Create(containedItem.itemDef, (int)containedItem.amount, 0uL, isServerSide: true, 0uL);
					resourceDispenser.OverrideOwnership(item, null);
					if (!item.MoveToContainer(itemContainer))
					{
						item.Drop(fallbackWorldPos, Vector3.zero, Quaternion.identity);
					}
				}
			}
		}
		Kill();
	}

	public override bool ShouldInheritNetworkGroup()
	{
		return false;
	}
}


