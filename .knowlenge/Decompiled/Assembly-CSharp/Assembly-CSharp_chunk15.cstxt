using System;

[Flags]
public enum HitArea
{
	Head = 1,
	Chest = 2,
	Stomach = 4,
	Arm = 8,
	Hand = 0x10,
	Leg = 0x20,
	Foot = 0x40
}


public static class HitAreaConst
{
	public const HitArea Nothing = (HitArea)0;

	public const HitArea Everything = (HitArea)(-1);
}


public static class HitAreaUtil
{
	public static string Format(HitArea area)
	{
		return area switch
		{
			(HitArea)0 => "None", 
			(HitArea)(-1) => "Generic", 
			_ => area.ToString(), 
		};
	}
}


