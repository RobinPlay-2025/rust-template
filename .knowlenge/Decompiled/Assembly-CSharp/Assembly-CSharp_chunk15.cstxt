		//IL_0043: Unknown result type (might be due to invalid IL or missing references)
		float num = default(float);
		float num2 = default(float);
		buildingBlockGrid.GetCellMin(cellX, cellZ, ref num, ref num2);
		int cellSize = buildingBlockGrid.CellSize;
		Bounds result = default(Bounds);
		((Bounds)(ref result)).SetMinMax(new Vector3(num, bottom, num2), new Vector3(num + (float)cellSize, top, num2 + (float)cellSize));
