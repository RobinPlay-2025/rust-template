		if (component.Population != population)
		{
			component.Population = population;
		}
		((Component)baseEntity).gameObject.AwakeFromInstantiate();
		baseEntity.Spawn();
		spawned = ((Component)baseEntity).gameObject;
		return SpawnPopulationBase.Status.Success;
	}

