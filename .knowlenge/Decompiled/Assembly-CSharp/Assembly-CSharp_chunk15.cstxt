	public WeatherPreset ForcedWeather { get; set; }

	public WeatherPreset CurrentWeather
	{
		get
		{
			if (!((Object)(object)ForcedWeather != (Object)null))
			{
				if (!(WeatherStateBlend < 0.5f))
				{
					return WeatherStateTarget;
				}
				return WeatherStatePrevious;
			}
			return ForcedWeather;
		}
	}

	public bool TryGetWeatherForecast(out WeatherPresetType forecastType, out int chance, out float hoursUntil)
	{
		forecastType = WeatherPresetType.Clear;
		chance = 0;
		hoursUntil = 0f;
		if ((Object)(object)CurrentWeather == (Object)null || !TryGetFirstUpcomingWeather(out var seed, out var hoursUntil2))
		{
			return false;
		}
		uint seed2 = GetForecastSeed(GetSeedFromLong(seed));
		if (!((!TryGetNextWeatherChange(out var nextWeather, out hoursUntil)) ? TryMakeUpChange(ref seed2, hoursUntil2, out forecastType, out chance, out hoursUntil) : TryForecastChange(ref seed2, nextWeather.Type, out forecastType, out chance)))
		{
			return false;
		}
		int num = SeedRandom.Range(ref seed2, 0, 3) * SeedRandom.Sign(ref seed2);
		hoursUntil = Mathf.Max(0f, hoursUntil + (float)num);
		return true;
	}

	private bool TryGetFirstUpcomingWeather(out long seed, out float hoursUntil)
	{
		seed = 0L;
		hoursUntil = 0f;
		TOD_Sky instance = TOD_Sky.Instance;
		if (!Object.op_Implicit((Object)(object)instance))
		{
			return false;
		}
		long num = 648000000000L;
		long num2 = instance.Cycle.Ticks / num + World.Seed;
		float num3 = (float)(instance.Cycle.Ticks % num) / 3.6E+10f;
		int num4 = ((num3 < 3f) ? 1 : 2);
		seed = num2 + num4;
		hoursUntil = (float)((num4 - 1) * 18) + 3f - num3;
		return true;
	}

	private bool TryGetNextWeatherChange(out WeatherPreset nextWeather, out float hoursUntil)
	{
		nextWeather = null;
		hoursUntil = 0f;
		if ((Object)(object)ForcedWeather != (Object)null)
		{
			return false;
		}
		WeatherPreset currentWeather = CurrentWeather;
		if ((Object)(object)currentWeather == (Object)null || !TryGetFirstUpcomingWeather(out var seed, out var hoursUntil2))
		{
			return false;
		}
		for (int i = 0; i < 8; i++)
		{
			WeatherPreset weatherPreset = GetWeatherPreset(GetSeedFromLong(seed + i));
			if (weatherPreset.Type != currentWeather.Type)
			{
				nextWeather = weatherPreset;
				hoursUntil = hoursUntil2 + (float)(i * 18);
				return true;
			}
		}
		return false;
	}

	private bool TryForecastChange(ref uint seed, WeatherPresetType nextType, out WeatherPresetType forecastType, out int chance)
	{
		forecastType = WeatherPresetType.Clear;
		chance = 0;
		if (SeedRandom.Value(ref seed) < GetMissedChangeChance())
		{
			return false;
		}
		chance = forecastChances[SeedRandom.Range(ref seed, 0, forecastChances.Length)];
		if (SeedRandom.Range(ref seed, 0, 100) < chance)
		{
			forecastType = nextType;
			return true;
		}
		return TryPickWrongForecastType(ref seed, nextType, out forecastType);
	}

	private bool TryMakeUpChange(ref uint seed, float firstHoursUntil, out WeatherPresetType forecastType, out int chance, out float hoursUntil)
	{
		forecastType = WeatherPresetType.Clear;
		chance = 0;
		hoursUntil = 0f;
		if (SeedRandom.Value(ref seed) >= 0.1f)
		{
			return false;
		}
		chance = forecastChances[0];
		hoursUntil = firstHoursUntil + (float)(SeedRandom.Range(ref seed, 0, 8) * 18);
		return TryPickWrongForecastType(ref seed, CurrentWeather.Type, out forecastType);
	}

	private float GetMissedChangeChance()
	{
		float chanceWeatherLasts = GetChanceWeatherLasts(CurrentWeather.Type);
		if (chanceWeatherLasts >= 1f)
		{
			return 0f;
		}
		return Mathf.Clamp01(chanceWeatherLasts * 0.9f * 0.1f / 0.9f / (1f - chanceWeatherLasts));
	}

	private float GetChanceWeatherLasts(WeatherPresetType currentType)
	{
		float num = 0f;
		WeatherPresetType[] array = weatherTypes;
		foreach (WeatherPresetType type in array)
		{
			num += GetWeatherChance(type);
		}
		if (!(num > 0f))
		{
			return 1f;
		}
		return Mathf.Pow(GetWeatherChance(currentType) / num, 8f);
	}

	private bool TryPickWrongForecastType(ref uint seed, WeatherPresetType comingType, out WeatherPresetType wrongType)
	{
		wrongType = WeatherPresetType.Clear;
		float num = 0f;
		WeatherPresetType[] array = weatherTypes;
		foreach (WeatherPresetType type in array)
		{
			num += GetWrongForecastWeight(type, comingType);
		}
		if (num <= 0f)
		{
			return false;
		}
		float num2 = SeedRandom.Range(ref seed, 0f, num);
		array = weatherTypes;
		foreach (WeatherPresetType weatherPresetType in array)
		{
			float wrongForecastWeight = GetWrongForecastWeight(weatherPresetType, comingType);
			if (!(wrongForecastWeight <= 0f))
			{
				wrongType = weatherPresetType;
				num2 -= wrongForecastWeight;
				if (num2 < 0f)
				{
					break;
				}
			}
		}
		return true;
	}

	private float GetWrongForecastWeight(WeatherPresetType type, WeatherPresetType comingType)
	{
		if (type != comingType && type != CurrentWeather.Type)
		{
			return GetWeatherChance(type);
		}
		return 0f;
	}

	private float GetWeatherChance(WeatherPresetType type)
	{
		if (IsInRainGracePeriod())
		{
			return (type == WeatherPresetType.Clear) ? 1 : 0;
		}
		return type switch
		{
			WeatherPresetType.Clear => Weather.ClearChance, 
			WeatherPresetType.Dust => Weather.DustChance, 
			WeatherPresetType.Fog => Weather.FogChance, 
			WeatherPresetType.Overcast => Weather.OvercastChance, 
			WeatherPresetType.Storm => Weather.StormChance, 
			WeatherPresetType.Rain => Weather.RainChance, 
			_ => 0f, 
		};
	}

	private static uint GetForecastSeed(uint weatherSeed)
	{
		uint result = weatherSeed ^ 0x9E3779B9u;
		SeedRandom.Wanghash(ref result);
		return result;
	}

	protected override void Awake()
	{
		((SingletonComponent)this).Awake();
		WeatherState = ScriptableObject.CreateInstance(typeof(WeatherPreset)) as WeatherPreset;
		WeatherClampsMin = ScriptableObject.CreateInstance(typeof(WeatherPreset)) as WeatherPreset;
		WeatherClampsMax = ScriptableObject.CreateInstance(typeof(WeatherPreset)) as WeatherPreset;
		WeatherOverrides = ScriptableObject.CreateInstance(typeof(WeatherPreset)) as WeatherPreset;
		WeatherState = ScriptableObject.CreateInstance(typeof(WeatherPreset)) as WeatherPreset;
		DeepSeaWeatherState = ScriptableObject.CreateInstance(typeof(WeatherPreset)) as WeatherPreset;
		WeatherState.Reset();
		DeepSeaWeatherState.Reset();
		WeatherClampsMin.Reset();
		WeatherClampsMax.Reset();
		WeatherOverrides.Reset();
		Overrides = new LegacyWeatherState(WeatherOverrides);
	}

	protected override void OnDestroy()
	{
		if (!Application.isQuitting)
		{
			((SingletonComponent)this).OnDestroy();
			if ((Object)(object)WeatherState != (Object)null)
			{
				Object.Destroy((Object)(object)WeatherState);
			}
			if ((Object)(object)WeatherClampsMin != (Object)null)
			{
				Object.Destroy((Object)(object)WeatherClampsMin);
			}
			if ((Object)(object)WeatherClampsMax != (Object)null)
			{
				Object.Destroy((Object)(object)WeatherClampsMax);
			}
			if ((Object)(object)WeatherOverrides != (Object)null)
			{
				Object.Destroy((Object)(object)WeatherOverrides);
			}
		}
	}

	private void GetPresetVCloudConfigs(WeatherPreset preset, uint seed, out VolumeCloudsConfig cfg, out VolumeCloudsCirrusConfig cfgCirrus, out VolumeCloudsRadialWeatherLayerConfig cfgStorm)
	{
		if (preset.VolumeCloudsConfigs != null && preset.VolumeCloudsConfigs.Length != 0)
		{
			cfg = preset.VolumeCloudsConfigs[SeedRandom.Range(seed, 0, preset.VolumeCloudsConfigs.Length)];
		}
		else if (DefaultCloudConfigs.Length == 0)
		{
			Debug.LogError((object)"Current weather profile has no cloud config, and default cloud config list is empty!  This shouldn't be so");
			cfg = null;
		}
		else
		{
			cfg = DefaultCloudConfigs[SeedRandom.Range(seed, 0, DefaultCloudConfigs.Length)];
		}
		if (preset.VolumeCloudsCirrusConfigs != null && preset.VolumeCloudsCirrusConfigs.Length != 0)
		{
			cfgCirrus = preset.VolumeCloudsCirrusConfigs[SeedRandom.Range(seed, 0, preset.VolumeCloudsCirrusConfigs.Length)];
		}
		else if (DefaultCirrusConfigs.Length == 0)
		{
			Debug.LogError((object)"Current weather profile has no cirrus cloud config, and default cirrus cloud config list is empty!  This shouldn't be so");
			cfgCirrus = null;
		}
		else
		{
			cfgCirrus = DefaultCirrusConfigs[SeedRandom.Range(seed, 0, DefaultCirrusConfigs.Length)];
		}
		if (preset.VolumeCloudsStormLayers != null && preset.VolumeCloudsStormLayers.Length != 0)
		{
			cfgStorm = preset.VolumeCloudsStormLayers[SeedRandom.Range(seed, 0, preset.VolumeCloudsStormLayers.Length)];
		}
		else
		{
			cfgStorm = null;
		}
	}

	public void Update()
	{
		if (!Application.isReceiving && !Application.isLoading && Object.op_Implicit((Object)(object)TOD_Sky.Instance))
		{
			TOD_Sky instance = TOD_Sky.Instance;
			float num = 0f;
			long ticks = instance.Cycle.Ticks;
			long num2 = 648000000000L;
			long num3 = 216000000000L;
			long num4 = ticks / num2 + World.Seed;
			WeatherStateBlend = Mathf.InverseLerp(0f, (float)num3, (float)(ticks % num2));
			uint seed = (WeatherSeedPrevious = GetSeedFromLong(num4));
			WeatherStatePrevious = GetWeatherPreset(seed);
			seed = (WeatherSeedTarget = GetSeedFromLong(num4 + 1));
			WeatherStateTarget = GetWeatherPreset(seed);
			seed = (WeatherSeedNext = GetSeedFromLong(num4 + 2));
			WeatherStateNext = GetWeatherPreset(seed);
			WeatherState.Fade(WeatherStatePrevious, WeatherStateTarget, WeatherStateBlend);
			WeatherState.Override(WeatherOverrides);
			DeepSeaManager serverInstance = PointEntity<DeepSeaManager>.ServerInstance;
			if ((Object)(object)serverInstance != (Object)null)
			{
				num = serverInstance.GetWipeWeatherLerp();
				DeepSeaWeatherState.Fade(DeepSeaCalmWeather, DeepSeaWipeWeather, num);
			}
		}
	}

	private static bool Initialized()
	{
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance))
		{
			return false;
		}
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance.WeatherStatePrevious))
		{
			return false;
		}
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance.WeatherStateTarget))
		{
			return false;
		}
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance.WeatherStateNext))
		{
			return false;
		}
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance.WeatherState))
		{
			return false;
		}
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance.WeatherClampsMin))
		{
			return false;
		}
		if (!Object.op_Implicit((Object)(object)SingletonComponent<Climate>.Instance.WeatherOverrides))
		{
			return false;
		}
		return true;
	}

