	public int maxGroups = 2;

	public float minLifetimeMinutes = 30f;

	public float maxLifetimeMinutes = 60f;

	private readonly List<RHIB> _spawnedBoats = new List<RHIB>();

	public override void RunEvent()
	{
		//IL_003a: Unknown result type (might be due to invalid IL or missing references)
		//IL_0040: Unknown result type (might be due to invalid IL or missing references)
		//IL_0057: Unknown result type (might be due to invalid IL or missing references)
		//IL_005d: Unknown result type (might be due to invalid IL or missing references)
		//IL_0063: Unknown result type (might be due to invalid IL or missing references)
		//IL_0068: Unknown result type (might be due to invalid IL or missing references)
		//IL_006d: Unknown result type (might be due to invalid IL or missing references)
		//IL_006e: Unknown result type (might be due to invalid IL or missing references)
		//IL_0078: Unknown result type (might be due to invalid IL or missing references)
		//IL_007d: Unknown result type (might be due to invalid IL or missing references)
		//IL_00ea: Unknown result type (might be due to invalid IL or missing references)
		if (AnyStillOut())
		{
			return;
		}
		int num = Random.Range(1, maxGroups + 1);
		for (int i = 0; i < num; i++)
		{
			if (!BoatAI.TryGetMapEdgeSpawn(out var position, out var destination))
			{
				Debug.Log((object)"[event] Failed to find a spawn position for a roaming boat group");
				break;
			}
			Debug.Log((object)$"[event] Spawning roaming boat group at {position}, heading to {destination}");
			PooledHashSet<RHIB> val = Pool.Get<PooledHashSet<RHIB>>();
			try
			{
				BoatAI.SpawnBoatGroup(new Vector2(position.x, position.z), Quaternion.LookRotation(Vector3Ex.WithY(TerrainMeta.Center - position, 0f)), (HashSet<RHIB>)(object)val);
				float num2 = Random.Range(minLifetimeMinutes, maxLifetimeMinutes) * 60f;
				foreach (RHIB boat in (HashSet<RHIB>)(object)val)
				{
					BoatAI componentInChildren = ((Component)boat).GetComponentInChildren<BoatAI>();
					componentInChildren.Roaming = true;
					componentInChildren.LoadMode = BoatAI.AILoadMode.KillBoat;
					componentInChildren.MoveTo(destination);
					componentInChildren.LeaveAfter(num2);
					((FacepunchBehaviour)boat).Invoke((Action)delegate
					{
						RemoveBoat(boat);
					}, num2 + 60f * BoatAI.roaming_egress_minutes);
					_spawnedBoats.Add(boat);
				}
			}
			finally
			{
				((IDisposable)val)?.Dispose();
			}
		}
	}

	private bool AnyStillOut()
	{
		for (int num = _spawnedBoats.Count - 1; num >= 0; num--)
		{
			if (!_spawnedBoats[num].IsValid())
			{
				_spawnedBoats.RemoveAt(num);
			}
		}
		return _spawnedBoats.Count > 0;
	}

	private void RemoveBoat(RHIB boat)
	{
		_spawnedBoats.Remove(boat);
		if (!boat.HasPlayerAboard())
		{
			boat.AdminKillNoLoot();
		}
	}

	public override void Kill()
	{
		base.Kill();
		for (int i = 0; i < _spawnedBoats.Count; i++)
		{
			if (_spawnedBoats[i].IsValid() && !_spawnedBoats[i].HasPlayerAboard())
			{
				_spawnedBoats[i].AdminKillNoLoot();
			}
		}
		_spawnedBoats.Clear();
	}
}


using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using ConVar;
using Rust;
using UnityEngine;
using UnityEngine.Serialization;

public class EventSchedule : BaseMonoBehaviour
{
	[Tooltip("The minimum amount of hours between events")]
	public float minimumHoursBetween = 12f;

	[Tooltip("The maximum amount of hours between events")]
	[FormerlySerializedAs("maxmumHoursBetween")]
	public float maximumHoursBetween = 24f;

	[Tooltip("ID to reference this event via convars")]
	public string Key;

	public static HashSet<EventSchedule> allEvents = new HashSet<EventSchedule>();

	public static HashSet<EventSchedule> enabledEvents = new HashSet<EventSchedule>();

	protected float hoursRemaining;

	protected long lastRun;

	public float HoursRemaining => hoursRemaining;

	[ServerVar(Name = "triggerevent", Help = "(Generated) Triggers a named event schedule by partial name match; registered as eventschedule.triggerevent; lists available events if name is invalid or ambiguous")]
	public static void TriggerEvent(Arg arg)
	{
		string eventName = arg.GetString(0, "");
		string[] source = enabledEvents.Select((EventSchedule x) => x.GetName().ToLower()).ToArray();
		string[] array = (from x in source
			where StringEx.Contains(x, eventName, CompareOptions.IgnoreCase)
			select x.ToLower()).ToArray();
		if (string.IsNullOrEmpty(eventName) || array.Length == 0)
		{
			arg.ReplyWith("Unknown event - event list:\n\n" + string.Join("\n", source.Select(Path.GetFileNameWithoutExtension).ToArray()));
			return;
		}
		if (array.Length > 1)
		{
			string text = array.FirstOrDefault((string x) => string.Compare(x, eventName, StringComparison.OrdinalIgnoreCase) == 0);
			if (text != null)
			{
				array[0] = text;
			}
		}
		foreach (EventSchedule enabledEvent in enabledEvents)
		{
			if (enabledEvent.GetName() == array[0])
			{
				enabledEvent.Trigger();
				arg.ReplyWith("Triggered " + enabledEvent.GetName());
			}
		}
	}

	[ServerVar(Name = "killallevents", Help = "(Generated) Kills all currently running triggered event instances across all enabled event schedules; registered as eventschedule.killallevents")]
	public static void KillAllEvents()
	{
		foreach (EventSchedule enabledEvent in enabledEvents)
		{
			TriggeredEvent[] components = ((Component)enabledEvent).GetComponents<TriggeredEvent>();
			for (int i = 0; i < components.Length; i++)
			{
				components[i].Kill();
			}
		}
	}

	public string GetName()
	{
		return Path.GetFileNameWithoutExtension(((Object)this).name);
	}

	private void Awake()
	{
		allEvents.Add(this);
		Events.UpdateScheduleFromConVars(this);
	}

	private void OnDestroy()
	{
		allEvents.Remove(this);
	}

	private void OnEnable()
	{
		hoursRemaining = Random.Range(minimumHoursBetween, maximumHoursBetween);
		((FacepunchBehaviour)this).InvokeRepeating((Action)RunSchedule, 1f, 1f);
		enabledEvents.Add(this);
	}

	private void OnDisable()
	{
		if (!Application.isQuitting)
		{
			enabledEvents.Remove(this);
			((FacepunchBehaviour)this).CancelInvoke((Action)RunSchedule);
		}
	}

	public virtual void RunSchedule()
	{
		if (!Application.isLoading && ConVar.Server.events)
		{
			CountHours();
			if (!(hoursRemaining > 0f))
			{
				Trigger();
			}
		}
	}

	public void Trigger()
	{
		hoursRemaining = Random.Range(minimumHoursBetween, maximumHoursBetween);
		TriggeredEvent[] components = ((Component)this).GetComponents<TriggeredEvent>();
		if (components.Length != 0)
		{
			TriggeredEvent triggeredEvent = components[Random.Range(0, components.Length)];
			if (!((Object)(object)triggeredEvent == (Object)null))
			{
				triggeredEvent.RunEvent();
			}
		}
	}

	protected virtual void CountHours()
	{
		if (Object.op_Implicit((Object)(object)TOD_Sky.Instance))
		{
			if (lastRun != 0L)
			{
				hoursRemaining -= (float)TOD_Sky.Instance.Cycle.DateTime.Subtract(DateTime.FromBinary(lastRun)).TotalSeconds / 60f / 60f;
			}
			lastRun = TOD_Sky.Instance.Cycle.DateTime.ToBinary();
		}
	}

	public static Dictionary<string, float> SaveHoursRemaining()
	{
		Dictionary<string, float> dictionary = new Dictionary<string, float>();
		foreach (EventSchedule enabledEvent in enabledEvents)
		{
			if (!string.IsNullOrEmpty(enabledEvent.Key))
			{
				dictionary[enabledEvent.Key] = enabledEvent.hoursRemaining;
			}
		}
		return dictionary;
	}

	public static void LoadHoursRemaining(Dictionary<string, float> saved)
	{
		if (saved == null)
		{
			return;
		}
		foreach (EventSchedule enabledEvent in enabledEvents)
		{
			if (!string.IsNullOrEmpty(enabledEvent.Key) && saved.TryGetValue(enabledEvent.Key, out var value))
			{
				enabledEvent.hoursRemaining = Mathf.Min(value, enabledEvent.maximumHoursBetween);
				enabledEvent.lastRun = 0L;
			}
		}
	}
}


using System;
using UnityEngine;

public class EventScheduleDynamicTickrate : EventSchedule
{
	[NonSerialized]
	public float tickRate = 1f;

	protected override void CountHours()
	{
		if (Object.op_Implicit((Object)(object)TOD_Sky.Instance))
		{
			if (lastRun != 0L)
			{
				hoursRemaining -= (float)TOD_Sky.Instance.Cycle.DateTime.Subtract(DateTime.FromBinary(lastRun)).TotalSeconds / 60f / 60f * tickRate;
			}
			lastRun = TOD_Sky.Instance.Cycle.DateTime.ToBinary();
		}
	}
}


