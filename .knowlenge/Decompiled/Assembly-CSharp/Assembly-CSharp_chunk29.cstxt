			((Utf16ValueStringBuilder)(ref sb)).Append("), ");
			((Utf16ValueStringBuilder)(ref sb)).Append(dirtyTiles);
			((Utf16ValueStringBuilder)(ref sb)).Append(" tiles were dirty and the next save rewrites the whole file: ");
			((Utf16ValueStringBuilder)(ref sb)).Append(failure);
			return;
		}
		((Utf16ValueStringBuilder)(ref sb)).Append(wroteDelta ? "delta" : "full");
		((Utf16ValueStringBuilder)(ref sb)).Append(", main ");
		((Utf16ValueStringBuilder)(ref sb)).Append(mainMs, "F1");
		((Utf16ValueStringBuilder)(ref sb)).Append(" ms, thread ");
		((Utf16ValueStringBuilder)(ref sb)).Append(threadMs, "F1");
		((Utf16ValueStringBuilder)(ref sb)).Append(" ms (id ");
		((Utf16ValueStringBuilder)(ref sb)).Append(threadId);
		((Utf16ValueStringBuilder)(ref sb)).Append("), ");
		if (wroteDelta)
		{
			((Utf16ValueStringBuilder)(ref sb)).Append("appended in place");
		}
		else
		{
			((Utf16ValueStringBuilder)(ref sb)).Append("replace ");
			((Utf16ValueStringBuilder)(ref sb)).Append(replaceMs, "F1");
			((Utf16ValueStringBuilder)(ref sb)).Append(" ms (");
			((Utf16ValueStringBuilder)(ref sb)).Append<NavmeshSaveReplaceMode>(replaceMode);
			((Utf16ValueStringBuilder)(ref sb)).Append(")");
		}
		if (phasesValid)
		{
			((Utf16ValueStringBuilder)(ref sb)).Append(", phases gather ");
			((Utf16ValueStringBuilder)(ref sb)).Append(phases.gatherMs, "F1");
			((Utf16ValueStringBuilder)(ref sb)).Append(" / compress ");
			((Utf16ValueStringBuilder)(ref sb)).Append(phases.compressWaitMs, "F1");
			((Utf16ValueStringBuilder)(ref sb)).Append(" / write ");
			((Utf16ValueStringBuilder)(ref sb)).Append(phases.writeMs, "F1");
			((Utf16ValueStringBuilder)(ref sb)).Append(" / flush ");
			((Utf16ValueStringBuilder)(ref sb)).Append(phases.flushMs, "F1");
			((Utf16ValueStringBuilder)(ref sb)).Append(" ms");
		}
		((Utf16ValueStringBuilder)(ref sb)).Append(", ");
		((Utf16ValueStringBuilder)(ref sb)).Append(bytes);
		((Utf16ValueStringBuilder)(ref sb)).Append(" bytes on disk, appended ");
		((Utf16ValueStringBuilder)(ref sb)).Append(deltaAppendedBytes);
		((Utf16ValueStringBuilder)(ref sb)).Append(" of a ");
		((Utf16ValueStringBuilder)(ref sb)).Append(deltaBaseBytes);
		((Utf16ValueStringBuilder)(ref sb)).Append(" byte base (budget ");
		((Utf16ValueStringBuilder)(ref sb)).Append(deltaBudget, "0.####");
		((Utf16ValueStringBuilder)(ref sb)).Append("), ");
		((Utf16ValueStringBuilder)(ref sb)).Append(pendingTiles);
		((Utf16ValueStringBuilder)(ref sb)).Append(" pending tiles, ");
		((Utf16ValueStringBuilder)(ref sb)).Append(dirtyTiles);
		((Utf16ValueStringBuilder)(ref sb)).Append(" tiles dirty since the last save (version delta ");
		((Utf16ValueStringBuilder)(ref sb)).Append(dataVersionDelta);
		((Utf16ValueStringBuilder)(ref sb)).Append(")");
	}
}


