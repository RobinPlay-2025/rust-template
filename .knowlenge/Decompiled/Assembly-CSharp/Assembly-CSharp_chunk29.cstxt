		try
		{
			for (int num = count - 1; num >= 0; num--)
			{
				RustNavMeshAgent rustNavMeshAgent = enabledComponents[num];
				if (rustNavMeshAgent.IsUnityNull() || !rustNavMeshAgent.baseEntity.IsValid())
				{
					enabledComponents.RemoveAt(num);
