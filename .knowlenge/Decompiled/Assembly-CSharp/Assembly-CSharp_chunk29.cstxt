		}
		finally
		{
			transformBatchAgent = null;
			try
			{
				FlushTransformBatch();
			}
			finally
			{
				transformBatchActive = false;
				if (enabledComponents.Count == 0)
				{
					DisposeTransformBatch();
				}
			}
		}
	}

