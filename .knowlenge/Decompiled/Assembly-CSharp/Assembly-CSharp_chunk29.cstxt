		if (AI.logIssues && !loggedSaveProcessorCounts)
		{
			loggedSaveProcessorCounts = true;
			RustNavigation.Log($"Navmesh save and load threads: {num} (Environment.ProcessorCount {Environment.ProcessorCount}, SystemInfo.processorCount {SystemInfo.processorCount}, rustnav.savethreads {saveThreads})");
		}
		return num;
