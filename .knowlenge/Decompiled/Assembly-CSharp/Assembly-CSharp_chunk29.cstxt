	{
		TimeWarning val = TimeWarning.New("Trans_Triggerable", 0);
		try
		{
			if (Triggered && Parameter.HasValue)
			{
				payload.CopyFrom(Parameter.Value);
				Parameter = null;
			}
			return Triggered;
		}
		finally
		{
			((IDisposable)val)?.Dispose();
		}
	}
}


