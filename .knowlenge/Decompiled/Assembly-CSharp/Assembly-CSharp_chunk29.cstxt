		for (int i = 0; i < count; i++)
		{
			Marshal.WriteInt32(intPtr, i * 4 * 2, dirtyTilesSinceSave[i].tx);
			Marshal.WriteInt32(intPtr, i * 4 * 2 + 4, dirtyTilesSinceSave[i].ty);
		}
		return intPtr;
	}

