	public void Tick()
	{
		if (!AI.useUnityNavmesh)
		{
			if (DefaultNavmesh != null)
			{
				DefaultNavmesh.PollSaveOnMainThread();
			}
			if (tileBuilder != null)
			{
				tileBuilder.TickOnMainThread();
			}
		}
	}

	private void OnDestroy()
