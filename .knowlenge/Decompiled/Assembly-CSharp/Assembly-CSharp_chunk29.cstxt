	{
		tx = request.tx;
		ty = request.ty;
		navmesh = request.navmesh;
		tileBytes = IntPtr.Zero;
		dataSize = 0;
		this.resultCode = resultCode;
		cancellation = request.cancellation;
		debugSpanMinY = 0f;
		debugSpanMaxY = 0f;
	}
}


