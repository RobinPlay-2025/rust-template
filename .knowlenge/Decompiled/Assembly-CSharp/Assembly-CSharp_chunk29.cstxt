					return agent.isOnNavMesh;
				}
				ulong num = currentPolyRef;
				if (num == 0L)
				{
					TryBindNavmesh();
				}
				else if (boundNavmesh != null && boundNavmesh.IsValidPolyRef(num))
				{
					return true;
