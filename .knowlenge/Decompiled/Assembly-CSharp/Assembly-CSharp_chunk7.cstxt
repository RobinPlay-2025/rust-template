	private void PhysicsTick()
	{
		TimeWarning val = TimeWarning.New("Pooltable.PhysicsTick", 0);
		try
		{
			if (physicsEngine == null || !physicsEngine.IsReady)
			{
				return;
			}
			bool flag = physicsEngine.HasMovingBalls();
			if (flag)
			{
				int num = Mathf.Clamp((int)((Time.timeAsDouble - lastPhysicsTime) / (double)PhysicsRate), 0, 32);
				TimeWarning val2 = TimeWarning.New("Pooltable.PhysicsTick.Simulate", 0);
				try
				{
					for (int i = 0; i < num; i++)
					{
						physicsEngine.Tick(PhysicsRate);
					}
				}
				finally
				{
					((IDisposable)val2)?.Dispose();
				}
				lastPhysicsTime += (double)num * (double)PhysicsRate;
				if (Time.timeAsDouble - lastPhysicsTime > (double)(PhysicsRate * 32f))
				{
					lastPhysicsTime = Time.timeAsDouble;
				}
				if (base.isServer && num > 0)
				{
					TimeWarning val3 = TimeWarning.New("Pooltable.PhysicsTick.SendNetworkUpdate", 0);
					try
					{
						SendNetworkUpdate();
					}
					finally
					{
						((IDisposable)val3)?.Dispose();
					}
				}
			}
			else
			{
				lastPhysicsTime = Time.timeAsDouble;
				if (wasMovingLastTick)
				{
					DebugPool("PhysicsTick transition moving->stopped");
					TimeWarning val4 = TimeWarning.New("Pooltable.PhysicsTick.OnBallsStopped", 0);
					try
					{
						gameController?.OnBallsStopped();
						if (base.isServer)
						{
							((FacepunchBehaviour)this).CancelInvoke((Action)DismountAllSeatedPlayers);
							((FacepunchBehaviour)this).Invoke((Action)DismountAllSeatedPlayers, watch_after_shot_seconds);
						}
					}
					finally
					{
						((IDisposable)val4)?.Dispose();
					}
				}
			}
			wasMovingLastTick = flag;
		}
		finally
		{
			((IDisposable)val)?.Dispose();
		}
	}

