					if (!canMoveFromResponse2.allowed)
					{
						msg.player.ShowToast(GameTip.Styles.Error, canMoveFromResponse2.reasonForFailure ?? PlayerInventoryErrors.CannotMoveItem, canMoveFromResponse2.reasonForFailure != null);
