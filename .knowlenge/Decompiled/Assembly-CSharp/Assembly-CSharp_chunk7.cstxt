	public const string InsertFuseAchievement = "POWERPLANT_HEAVY_FUSE";

	[Header("Powergrid Fuse Box")]
	public ItemDefinition[] validPassthroughItems;

	public GameObject[] fuses = Array.Empty<GameObject>();

