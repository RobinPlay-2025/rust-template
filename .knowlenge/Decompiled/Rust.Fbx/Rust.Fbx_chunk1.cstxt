		{
			options = new Options();
		}
		if (!FbxSampling.TryCreateGrid(scene, take, options.FirstFrame, options.LastFrame, options.MaxFrameRate, out var grid, out error))
		{
			return false;
		}
		float positionScale = (options.ApplyUnitScaleFactor ? (options.PositionScale * scene.UnitScaleFactor) : options.PositionScale);
		float[] times = grid.BuildTimes();
		Matrix4x4 mirror = Matrix4x4.Scale(options.MirrorAxis);
		clip = new AnimationClip
		{
			frameRate = grid.FrameRate,
			legacy = true
		};
		for (int i = 0; i < scene.Models.Count; i++)
		{
			FbxModel fbxModel = scene.Models[i];
			if (fbxModel.IsAnimated)
			{
				BuildModelCurves(clip, fbxModel, scene.RootId, times, grid, mirror, positionScale, options.BindRotations);
			}
		}
		clip.legacy = options.Legacy;
		return true;
	}

	private static void BuildModelCurves(AnimationClip clip, FbxModel model, long rootId, float[] times, FbxSampleGrid grid, Matrix4x4 mirror, float positionScale, IReadOnlyDictionary<string, Quaternion> bindRotations)
