public sealed class FbxCurve
{
	public long[] Times;

	public float[] Values;

	public float Default;

	public float Evaluate(long tick)
	{
		if (Times == null || Times.Length == 0)
		{
			return Default;
		}
		int num = Times.Length - 1;
		if (tick <= Times[0])
		{
			return Values[0];
		}
		if (tick >= Times[num])
		{
			return Values[num];
		}
		int num2 = 0;
		int num3 = num;
		while (num2 + 1 < num3)
		{
			int num4 = num2 + num3 >> 1;
			if (Times[num4] <= tick)
			{
				num2 = num4;
			}
			else
			{
				num3 = num4;
			}
		}
		long num5 = Times[num2];
		long num6 = Times[num3];
		float num7 = Values[num2];
		float num8 = Values[num3];
		if (num6 == num5)
		{
			return num7;
		}
		float num9 = (float)((double)(tick - num5) / (double)(num6 - num5));
		return num7 + (num8 - num7) * num9;
	}
}


