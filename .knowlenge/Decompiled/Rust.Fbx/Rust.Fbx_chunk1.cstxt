	public float UnitScaleFactor = 1f;

	public float FrameRate = 30f;

	public long RootId;

	public List<FbxModel> Models = new List<FbxModel>();

	public List<FbxTake> Takes = new List<FbxTake>();

	public static bool TryBuild(FbxDocument document, out FbxScene scene, out string error)
	{
		scene = null;
		error = null;
		if (!document.TryGetChild("Objects", out var node))
		{
			error = "FBX has no Objects section.";
			return false;
		}
		document.TryGetChild("Connections", out var node2);
		scene = new FbxScene();
		scene.ReadGlobalSettings(document);
		Dictionary<long, FbxNode> dictionary = new Dictionary<long, FbxNode>();
		for (int i = 0; i < node.Children.Count; i++)
		{
			FbxNode fbxNode = node.Children[i];
			if (fbxNode.Properties.Length != 0)
			{
				dictionary[fbxNode.GetLong(0)] = fbxNode;
			}
		}
		Dictionary<long, FbxModel> dictionary2 = new Dictionary<long, FbxModel>();
		for (int j = 0; j < node.Children.Count; j++)
		{
			FbxNode fbxNode2 = node.Children[j];
			if (!(fbxNode2.Name != "Model"))
			{
				FbxModel fbxModel = ReadModel(fbxNode2);
				dictionary2[fbxModel.Id] = fbxModel;
				scene.Models.Add(fbxModel);
			}
		}
		List<Connection> connections = ReadConnections(node2);
		ResolveHierarchy(scene, dictionary2, connections);
		scene.ReadTakes(dictionary);
		AttachAnimation(dictionary, dictionary2, connections);
		return true;
	}

	private void ReadGlobalSettings(FbxDocument document)
	{
		if (!document.TryGetChild("GlobalSettings", out var node))
		{
			return;
		}
		if (TryGetProperty70(node, "UnitScaleFactor", out var property))
		{
			UnitScaleFactor = (float)property.GetDouble(4);
		}
		if (TryGetProperty70(node, "CustomFrameRate", out var property2))
		{
			float num = (float)property2.GetDouble(4);
			if (num > 0f)
			{
				FrameRate = num;
			}
		}
		if (TryGetProperty70(node, "TimeMode", out var property3))
		{
			float num2 = FrameRateFromTimeMode(property3.GetInt(4));
			if (num2 > 0f)
			{
				FrameRate = num2;
			}
		}
	}

