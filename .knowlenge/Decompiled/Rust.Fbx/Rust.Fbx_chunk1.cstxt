								return ((bool)value) ? 1.0 : 0.0;
							}
							return 0.0;
						}
						return num4;
					}
					return num3;
				}
				return num2;
			}
			return num;
		}
		return result;
	}

	public static long ToLong(object value)
	{
		if (!(value is long result))
		{
			if (!(value is int num))
			{
				if (!(value is short num2))
				{
					if (!(value is double num3))
					{
						if (!(value is float num4))
						{
							if (value is bool)
							{
								return ((bool)value) ? 1 : 0;
							}
							return 0L;
						}
						return (long)num4;
					}
					return (long)num3;
				}
				return num2;
			}
			return num;
		}
		return result;
	}
}


