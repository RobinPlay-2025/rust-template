using System;
using System.Collections.Generic;
using System.Globalization;

private sealed class State
{
	public string text;

	public int pos;

	public int nodes;

	public void ReadNodes(List<FbxNode> into, int depth, bool nested)
	{
		if (depth > 64)
		{
			throw new FbxParseException($"FBX nesting deeper than {64} levels.");
		}
		while (true)
		{
			SkipTrivia();
			if (pos >= text.Length)
			{
				if (nested)
				{
					throw new FbxParseException("Malformed FBX: unterminated block (the file is truncated).");
				}
				return;
			}
			if (text[pos] == '}')
			{
				pos++;
				return;
			}
			if (++nodes > 4000000)
			{
				break;
			}
			into.Add(ReadNode(depth));
		}
		throw new FbxParseException($"FBX contains more than {4000000} nodes.");
	}

	private FbxNode ReadNode(int depth)
	{
		int num = pos;
		while (pos < text.Length && text[pos] != ':' && text[pos] != '\n' && text[pos] != '{' && text[pos] != '}')
		{
			pos++;
		}
		if (pos >= text.Length || text[pos] != ':')
		{
			throw new FbxParseException($"Malformed FBX: expected ':' after node name at offset {num}.");
		}
		FbxNode fbxNode = new FbxNode
		{
			Name = text.Substring(num, pos - num).Trim()
		};
		pos++;
		List<object> list = new List<object>();
		ReadProperties(fbxNode, list);
		SkipTrivia();
		if (pos < text.Length && text[pos] == '{')
		{
			pos++;
			ReadNodes(fbxNode.Children, depth + 1, nested: true);
		}
		if (list.Count > 0)
		{
			fbxNode.Properties = list.ToArray();
		}
		return fbxNode;
	}

	private void ReadProperties(FbxNode node, List<object> properties)
	{
		while (true)
		{
			SkipSpacesAndComments();
			if (pos >= text.Length)
			{
				break;
			}
			switch (text[pos])
			{
			case '\n':
			case '{':
			case '}':
				return;
			case ',':
				pos++;
				break;
			case '*':
			{
				pos++;
				int count = (int)ReadIntegerToken();
				ReadArrayBlock(node, properties, count);
				return;
			}
			case '"':
				properties.Add(ReadQuotedString());
				break;
			default:
				properties.Add(ReadScalarToken());
				break;
			}
		}
	}

	private void ReadArrayBlock(FbxNode node, List<object> properties, int count)
	{
		if (count < 0 || count > 64000000)
		{
			throw new FbxParseException($"FBX array length {count} is out of range.");
		}
		SkipTrivia();
		if (pos >= text.Length || text[pos] != '{')
		{
			properties.Add(Array.Empty<double>());
			return;
		}
		pos++;
		double[] array = new double[count];
		int num = 0;
		while (true)
		{
			SkipTrivia();
			if (pos >= text.Length)
			{
				throw new FbxParseException("Malformed FBX: unterminated array block.");
			}
			if (text[pos] == '}')
			{
				break;
			}
			if (text[pos] == ',')
			{
				pos++;
				continue;
			}
			if (text[pos] == 'a' && pos + 1 < text.Length && text[pos + 1] == ':')
			{
				pos += 2;
				continue;
			}
			double num2 = ReadNumberToken();
			if (num < count)
			{
				array[num] = num2;
			}
			num++;
		}
		pos++;
		if (num != count && num < count)
		{
			Array.Resize(ref array, num);
		}
		properties.Add(array);
	}

	private object ReadScalarToken()
	{
		int num = pos;
		while (pos < this.text.Length)
		{
			char c = this.text[pos];
			if (c == ',' || c == '\n' || c == '\r' || c == '{' || c == '}' || c == ';')
			{
				break;
			}
			pos++;
		}
		string text = this.text.Substring(num, pos - num).Trim();
		if (text.Length == 0)
		{
			return string.Empty;
		}
		if (TryParseNumber(text, out var value, out var integral))
		{
			return integral ? ((double)(long)value) : value;
		}
		return text;
	}

	private double ReadNumberToken()
	{
		int num = pos;
		while (pos < this.text.Length)
		{
			char c = this.text[pos];
			if (c == ',' || c == '}' || c == '\n' || c == '\r' || c == ' ' || c == '\t' || c == ';')
			{
				break;
			}
			pos++;
		}
		string text = this.text.Substring(num, pos - num);
		if (!TryParseNumber(text, out var value, out var _))
		{
			throw new FbxParseException("Malformed FBX: '" + text + "' is not a number.");
		}
		return value;
	}

	private long ReadIntegerToken()
	{
		SkipSpacesAndComments();
		int num = pos;
		while (pos < text.Length && (char.IsDigit(text[pos]) || text[pos] == '-'))
		{
			pos++;
		}
		if (pos == num)
		{
			throw new FbxParseException("Malformed FBX: expected an array length after '*'.");
		}
		return long.Parse(text.Substring(num, pos - num), CultureInfo.InvariantCulture);
	}

	private string ReadQuotedString()
	{
		pos++;
		int num = pos;
		while (pos < text.Length && text[pos] != '"')
		{
			pos++;
		}
		string raw = text.Substring(num, pos - num);
		if (pos < text.Length)
		{
			pos++;
		}
		return NormalizeObjectName(raw);
	}

	private void SkipTrivia()
	{
		while (pos < text.Length)
		{
			switch (text[pos])
			{
			case '\t':
			case '\n':
			case '\r':
			case ' ':
				pos++;
				break;
			case ';':
				SkipToLineEnd();
				break;
			default:
				return;
			}
		}
	}

	private void SkipSpacesAndComments()
	{
		while (pos < text.Length)
		{
			switch (text[pos])
			{
			case '\t':
			case '\r':
			case ' ':
				break;
			case ';':
				SkipToLineEnd();
				return;
			default:
				return;
			}
			pos++;
		}
	}

	private void SkipToLineEnd()
	{
		while (pos < text.Length && text[pos] != '\n')
		{
			pos++;
		}
	}
}


