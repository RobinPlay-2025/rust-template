	public Vector3 LclRotation;

	public Vector3 LclScaling = Vector3.one;

	public Vector3 PreRotation;

	public Vector3 PostRotation;

	public Vector3 RotationOffset;

	public Vector3 RotationPivot;

	public Vector3 ScalingOffset;

	public Vector3 ScalingPivot;

	public int RotationOrder;

	public FbxAnimatedChannel Translation;

	public FbxAnimatedChannel Rotation;

	public FbxAnimatedChannel Scaling;

	public bool IsAnimated
	{
		get
		{
			if ((Translation == null || !Translation.HasAnyCurve) && (Rotation == null || !Rotation.HasAnyCurve))
			{
				if (Scaling != null)
				{
					return Scaling.HasAnyCurve;
				}
				return false;
			}
			return true;
		}
	}

	public string GetPath(long rootId)
	{
		if (Parent == null || Parent.Id == rootId)
		{
			return Name;
		}
		List<string> list = new List<string>();
		FbxModel fbxModel = this;
		int num = 0;
		while (fbxModel != null && fbxModel.Id != rootId && num++ < 1024)
		{
			list.Add(fbxModel.Name);
			fbxModel = fbxModel.Parent;
		}
		StringBuilder stringBuilder = new StringBuilder();
		for (int num2 = list.Count - 1; num2 >= 0; num2--)
		{
			if (stringBuilder.Length > 0)
			{
				stringBuilder.Append('/');
			}
			stringBuilder.Append(list[num2]);
		}
		return stringBuilder.ToString();
	}
}


