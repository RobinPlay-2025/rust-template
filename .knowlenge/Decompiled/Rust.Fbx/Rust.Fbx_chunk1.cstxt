			for (int i = 0; i < val.length; i++)
			{
				val.SmoothTangents(i, 0f);
			}
		}
		clip.SetCurve(path, typeof(Transform), property, val);
	}

	private static bool TryResolveRange(FbxScene scene, FbxTake take, Options options, float frameRate, out long startTick, out long stopTick)
	{
		if (options.FirstFrame >= 0 && options.LastFrame > options.FirstFrame)
		{
			double num = 46186158000.0 / (double)frameRate;
			startTick = (long)Math.Round((double)options.FirstFrame * num);
			stopTick = (long)Math.Round((double)options.LastFrame * num);
			return true;
		}
		if (take != null && take.LocalStop > take.LocalStart)
		{
			startTick = take.LocalStart;
			stopTick = take.LocalStop;
			return true;
		}
		long min = long.MaxValue;
		long max = long.MinValue;
		for (int i = 0; i < scene.Models.Count; i++)
		{
			FbxModel fbxModel = scene.Models[i];
			Accumulate(fbxModel.Translation, ref min, ref max);
			Accumulate(fbxModel.Rotation, ref min, ref max);
			Accumulate(fbxModel.Scaling, ref min, ref max);
		}
		if (min == long.MaxValue || max <= min)
		{
			startTick = 0L;
			stopTick = 0L;
			return min != long.MaxValue;
		}
		startTick = min;
		stopTick = max;
		return true;
	}

	private static void Accumulate(FbxAnimatedChannel channel, ref long min, ref long max)
	{
		if (channel != null)
		{
			AccumulateCurve(channel.X, ref min, ref max);
			AccumulateCurve(channel.Y, ref min, ref max);
			AccumulateCurve(channel.Z, ref min, ref max);
		}
	}

	private static void AccumulateCurve(FbxCurve curve, ref long min, ref long max)
	{
		if (curve != null && curve.Times != null && curve.Times.Length != 0)
		{
			if (curve.Times[0] < min)
			{
				min = curve.Times[0];
			}
			long num = curve.Times[curve.Times.Length - 1];
			if (num > max)
			{
				max = num;
			}
		}
	}
}


