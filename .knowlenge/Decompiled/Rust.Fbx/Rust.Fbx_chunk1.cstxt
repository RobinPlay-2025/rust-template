			for (int j = 0; j < muscleName.Length; j++)
			{
				array3[j] = ToMuscleCurveName(muscleName[j]);
			}
			requiredBones = array2;
			muscleCurveNames = array3;
			humanBoneNames = array;
		}
	}

	private static string ToMuscleCurveName(string muscleName)
	{
