public static class FbxSampling
{
	public static bool TryCreateGrid(FbxScene scene, FbxTake take, int firstFrame, int lastFrame, float maxFrameRate, out FbxSampleGrid grid, out string error)
	{
		grid = null;
		error = null;
		float num = ((scene.FrameRate > 0f) ? scene.FrameRate : 30f);
		if (maxFrameRate > 0f && num > maxFrameRate)
		{
			num = maxFrameRate;
		}
		if (!TryResolveRange(scene, take, firstFrame, lastFrame, num, out var startTick, out var stopTick))
		{
			error = "FBX contains no animation curves.";
			return false;
		}
