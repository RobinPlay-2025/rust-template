			return muscleName;
		}
		int num2 = muscleName.IndexOf(' ', num + 1);
		if (num2 < 0)
		{
			return muscleName;
		}
		string text2 = muscleName.Substring(num + 1, num2 - num - 1);
		switch (text2)
		{
		default:
			if (!(text2 == "Little"))
			{
				return muscleName;
			}
			break;
		case "Thumb":
		case "Index":
		case "Middle":
		case "Ring":
			break;
		}
		return text + "Hand." + text2 + "." + muscleName.Substring(num2 + 1);
	}

