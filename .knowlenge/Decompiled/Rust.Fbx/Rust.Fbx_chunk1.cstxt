	private static List<Connection> ReadConnections(FbxNode connectionsNode)
	{
		List<Connection> list = new List<Connection>();
		if (connectionsNode == null)
		{
			return list;
		}
		for (int i = 0; i < connectionsNode.Children.Count; i++)
		{
			FbxNode fbxNode = connectionsNode.Children[i];
			if (!(fbxNode.Name != "C"))
			{
				list.Add(new Connection
				{
					Type = fbxNode.GetString(0),
					ChildId = fbxNode.GetLong(1),
					ParentId = fbxNode.GetLong(2),
					Property = ((fbxNode.Properties.Length > 3) ? fbxNode.GetString(3) : null)
				});
			}
		}
		return list;
	}

	private static void ResolveHierarchy(FbxScene scene, Dictionary<long, FbxModel> modelsById, List<Connection> connections)
	{
		for (int i = 0; i < connections.Count; i++)
		{
			Connection connection = connections[i];
			if (!(connection.Type != "OO") && modelsById.TryGetValue(connection.ChildId, out var value) && modelsById.TryGetValue(connection.ParentId, out var value2))
			{
				value.ParentId = value2.Id;
				value.Parent = value2;
			}
		}
		scene.RootId = 0L;
	}

	private void ReadTakes(FbxNode objects)
	{
		for (int i = 0; i < objects.Children.Count; i++)
		{
			FbxNode fbxNode = objects.Children[i];
			if (!(fbxNode.Name != "AnimationStack"))
			{
				FbxTake fbxTake = new FbxTake
				{
					Id = fbxNode.GetLong(0),
					Name = StripObjectName(fbxNode.GetString(1))
				};
				if (TryGetProperty70(fbxNode, "LocalStart", out var property))
				{
					fbxTake.LocalStart = property.GetLong(4);
				}
				if (TryGetProperty70(fbxNode, "LocalStop", out var property2))
				{
					fbxTake.LocalStop = property2.GetLong(4);
				}
				Takes.Add(fbxTake);
			}
		}
	}

	private static void AttachAnimation(Dictionary<long, FbxNode> objectsById, Dictionary<long, FbxModel> modelsById, List<Connection> connections, FbxScene scene)
	{
		Dictionary<long, long> dictionary = new Dictionary<long, long>();
		Dictionary<long, long> dictionary2 = new Dictionary<long, long>();
		for (int i = 0; i < connections.Count; i++)
		{
			Connection connection = connections[i];
			if (!(connection.Type != "OO") && objectsById.TryGetValue(connection.ChildId, out var value))
			{
				if (value.Name == "AnimationLayer")
				{
					dictionary[connection.ChildId] = connection.ParentId;
				}
				else if (value.Name == "AnimationCurveNode")
				{
					dictionary2[connection.ChildId] = connection.ParentId;
				}
			}
		}
		Dictionary<long, int> dictionary3 = new Dictionary<long, int>();
		HashSet<long> hashSet = new HashSet<long>();
		Dictionary<long, List<Connection>> dictionary4 = new Dictionary<long, List<Connection>>();
		for (int j = 0; j < connections.Count; j++)
		{
			Connection item = connections[j];
			if (!(item.Type != "OP") && item.Property != null)
			{
				if (!dictionary4.TryGetValue(item.ChildId, out var value2))
				{
					value2 = new List<Connection>();
					dictionary4[item.ChildId] = value2;
				}
				value2.Add(item);
			}
		}
		for (int k = 0; k < connections.Count; k++)
		{
			Connection connection2 = connections[k];
			if (connection2.Type != "OP" || connection2.Property == null || !objectsById.TryGetValue(connection2.ChildId, out var value3) || value3.Name != "AnimationCurve")
			{
				continue;
			}
			long parentId = connection2.ParentId;
			if (objectsById.TryGetValue(parentId, out var value4) && !(value4.Name != "AnimationCurveNode") && TryFindDrivenModel(dictionary4, modelsById, parentId, out var model, out var property))
			{
				FbxCurve curve = ReadCurve(value3);
				AssignCurve(model, property, connection2.Property, value4, curve);
				if (hashSet.Add(parentId) && dictionary2.TryGetValue(parentId, out var value5) && dictionary.TryGetValue(value5, out var value6))
				{
					dictionary3.TryGetValue(value6, out var value7);
					dictionary3[value6] = value7 + 1;
				}
			}
		}
		for (int l = 0; l < scene.Takes.Count; l++)
		{
			FbxTake fbxTake = scene.Takes[l];
			if (dictionary3.TryGetValue(fbxTake.Id, out var value8))
			{
				fbxTake.CurveNodeCount = value8;
			}
		}
	}

	private static bool TryFindDrivenModel(Dictionary<long, List<Connection>> parentsByChild, Dictionary<long, FbxModel> modelsById, long curveNodeId, out FbxModel model, out string property)
	{
		if (parentsByChild.TryGetValue(curveNodeId, out var value))
		{
			for (int i = 0; i < value.Count; i++)
			{
				Connection connection = value[i];
				if (modelsById.TryGetValue(connection.ParentId, out model))
				{
					property = connection.Property;
					return true;
				}
			}
		}
		model = null;
		property = null;
		return false;
	}

	private static void AssignCurve(FbxModel model, string property, string component, FbxNode animCurveNode, FbxCurve curve)
	{
		FbxAnimatedChannel fbxAnimatedChannel;
		switch (property)
		{
		case "Lcl Translation":
		{
			FbxModel fbxModel = model;
			fbxAnimatedChannel = fbxModel.Translation ?? (fbxModel.Translation = new FbxAnimatedChannel());
			break;
		}
		case "Lcl Rotation":
		{
			FbxModel fbxModel = model;
			fbxAnimatedChannel = fbxModel.Rotation ?? (fbxModel.Rotation = new FbxAnimatedChannel());
			break;
		}
		case "Lcl Scaling":
		{
			FbxModel fbxModel = model;
			fbxAnimatedChannel = fbxModel.Scaling ?? (fbxModel.Scaling = new FbxAnimatedChannel());
			break;
		}
		default:
			fbxAnimatedChannel = null;
			break;
		}
		FbxAnimatedChannel fbxAnimatedChannel2 = fbxAnimatedChannel;
		if (fbxAnimatedChannel2 != null)
		{
			switch (component)
			{
			case "d|X":
				curve.Default = ReadChannelDefault(animCurveNode, "d|X");
				fbxAnimatedChannel2.X = curve;
				break;
			case "d|Y":
				curve.Default = ReadChannelDefault(animCurveNode, "d|Y");
				fbxAnimatedChannel2.Y = curve;
				break;
			case "d|Z":
				curve.Default = ReadChannelDefault(animCurveNode, "d|Z");
				fbxAnimatedChannel2.Z = curve;
				break;
			}
		}
	}

	private static float ReadChannelDefault(FbxNode animCurveNode, string name)
	{
		if (!TryGetProperty70(animCurveNode, name, out var property))
		{
			return 0f;
		}
		return (float)property.GetDouble(4);
	}

	private static FbxCurve ReadCurve(FbxNode curveNode)
	{
		FbxCurve fbxCurve = new FbxCurve
		{
			Times = curveNode.GetChild("KeyTime")?.GetLongArray(0),
			Values = curveNode.GetChild("KeyValueFloat")?.GetFloatArray(0)
		};
		if (curveNode.TryGetChild("Default", out var child))
		{
			fbxCurve.Default = (float)child.GetDouble(0);
		}
		return fbxCurve;
	}

	private static bool TryGetProperty70(FbxNode node, string propertyName, out FbxNode property)
	{
		if (node.TryGetChild("Properties70", out var child))
		{
			for (int i = 0; i < child.Children.Count; i++)
			{
				FbxNode fbxNode = child.Children[i];
				if (fbxNode.Name == "P" && fbxNode.GetString(0) == propertyName)
				{
					property = fbxNode;
					return true;
				}
			}
		}
		property = null;
		return false;
	}

	private static Vector3 ReadVector3(FbxNode property)
	{
		//IL_0018: Unknown result type (might be due to invalid IL or missing references)
		return new Vector3((float)property.GetDouble(4), (float)property.GetDouble(5), (float)property.GetDouble(6));
	}

	private static string StripObjectName(string raw)
	{
		if (string.IsNullOrEmpty(raw))
		{
			return raw;
		}
		int num = raw.IndexOf('\0');
		if (num < 0)
		{
			return raw;
		}
		return raw.Substring(0, num);
	}

	private static float FrameRateFromTimeMode(int timeMode)
	{
		return timeMode switch
		{
			1 => 120f, 
			2 => 100f, 
			3 => 60f, 
			4 => 50f, 
			5 => 48f, 
			6 => 30f, 
			7 => 30f, 
			8 => 29.970028f, 
			9 => 29.970028f, 
			10 => 25f, 
			11 => 24f, 
			12 => 1000f, 
			13 => 24f, 
			15 => 96f, 
			16 => 72f, 
			17 => 59.940056f, 
			_ => 0f, 
		};
	}
}


