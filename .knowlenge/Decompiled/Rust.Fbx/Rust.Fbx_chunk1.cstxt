	public static string Normalize(string modelName)
	{
		if (string.IsNullOrEmpty(modelName))
		{
			return string.Empty;
		}
		int num = 0;
		for (int i = 0; i < modelName.Length; i++)
		{
			if (modelName[i] == ':' || modelName[i] == '|')
			{
				num = i + 1;
			}
		}
		StringBuilder stringBuilder = new StringBuilder(modelName.Length - num);
		for (int j = num; j < modelName.Length; j++)
		{
			char c = modelName[j];
			if (c != ' ' && c != '_' && c != '-' && c != '.')
			{
				stringBuilder.Append(char.ToLowerInvariant(c));
			}
		}
		return stringBuilder.ToString();
	}

	public static bool TryMap(string modelName, out HumanBodyBones bone)
	{
		return boneByName.TryGetValue(Normalize(modelName), out bone);
	}

	public static string HumanName(HumanBodyBones bone)
	{
		//IL_000a: Unknown result type (might be due to invalid IL or missing references)
		PrimeHumanTraits();
		return humanBoneNames[bone];
