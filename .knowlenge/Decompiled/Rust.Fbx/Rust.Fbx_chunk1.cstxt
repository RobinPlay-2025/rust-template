using System;
using System.Collections.Generic;
using Rust.Fbx;

public sealed class FbxDocument
{
	public uint Version;

	public FbxNode Root;

	public bool TryGetChild(string name, out FbxNode node)
	{
		return Root.TryGetChild(name, out node);
	}

	public FbxNode GetChild(string name)
	{
		return Root.GetChild(name);
	}

	public static bool TryParse(byte[] bytes, out FbxDocument document, out string error)
	{
		document = null;
		error = null;
		try
		{
			document = Parse(bytes);
			return true;
		}
		catch (FbxParseException ex)
		{
			error = ex.Message;
			return false;
		}
		catch (Exception ex2)
		{
			error = "Unexpected error parsing FBX: " + ex2.Message;
			return false;
		}
	}

	public static FbxDocument Parse(byte[] bytes)
	{
		if (FbxBinaryReader.IsBinary(bytes))
		{
			return FbxBinaryReader.Parse(bytes);
		}
		if (FbxAsciiReader.LooksLikeAscii(bytes))
		{
			return FbxAsciiReader.Parse(bytes);
		}
		return FbxBinaryReader.Parse(bytes);
	}

	public static bool TryListClips(byte[] bytes, List<FbxClipInfo> results, out string error)
	{
		if (FbxBinaryReader.IsBinary(bytes))
		{
			return FbxBinaryReader.TryListClips(bytes, results, out error);
		}
		if (!TryParse(bytes, out var document, out error))
		{
			return false;
		}
		if (!FbxScene.TryBuild(document, out var scene, out error))
		{
			return false;
		}
		for (int i = 0; i < scene.Takes.Count; i++)
		{
			FbxTake fbxTake = scene.Takes[i];
			results.Add(new FbxClipInfo
			{
				Name = fbxTake.Name,
				LocalStart = fbxTake.LocalStart,
				LocalStop = fbxTake.LocalStop
			});
		}
		return true;
	}
}


