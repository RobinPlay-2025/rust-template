public struct FbxClipInfo
{
	public string Name;

	public long LocalStart;

	public long LocalStop;

	public float DurationSeconds
	{
		get
		{
			if (LocalStop <= LocalStart)
			{
				return 0f;
			}
			return (float)((double)(LocalStop - LocalStart) / 46186158000.0);
		}
	}
}


