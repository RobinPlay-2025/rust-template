	public static bool TryGetHumanBone(string humanName, out HumanBodyBones bone)
	{
		PrimeHumanTraits();
		for (int i = 0; i < humanBoneNames.Length; i++)
		{
			if (string.Equals(humanBoneNames[i], humanName, StringComparison.Ordinal))
			{
				bone = (HumanBodyBones)i;
				return true;
			}
		}
		bone = (HumanBodyBones)0;
		return false;
	}

	public static bool TryMapScene(FbxScene scene, out FbxHumanoidSkeleton skeleton, out string error)
	{
		//IL_002d: Unknown result type (might be due to invalid IL or missing references)
		//IL_01ad: Unknown result type (might be due to invalid IL or missing references)
		//IL_01b8: Unknown result type (might be due to invalid IL or missing references)
		//IL_01db: Unknown result type (might be due to invalid IL or missing references)
		//IL_01dd: Unknown result type (might be due to invalid IL or missing references)
		skeleton = null;
		error = null;
		PrimeHumanTraits();
		FbxModel fbxModel = null;
		for (int i = 0; i < scene.Models.Count; i++)
		{
			if (TryMap(scene.Models[i].Name, out var bone) && (int)bone == 0)
			{
				fbxModel = scene.Models[i];
				break;
			}
		}
		if (fbxModel == null)
		{
			error = "FBX has no bone that maps to Hips.";
			return false;
		}
		FbxModel fbxModel2 = fbxModel;
		int num = 0;
		while (fbxModel2.Parent != null && num++ < 1024)
		{
			fbxModel2 = fbxModel2.Parent;
		}
		Dictionary<long, List<FbxModel>> dictionary = new Dictionary<long, List<FbxModel>>();
		for (int j = 0; j < scene.Models.Count; j++)
		{
			FbxModel fbxModel3 = scene.Models[j];
			if (fbxModel3.Parent != null)
			{
				if (!dictionary.TryGetValue(fbxModel3.Parent.Id, out var value))
				{
					value = new List<FbxModel>();
					dictionary[fbxModel3.Parent.Id] = value;
				}
				value.Add(fbxModel3);
			}
		}
		skeleton = new FbxHumanoidSkeleton
		{
			Root = fbxModel2
		};
		HashSet<string> hashSet = new HashSet<string>(StringComparer.Ordinal);
		Dictionary<HumanBodyBones, FbxModel> dictionary2 = new Dictionary<HumanBodyBones, FbxModel>();
		List<FbxModel> list = new List<FbxModel> { fbxModel2 };
		while (list.Count > 0)
		{
			int index = list.Count - 1;
			FbxModel fbxModel4 = list[index];
			list.RemoveAt(index);
			if (fbxModel4 != fbxModel2 && fbxModel4.Type == "Mesh")
			{
				continue;
			}
			if (!hashSet.Add(fbxModel4.Name))
			{
				error = "Duplicate bone name '" + fbxModel4.Name + "' in the FBX skeleton.";
				return false;
			}
			skeleton.Bones.Add(fbxModel4);
			if (TryMap(fbxModel4.Name, out var bone2) && !dictionary2.ContainsKey(bone2))
			{
				dictionary2[bone2] = fbxModel4;
				skeleton.Bindings.Add(new FbxHumanoidBinding
				{
					Model = fbxModel4,
					Bone = bone2
				});
			}
			if (dictionary.TryGetValue(fbxModel4.Id, out var value2))
			{
				for (int num2 = value2.Count - 1; num2 >= 0; num2--)
				{
					list.Add(value2[num2]);
				}
			}
		}
		List<string> list2 = new List<string>();
		for (int k = 0; k < requiredBones.Length; k++)
		{
			if (requiredBones[k] && !dictionary2.ContainsKey((HumanBodyBones)k))
			{
				list2.Add(humanBoneNames[k]);
			}
		}
		if (list2.Count > 0)
		{
			error = "Rig is missing required humanoid bones: " + string.Join(", ", list2) + ".";
			return false;
		}
		return true;
	}
}


