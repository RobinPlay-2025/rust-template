}


using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using System.Threading.Tasks;
using Rust.Fbx;

public static class FbxAsync
{
	public const long DefaultMaxFileBytes = 134217728L;

	public static Task<List<FbxClipInfo>> ListClipsAsync(byte[] bytes, CancellationToken cancellationToken = default(CancellationToken))
	{
		return Task.Run(() => ListClipsCore(bytes, cancellationToken), cancellationToken);
	}

	public static Task<List<FbxClipInfo>> ListClipsAsync(string filePath, long maxBytes = 134217728L, CancellationToken cancellationToken = default(CancellationToken))
	{
		return Task.Run(() => ListClipsCore(ReadFile(filePath, maxBytes), cancellationToken), cancellationToken);
	}

	public static Task<FbxScene> ParseSceneAsync(byte[] bytes, CancellationToken cancellationToken = default(CancellationToken))
	{
		return Task.Run(() => ParseSceneCore(bytes, cancellationToken), cancellationToken);
	}

	public static Task<FbxScene> ParseSceneAsync(string filePath, long maxBytes = 134217728L, CancellationToken cancellationToken = default(CancellationToken))
	{
		return Task.Run(() => ParseSceneCore(ReadFile(filePath, maxBytes), cancellationToken), cancellationToken);
	}

	public static Task<List<FbxFileClips>> ScanFolderAsync(string folder, IProgress<float> progress = null, long maxBytes = 134217728L, CancellationToken cancellationToken = default(CancellationToken))
	{
		FbxHumanoidMap.PrimeHumanTraits();
		return Task.Run(() => ScanFolderCore(folder, progress, maxBytes, cancellationToken), cancellationToken);
	}

	private static List<FbxClipInfo> ListClipsCore(byte[] bytes, CancellationToken cancellationToken)
	{
		cancellationToken.ThrowIfCancellationRequested();
		List<FbxClipInfo> list = new List<FbxClipInfo>();
		if (!FbxDocument.TryListClips(bytes, list, out var error))
		{
			throw new FbxParseException(error);
		}
		return list;
	}

	private static FbxScene ParseSceneCore(byte[] bytes, CancellationToken cancellationToken)
	{
		cancellationToken.ThrowIfCancellationRequested();
		if (!FbxDocument.TryParse(bytes, out var document, out var error))
		{
			throw new FbxParseException(error);
		}
		cancellationToken.ThrowIfCancellationRequested();
		if (!FbxScene.TryBuild(document, out var scene, out var error2))
		{
			throw new FbxParseException(error2);
		}
		return scene;
	}

	private static List<FbxFileClips> ScanFolderCore(string folder, IProgress<float> progress, long maxBytes, CancellationToken cancellationToken)
	{
		List<FbxFileClips> list = new List<FbxFileClips>();
		if (!Directory.Exists(folder))
		{
			return list;
		}
		string[] files = Directory.GetFiles(folder, "*.fbx", SearchOption.AllDirectories);
		for (int i = 0; i < files.Length; i++)
		{
			cancellationToken.ThrowIfCancellationRequested();
			FbxFileClips fbxFileClips = default(FbxFileClips);
			fbxFileClips.Path = files[i];
			fbxFileClips.Clips = new List<FbxClipInfo>();
			FbxFileClips item = fbxFileClips;
			try
			{
				FileInfo fileInfo = new FileInfo(files[i]);
				FbxDocument document;
				FbxScene scene;
				if (fileInfo.Length > maxBytes)
				{
					item.Error = $"FBX too large ({fileInfo.Length} bytes; limit {maxBytes}).";
				}
				else if (FbxDocument.TryParse(File.ReadAllBytes(files[i]), out document, out item.Error) && FbxScene.TryBuild(document, out scene, out item.Error))
				{
					for (int j = 0; j < scene.Takes.Count; j++)
					{
						FbxTake fbxTake = scene.Takes[j];
						if (fbxTake.HasAnimation)
						{
							item.Clips.Add(new FbxClipInfo
							{
								Name = fbxTake.Name,
								LocalStart = fbxTake.LocalStart,
								LocalStop = fbxTake.LocalStop
							});
						}
					}
					if (item.Clips.Count == 0)
					{
						for (int k = 0; k < scene.Takes.Count; k++)
						{
							FbxTake fbxTake2 = scene.Takes[k];
							item.Clips.Add(new FbxClipInfo
							{
								Name = fbxTake2.Name,
								LocalStart = fbxTake2.LocalStart,
								LocalStop = fbxTake2.LocalStop
							});
						}
					}
					if (!FbxHumanoidMap.TryMapScene(scene, out var _, out var error))
					{
						item.RigError = error;
					}
				}
			}
			catch (Exception ex)
			{
				item.Error = ex.Message;
			}
			list.Add(item);
			progress?.Report((float)(i + 1) / (float)files.Length);
		}
		return list;
	}

	private static byte[] ReadFile(string filePath, long maxBytes)
	{
		FileInfo fileInfo = new FileInfo(filePath);
		if (!fileInfo.Exists)
		{
			throw new FbxParseException("File not found: " + filePath);
		}
		if (fileInfo.Length > maxBytes)
		{
			throw new FbxParseException($"FBX '{fileInfo.Name}' is too large ({fileInfo.Length} bytes; limit {maxBytes}).");
		}
		return File.ReadAllBytes(filePath);
	}
}


using System;
using System.Buffers.Binary;
using System.Collections.Generic;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using Ionic.Zlib;
using Rust.Fbx;

internal sealed class FbxBinaryReader
{
	private static readonly byte[] BinaryMagic = Encoding.ASCII.GetBytes("Kaydara FBX Binary  ");

	private const int HeaderMagicLength = 20;

	private const int VersionOffset = 23;

	private const int FirstNodeOffset = 27;

	private const uint Version64BitThreshold = 7500u;

	private const int MaxRecursionDepth = 100;

	private const int MaxNodeCount = 8000000;

	private const long MaxArrayBytes = 268435456L;

	private const int MaxBlobBytes = 16777216;

	private const int MaxPropertyCount = 1048576;

	private const int MaxDeflateRatio = 1100;

	private byte[] data;

	private int pos;

	private bool use64;

	private int nodeCount;

	public static FbxDocument Parse(byte[] bytes)
	{
		uint version;
		FbxBinaryReader fbxBinaryReader = Create(bytes, out version);
		FbxNode fbxNode = new FbxNode
		{
			Name = string.Empty
		};
		while (fbxBinaryReader.pos < bytes.Length)
		{
			int num = fbxBinaryReader.pos;
			FbxNode fbxNode2 = fbxBinaryReader.ReadNode(0);
			if (fbxNode2 == null || fbxBinaryReader.pos <= num)
			{
				break;
			}
			fbxNode.Children.Add(fbxNode2);
		}
		return new FbxDocument
		{
			Version = version,
			Root = fbxNode
		};
	}

	public static bool TryListClips(byte[] bytes, List<FbxClipInfo> results, out string error)
	{
		error = null;
		try
		{
			Create(bytes, out var _).ScanTopLevel(bytes.Length, results);
			return true;
		}
		catch (FbxParseException ex)
		{
			error = ex.Message;
			return false;
		}
		catch (Exception ex2)
		{
			error = "Unexpected error parsing FBX: " + ex2.Message;
			return false;
		}
	}

	private static FbxBinaryReader Create(byte[] bytes, out uint version)
	{
		if (bytes == null || bytes.Length < 27)
		{
			throw new FbxParseException("File is too small to be an FBX document.");
		}
		if (!IsBinaryMagic(bytes))
		{
			throw new FbxParseException("Not an FBX file: the binary FBX header is missing and the contents are not ASCII FBX.");
		}
		version = BinaryPrimitives.ReadUInt32LittleEndian(new ReadOnlySpan<byte>(bytes, 23, 4));
		return new FbxBinaryReader
		{
			data = bytes,
			use64 = (version >= 7500),
			pos = 27
		};
	}

	private void ScanTopLevel(int end, List<FbxClipInfo> results)
	{
		while (pos < end)
		{
			int recordStart = pos;
			long num = ReadOffset();
			ReadOffset();
			long num2 = ReadOffset();
			int length = ReadByte();
			if (num == 0L)
			{
				break;
			}
			RequireRecordBounds(num, recordStart);
			if (ReadName(length) == "Objects")
			{
				long num3 = pos + num2;
				if (num3 < pos || num3 > num)
				{
					throw new FbxParseException("Malformed FBX: Objects property list out of range.");
				}
				ScanObjects((int)num3, (int)num, results);
			}
			pos = (int)num;
		}
	}

	private void ScanObjects(int start, int end, List<FbxClipInfo> results)
	{
		pos = start;
		while (pos < end)
		{
			int recordStart = pos;
			long num = ReadOffset();
			ReadOffset();
			ReadOffset();
			int length = ReadByte();
			if (num == 0L)
			{
				break;
			}
			RequireRecordBounds(num, recordStart);
			if (ReadName(length) == "AnimationStack")
			{
				pos = recordStart;
				FbxNode fbxNode = ReadNode(0);
				if (fbxNode != null)
				{
					results.Add(ExtractClipInfo(fbxNode));
				}
			}
			else
			{
				pos = (int)num;
			}
		}
	}

	private static FbxClipInfo ExtractClipInfo(FbxNode stack)
	{
		FbxClipInfo fbxClipInfo = default(FbxClipInfo);
		fbxClipInfo.Name = StripName(stack.GetString(1));
		FbxClipInfo result = fbxClipInfo;
		if (stack.TryGetChild("Properties70", out var child))
		{
			for (int i = 0; i < child.Children.Count; i++)
			{
				FbxNode fbxNode = child.Children[i];
				if (!(fbxNode.Name != "P"))
				{
					string @string = fbxNode.GetString(0);
					if (@string == "LocalStart")
					{
						result.LocalStart = fbxNode.GetLong(4);
					}
					else if (@string == "LocalStop")
					{
						result.LocalStop = fbxNode.GetLong(4);
					}
				}
			}
		}
		return result;
	}

	private static string StripName(string raw)
	{
		if (string.IsNullOrEmpty(raw))
		{
			return raw;
		}
		int num = raw.IndexOf('\0');
		if (num < 0)
		{
			return raw;
		}
		return raw.Substring(0, num);
	}

	public static bool IsBinary(byte[] bytes)
	{
		if (bytes != null && bytes.Length >= 27)
		{
			return IsBinaryMagic(bytes);
		}
		return false;
	}

	private static bool IsBinaryMagic(byte[] bytes)
	{
		for (int i = 0; i < 20; i++)
		{
			if (bytes[i] != BinaryMagic[i])
			{
				return false;
			}
		}
		return bytes[20] == 0;
	}

	private FbxNode ReadNode(int depth)
	{
		if (depth > 100)
		{
			throw new FbxParseException("Malformed FBX: node nesting is too deep.");
		}
		int recordStart = pos;
		long num = ReadOffset();
		long num2 = ReadOffset();
		ReadOffset();
		int length = ReadByte();
		if (num == 0L)
		{
			return null;
		}
		RequireRecordBounds(num, recordStart);
		if (num2 < 0 || num2 > 1048576)
		{
			throw new FbxParseException("Malformed FBX: too many node properties.");
		}
		if (++nodeCount > 8000000)
		{
			throw new FbxParseException("Malformed FBX: too many nodes.");
		}
		FbxNode fbxNode = new FbxNode
		{
			Name = ReadName(length)
		};
		if (num2 > 0)
		{
			fbxNode.Properties = new object[num2];
			for (int i = 0; i < num2; i++)
			{
				fbxNode.Properties[i] = ReadProperty();
			}
		}
		while (pos < num)
		{
			int num3 = pos;
			FbxNode fbxNode2 = ReadNode(depth + 1);
			if (fbxNode2 == null)
			{
				break;
			}
			if (pos <= num3)
			{
				throw new FbxParseException("Malformed FBX: nested record made no progress.");
			}
			fbxNode.Children.Add(fbxNode2);
		}
		pos = (int)num;
		return fbxNode;
	}

	private void RequireRecordBounds(long endOffset, int recordStart)
	{
		if (endOffset <= recordStart || endOffset > data.Length)
		{
			throw new FbxParseException("Malformed FBX: record end offset out of range.");
		}
	}

	private object ReadProperty()
	{
		char c = (char)ReadByte();
		return c switch
		{
			'Y' => ReadInt16(), 
			'C' => ReadByte() != 0, 
			'I' => ReadInt32(), 
			'F' => ReadSingle(), 
			'D' => ReadDouble(), 
			'L' => ReadInt64(), 
			'f' => ReadFloatArray(), 
			'd' => ReadDoubleArray(), 
			'l' => ReadLongArray(), 
			'i' => ReadIntArray(), 
			'b' => ReadByteArray(), 
			'S' => ReadBlobString(), 
			'R' => ReadBlobBytes(), 
			_ => throw new FbxParseException($"Unknown FBX property type '{c}' (0x{(int)c:X2}) at byte offset {pos - 1}."), 
		};
	}

	private byte[] ReadRawArray(int elementSize, out int count)
	{
		uint num = ReadUInt32();
		uint num2 = ReadUInt32();
		uint num3 = ReadUInt32();
		long num4 = num * elementSize;
		if (num4 > 268435456)
		{
			throw new FbxParseException($"Malformed FBX: array of {num} elements ({num4} bytes) exceeds the {268435456L} byte limit.");
		}
		count = (int)num;
		int num5 = (int)num4;
		if (num2 == 0)
		{
			byte[] array = new byte[num5];
			Slice(num5).CopyTo(array);
			return array;
		}
		if (num4 > (long)Math.Max(num3, 1u) * 1100L)
		{
			throw new FbxParseException("Malformed FBX: implausible decompression ratio (possible compression bomb).");
		}
		if (num3 > (uint)(data.Length - pos))
		{
			throw new FbxParseException("Malformed FBX: compressed array extends past end of file.");
		}
		int offset = pos;
		pos += (int)num3;
		return Decompress(offset, (int)num3, num5);
	}

	private byte[] Decompress(int offset, int compressedLength, int expectedSize)
	{
		//IL_0018: Unknown result type (might be due to invalid IL or missing references)
		//IL_001e: Expected O, but got Unknown
		byte[] array = new byte[expectedSize];
		using MemoryStream memoryStream = new MemoryStream(data, offset, compressedLength, writable: false);
		ZlibStream val = new ZlibStream((Stream)memoryStream, (CompressionMode)1);
		try
		{
			int i;
			int num;
			for (i = 0; i < expectedSize; i += num)
			{
				num = ((Stream)(object)val).Read(array, i, expectedSize - i);
				if (num <= 0)
				{
					break;
				}
			}
			if (i != expectedSize)
			{
				throw new FbxParseException("Malformed FBX: compressed array is truncated or corrupt.");
			}
			return array;
		}
		finally
		{
			((IDisposable)val)?.Dispose();
		}
	}

	private float[] ReadFloatArray()
	{
		int count;
		byte[] src = ReadRawArray(4, out count);
		float[] array = new float[count];
		Buffer.BlockCopy(src, 0, array, 0, count * 4);
		return array;
	}

	private double[] ReadDoubleArray()
	{
		int count;
		byte[] src = ReadRawArray(8, out count);
		double[] array = new double[count];
		Buffer.BlockCopy(src, 0, array, 0, count * 8);
		return array;
	}

	private long[] ReadLongArray()
	{
		int count;
		byte[] src = ReadRawArray(8, out count);
		long[] array = new long[count];
		Buffer.BlockCopy(src, 0, array, 0, count * 8);
		return array;
	}

	private int[] ReadIntArray()
	{
		int count;
		byte[] src = ReadRawArray(4, out count);
		int[] array = new int[count];
		Buffer.BlockCopy(src, 0, array, 0, count * 4);
		return array;
	}

	private byte[] ReadByteArray()
	{
		int count;
		return ReadRawArray(1, out count);
	}

	private string ReadBlobString()
	{
		int num = ReadBlobLength();
		if (num != 0)
		{
			return Encoding.UTF8.GetString(Slice(num));
		}
		return string.Empty;
	}

	private byte[] ReadBlobBytes()
	{
		int num = ReadBlobLength();
		byte[] array = new byte[num];
		Slice(num).CopyTo(array);
		return array;
	}

	private int ReadBlobLength()
	{
		uint num = ReadUInt32();
		if (num > 16777216)
		{
			throw new FbxParseException($"Malformed FBX: string/blob length {num} exceeds the {16777216} byte limit.");
		}
		return (int)num;
	}

	private string ReadName(int length)
	{
		if (length > 0)
		{
			return Encoding.UTF8.GetString(Slice(length));
		}
		return string.Empty;
	}

	private long ReadOffset()
	{
		if (!use64)
		{
			return ReadUInt32();
		}
		return (long)ReadUInt64();
	}

	private byte ReadByte()
	{
		return Slice(1)[0];
	}

	private short ReadInt16()
	{
		return BinaryPrimitives.ReadInt16LittleEndian(Slice(2));
	}

	private int ReadInt32()
	{
		return BinaryPrimitives.ReadInt32LittleEndian(Slice(4));
	}

	private uint ReadUInt32()
	{
		return BinaryPrimitives.ReadUInt32LittleEndian(Slice(4));
	}

	private long ReadInt64()
	{
		return BinaryPrimitives.ReadInt64LittleEndian(Slice(8));
	}

	private ulong ReadUInt64()
	{
		return BinaryPrimitives.ReadUInt64LittleEndian(Slice(8));
	}

	private float ReadSingle()
	{
		return MemoryMarshal.Read<float>(Slice(4));
	}

	private double ReadDouble()
	{
		return MemoryMarshal.Read<double>(Slice(8));
	}

	private ReadOnlySpan<byte> Slice(int count)
	{
		if (count < 0 || (long)pos + (long)count > data.Length)
		{
			throw new FbxParseException("Malformed FBX: attempted to read past the end of the file.");
		}
		ReadOnlySpan<byte> result = new ReadOnlySpan<byte>(data, pos, count);
		pos += count;
		return result;
	}
}


using System.Collections.Generic;
using Rust.Fbx;
using UnityEngine;

public static class FbxClipBuilder
{
	public sealed class Options
	{
		public float PositionScale = 0.01f;

		public bool ApplyUnitScaleFactor = true;

		public bool Legacy;

		public Vector3 MirrorAxis = new Vector3(-1f, 1f, 1f);

		public IReadOnlyDictionary<string, Quaternion> BindRotations;

		public int FirstFrame = -1;

		public int LastFrame = -1;

		public float MaxFrameRate;
	}

	public static bool TryBuildRange(FbxScene scene, FbxTake take, int firstFrame, int lastFrame, Options options, out AnimationClip clip, out string error)
	{
		//IL_003a: Unknown result type (might be due to invalid IL or missing references)
		//IL_003f: Unknown result type (might be due to invalid IL or missing references)
		if (options == null)
		{
			options = new Options();
		}
		Options options2 = new Options
		{
			PositionScale = options.PositionScale,
			ApplyUnitScaleFactor = options.ApplyUnitScaleFactor,
			Legacy = options.Legacy,
			MirrorAxis = options.MirrorAxis,
			MaxFrameRate = options.MaxFrameRate,
			BindRotations = options.BindRotations,
			FirstFrame = firstFrame,
			LastFrame = lastFrame
		};
		return TryBuild(scene, take, options2, out clip, out error);
	}

	public static bool TryBuild(FbxScene scene, FbxTake take, Options options, out AnimationClip clip, out string error)
	{
		//IL_0058: Unknown result type (might be due to invalid IL or missing references)
		//IL_005d: Unknown result type (might be due to invalid IL or missing references)
		//IL_0062: Unknown result type (might be due to invalid IL or missing references)
		//IL_0064: Unknown result type (might be due to invalid IL or missing references)
		//IL_0069: Unknown result type (might be due to invalid IL or missing references)
		//IL_0075: Unknown result type (might be due to invalid IL or missing references)
		//IL_007d: Expected O, but got Unknown
		//IL_00a6: Unknown result type (might be due to invalid IL or missing references)
		clip = null;
