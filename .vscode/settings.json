{
    "dotnet.defaultSolutionConfiguration":  "Oxide|Any CPU",
    "csharp.experimental.roslynOmnisharpEnabled":  false,
    "csharp.showOmnisharpLog":  true,
    "dotnet.server.useOmnisharp":  false,
    "dotnet.server.waitForWindowsToLaunch":  true,
    "files.exclude":  {
                          "**/bin":  true,
                          "**/obj":  true,
                          "**/.vs":  true,
                          ".gitignore":  true
                      },
    "editor.codeLens":  true,
    "dotnet.defaultSolution":  "rust-template.sln",
    "dotnet.backgroundAnalysis.analyzerDiagnosticsScope":  "fullSolution",
    "dotnet.backgroundAnalysis.compilerDiagnosticsScope":  "fullSolution",
    "dotnet.codeLens.enableReferencesCodeLens":  true,
    "omnisharp.useModernNet":  true,
    "omnisharp.projectLoadTimeout":  300,
    "omnisharp.enableRoslynAnalyzers":  true,
    "omnisharp.autoStart":  true,
    "[csharp]":  {
                     "editor.defaultFormatter":  "csharpier.csharpier-vscode",
                     "editor.formatOnSave":  true
                 },
    "emeraldwalk.runonsave":  {
                                  "commands":  [
                                                   {
                                                       "match":  ".*\\.cs$",
                                                       "cmd":  "dotnet format rust.template.csproj --diagnostics -IDE0005"
                                                   }
                                               ]
                              }
}
